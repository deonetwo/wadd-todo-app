<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:semi="clr-namespace:Semi.Avalonia;assembly=Semi.Avalonia"
             x:Class="Wadd.UI.App"
             RequestedThemeVariant="Default">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Wadd.UI/Styles/ColorTokens.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <semi:SemiTheme />
        <StyleInclude Source="avares://Wadd.UI/Styles/Typography.axaml" />
        <StyleInclude Source="avares://Wadd.UI/Styles/ComponentStyles.axaml" />
    </Application.Styles>
</Application>
