<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <FontFamily x:Key="AppFontFamily">Plus Jakarta Sans, Outfit, Poppins, Montserrat, Segoe UI Variable Display, Segoe UI, sans-serif</FontFamily>
    <FontFamily x:Key="BrandFontFamily">Outfit, Plus Jakarta Sans, Poppins, Montserrat, Segoe UI Variable Display, sans-serif</FontFamily>
  </Styles.Resources>

  <Style Selector="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
    <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <!-- Brand Title Styles -->
  <Style Selector="TextBlock.brand-title">
    <Setter Property="FontFamily" Value="{StaticResource BrandFontFamily}" />
    <Setter Property="FontSize" Value="22" />
    <Setter Property="FontWeight" Value="ExtraBold" />
    <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}" />
    <Setter Property="LetterSpacing" Value="0.5" />
  </Style>

  <Style Selector="TextBlock.brand-accent">
    <Setter Property="FontFamily" Value="{StaticResource BrandFontFamily}" />
    <Setter Property="FontSize" Value="22" />
    <Setter Property="FontWeight" Value="Black" />
    <Setter Property="Foreground" Value="{DynamicResource AppPrimaryBrush}" />
    <Setter Property="LetterSpacing" Value="0.5" />
  </Style>

  <!-- Title Style: 24sp Bold -->
  <Style Selector="TextBlock.title">
    <Setter Property="FontFamily" Value="{StaticResource BrandFontFamily}" />
    <Setter Property="FontSize" Value="24" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <!-- Header Style: 18sp SemiBold -->
  <Style Selector="TextBlock.header">
    <Setter Property="FontFamily" Value="{StaticResource BrandFontFamily}" />
    <Setter Property="FontSize" Value="18" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <!-- Body Style: 14sp Regular -->
  <Style Selector="TextBlock.body">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <!-- Caption Style: 12sp Muted -->
  <Style Selector="TextBlock.caption">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
</Styles>
