<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- ═══════════════════════════════════════════════════════════════
       EMBER DESIGN SYSTEM · Component Styles
       Philosophy: Space over borders. Color over shadows. Motion for life.
  ═══════════════════════════════════════════════════════════════ -->

  <!-- ══════════════ BUTTONS ══════════════ -->

  <!-- Primary: terracotta fill, white text -->
  <Style Selector="Button.primary">
    <Setter Property="Background"              Value="{DynamicResource AppPrimaryBrush}"/>
    <Setter Property="Foreground"              Value="#FFFFFF"/>
    <Setter Property="BorderThickness"         Value="0"/>
    <Setter Property="CornerRadius"            Value="8"/>
    <Setter Property="Padding"                 Value="16,9"/>
    <Setter Property="FontSize"                Value="13"/>
    <Setter Property="FontWeight"              Value="SemiBold"/>
    <Setter Property="Cursor"                  Value="Hand"/>
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.15"/>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.08"/>
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AppPrimaryHoverBrush}"/>
    <Setter Property="Foreground"  Value="#FFFFFF"/>
  </Style>
  <Style Selector="Button.primary:pressed">
    <Setter Property="RenderTransform" Value="scale(0.96)"/>
    <Setter Property="Opacity"         Value="0.88"/>
  </Style>

  <!-- Modern Non-Mainstream Composer Add Button: Pill shape, gradient, glow shadow, lift transition -->
  <Style Selector="Button.composer-add">
    <Setter Property="Background">
      <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Color="#0D9488" Offset="0.0"/>
        <GradientStop Color="#10B981" Offset="1.0"/>
      </LinearGradientBrush>
    </Setter>
    <Setter Property="Foreground"              Value="#FFFFFF"/>
    <Setter Property="BorderThickness"         Value="0"/>
    <Setter Property="CornerRadius"            Value="20"/>
    <Setter Property="Padding"                 Value="18,10"/>
    <Setter Property="FontSize"                Value="13"/>
    <Setter Property="FontWeight"              Value="SemiBold"/>
    <Setter Property="Cursor"                  Value="Hand"/>
    <Setter Property="RenderTransform"         Value="scale(1.0)"/>
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" Easing="CubicEaseOut"/>
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.composer-add /template/ ContentPresenter">
    <Setter Property="CornerRadius" Value="20"/>
    <Setter Property="BoxShadow"    Value="0 4 14 0 #330D9488"/>
    <Setter Property="Transitions">
      <Transitions>
        <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.15"/>
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.composer-add:pointerover">
    <Setter Property="RenderTransform" Value="scale(1.04) translateY(-1px)"/>
  </Style>
  <Style Selector="Button.composer-add:pointerover /template/ ContentPresenter">
    <Setter Property="Background">
      <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Color="#0F766E" Offset="0.0"/>
        <GradientStop Color="#059669" Offset="1.0"/>
      </LinearGradientBrush>
    </Setter>
    <Setter Property="Foreground" Value="#FFFFFF"/>
    <Setter Property="BoxShadow"  Value="0 6 18 0 #5010B981"/>
  </Style>
  <Style Selector="Button.composer-add:pressed">
    <Setter Property="RenderTransform" Value="scale(0.96) translateY(0px)"/>
  </Style>
  <Style Selector="Button.composer-add:pressed /template/ ContentPresenter">
    <Setter Property="BoxShadow" Value="0 2 8 0 #300D9488"/>
  </Style>

  <!-- Secondary: subtle fill with border (compat) -->
  <Style Selector="Button.secondary">
    <Setter Property="Background"      Value="{DynamicResource AppSurfaceSubtleBrush}"/>
    <Setter Property="Foreground"      Value="{DynamicResource AppTextPrimaryBrush}"/>
    <Setter Property="BorderBrush"     Value="{DynamicResource AppBorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius"    Value="8"/>
    <Setter Property="Padding"         Value="12,7"/>
    <Setter Property="FontSize"        Value="13"/>
    <Setter Property="FontWeight"      Value="Medium"/>
    <Setter Property="Cursor"          Value="Hand"/>
  </Style>
  <Style Selector="Button.secondary:pointerover /template/ ContentPresenter">
    <Setter Property="Background"  Value="{DynamicResource AppMenuSelectedBrush}"/>
    <Setter Property="Foreground"  Value="{DynamicResource AppPrimaryBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource AppPrimaryBrush}"/>
  </Style>

  <!-- Outline: transparent with thin border -->
  <Style Selector="Button.outline">
    <Setter Property="Background"      Value="Transparent"/>
    <Setter Property="Foreground"      Value="{DynamicResource AppTextPrimaryBrush}"/>
    <Setter Property="BorderBrush"     Value="{DynamicResource AppBorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius"    Value="8"/>
    <Setter Property="Padding"         Value="12,7"/>
    <Setter Property="FontSize"        Value="13"/>
    <Setter Property="FontWeight"      Value="Medium"/>
    <Setter Property="Cursor"          Value="Hand"/>
  </Style>
  <Style Selector="Button.outline:pointerover /template/ ContentPresenter">
    <Setter Property="Background"  Value="{DynamicResource AppAccentTintBrush}"/>
    <Setter Property="Foreground"  Value="{DynamicResource AppPrimaryBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource AppPrimaryBrush}"/>
  </Style>
  <Style Selector="Button.outline:pressed">
    <Setter Property="Opacity" Value="0.8"/>
  </Style>

  <!-- Ghost: invisible background, shows on hover -->
  <Style Selector="Button.ghost">
    <Setter Property="Background"      Value="Transparent"/>
    <Setter Property="Foreground"      Value="{DynamicResource AppTextSecondaryBrush}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="CornerRadius"    Value="7"/>
    <Setter Property="Padding"         Value="9,6"/>
    <Setter Property="FontSize"        Value="13"/>
    <Setter Property="Cursor"          Value="Hand"/>
  </Style>
  <Style Selector="Button.ghost:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AppSurfaceSubtleBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
  </Style>

  <!-- Add Note Button: Subtle pill background highlight & primary teal color on hover -->
  <Style Selector="Button.add-note-btn">
    <Setter Property="Background"              Value="Transparent"/>
    <Setter Property="Foreground"              Value="{DynamicResource AppTextSecondaryBrush}"/>
    <Setter Property="BorderThickness"         Value="0"/>
    <Setter Property="CornerRadius"            Value="6"/>
    <Setter Property="Padding"                 Value="8,4"/>
    <Setter Property="FontSize"                Value="12"/>
    <Setter Property="Cursor"                  Value="Hand"/>
  </Style>
  <Style Selector="Button.add-note-btn /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
  </Style>
  <Style Selector="Button.add-note-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AppPrimarySubtleBrush}"/>
  </Style>
  <Style Selector="Button.add-note-btn:pointerover TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource AppPrimaryBrush}"/>
  </Style>
  <Style Selector="Button.add-note-btn:pointerover PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource AppPrimaryBrush}"/>
  </Style>
  <Style Selector="Button.add-note-btn:focus /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent"/>
  </Style>
  <Style Selector="Button.add-note-btn:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AppPrimarySubtleBrush}"/>
  </Style>

  <!-- Task Row Content Button: Transparent container for task details click without nested hover highlight -->
  <Style Selector="Button.task-row-btn">
    <Setter Property="Background"              Value="Transparent"/>
    <Setter Property="Foreground"              Value="{DynamicResource AppTextPrimaryBrush}"/>
    <Setter Property="BorderThickness"         Value="0"/>
    <Setter Property="CornerRadius"            Value="0"/>
    <Setter Property="Padding"                 Value="0"/>
    <Setter Property="Cursor"                  Value="Hand"/>
    <Setter Property="HorizontalAlignment"     Value="Stretch"/>
    <Setter Property="HorizontalContentAlignment" Value="Left"/>
    <Setter Property="VerticalAlignment"       Value="Center"/>
  </Style>
  <Style Selector="Button.task-row-btn /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
  </Style>
  <Style Selector="Button.task-row-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent"/>
  </Style>
  <Style Selector="Button.task-row-btn:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent"/>
  </Style>
  <Style Selector="Button.task-row-btn:focus /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent"/>
  </Style>
  <Style Selector="Button.task-row-btn:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent"/>
  </Style>

  <!-- Icon button: square, no border, subtle hover -->
  <Style Selector="Button.icon-btn">
    <Setter Property="Background"      Value="Transparent"/>
    <Setter Property="Foreground"      Value="{DynamicResource AppTextSecondaryBrush}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="CornerRadius"    Value="8"/>
    <Setter Property="Padding"         Value="7"/>
    <Setter Property="Cursor"          Value="Hand"/>
  </Style>
  <Style Selector="Button.icon-btn:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AppSurfaceSubtleBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
  </Style>

  <!-- Danger icon: subtle red tint on hover -->
  <Style Selector="Button.danger">
    <Setter Property="Background"      Value="Transparent"/>
    <Setter Property="Foreground"      Value="{DynamicResource AppTextSecondaryBrush}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="CornerRadius"    Value="6"/>
    <Setter Property="Padding"         Value="6"/>
    <Setter Property="Cursor"          Value="Hand"/>
    <Setter Property="Opacity"         Value="0.4"/>
  </Style>
  <Style Selector="Button.danger:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#20C84848"/>
    <Setter Property="Foreground" Value="{DynamicResource AppAccentDangerBrush}"/>
  </Style>

  <!-- Side menu button (compact drawer compat) -->
  <Style Selector="Button.side-menu-button">
    <Setter Property="Padding"                 Value="12,9"/>
    <Setter Property="Margin"                  Value="0,2"/>
    <Setter Property="CornerRadius"            Value="8"/>
    <Setter Property="Background"              Value="Transparent"/>
    <Setter Property="Foreground"              Value="{DynamicResource AppTextSecondaryBrush}"/>
    <Setter Property="BorderThickness"         Value="0"/>
    <Setter Property="HorizontalAlignment"     Value="Stretch"/>
    <Setter Property="HorizontalContentAlignment" Value="Left"/>
    <Setter Property="Cursor"                  Value="Hand"/>
  </Style>
  <Style Selector="Button.side-menu-button:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AppSurfaceSubtleBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
  </Style>

  <!-- ══════════════ TEXT INPUTS ══════════════ -->

  <!-- Composer input: editorial underline only, large -->
  <Style Selector="TextBox.composer">
    <Setter Property="Background"      Value="Transparent"/>
    <Setter Property="Foreground"      Value="{DynamicResource AppTextPrimaryBrush}"/>
    <Setter Property="BorderBrush"     Value="{DynamicResource AppBorderBrush}"/>
    <Setter Property="BorderThickness" Value="0,0,0,1.5"/>
    <Setter Property="CornerRadius"    Value="0"/>
    <Setter Property="Padding"         Value="14,10"/>
    <Setter Property="FontSize"        Value="16"/>
    <Setter Property="FontWeight"      Value="Normal"/>
    <Setter Property="MinHeight"       Value="42"/>
    <Setter Property="SelectionBrush"  Value="{DynamicResource AppPrimaryBrush}"/>
  </Style>
  <Style Selector="TextBox.composer /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="Transparent"/>
  </Style>
  <Style Selector="TextBox.composer:focus /template/ Border#PART_BorderElement">
    <Setter Property="BorderBrush"     Value="{DynamicResource AppPrimaryBrush}"/>
    <Setter Property="BorderThickness" Value="0,0,0,1.5"/>
    <Setter Property="Background"      Value="Transparent"/>
  </Style>
  <Style Selector="TextBox.composer:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="BorderBrush" Value="{DynamicResource AppTextSecondaryBrush}"/>
    <Setter Property="Background"  Value="Transparent"/>
  </Style>
  <Style Selector="TextBox.composer /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent"/>
  </Style>
  <Style Selector="TextBox.composer:focus /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent"/>
  </Style>
  <Style Selector="TextBox.composer:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent"/>
  </Style>

  <!-- Search composer input: editorial underline only, no rounded corners -->
  <Style Selector="TextBox.search-composer">
    <Setter Property="Background"      Value="Transparent"/>
    <Setter Property="Foreground"      Value="{DynamicResource AppTextPrimaryBrush}"/>
    <Setter Property="BorderBrush"     Value="{DynamicResource AppBorderBrush}"/>
    <Setter Property="BorderThickness" Value="0,0,0,1.5"/>
    <Setter Property="CornerRadius"    Value="0"/>
    <Setter Property="Padding"         Value="14,10"/>
    <Setter Property="FontSize"        Value="20"/>
    <Setter Property="FontWeight"      Value="Medium"/>
    <Setter Property="MinHeight"       Value="44"/>
    <Setter Property="SelectionBrush"  Value="{DynamicResource AppPrimaryBrush}"/>
  </Style>
  <Style Selector="TextBox.search-composer /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="Transparent"/>
  </Style>
  <Style Selector="TextBox.search-composer:focus /template/ Border#PART_BorderElement">
    <Setter Property="BorderBrush"     Value="{DynamicResource AppPrimaryBrush}"/>
    <Setter Property="BorderThickness" Value="0,0,0,1.5"/>
    <Setter Property="Background"      Value="Transparent"/>
  </Style>
  <Style Selector="TextBox.search-composer:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="BorderBrush" Value="{DynamicResource AppTextSecondaryBrush}"/>
    <Setter Property="Background"  Value="Transparent"/>
  </Style>
  <Style Selector="TextBox.search-composer /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent"/>
  </Style>
  <Style Selector="TextBox.search-composer:focus /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent"/>
  </Style>
  <Style Selector="TextBox.search-composer:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent"/>
  </Style>
  <Style Selector="TextBox.composer /template/ Button#PART_ClearButton">
    <Setter Property="IsVisible" Value="False"/>
  </Style>
  <Style Selector="TextBox.search-composer /template/ Button#PART_ClearButton">
    <Setter Property="IsVisible" Value="False"/>
  </Style>

  <!-- Standard styled input: for settings, URL fields -->
  <Style Selector="TextBox.styled">
    <Setter Property="Background"      Value="{DynamicResource AppSurfaceElevatedBrush}"/>
    <Setter Property="Foreground"      Value="{DynamicResource AppTextPrimaryBrush}"/>
    <Setter Property="BorderBrush"     Value="{DynamicResource AppBorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius"    Value="8"/>
    <Setter Property="Padding"         Value="14,10"/>
    <Setter Property="FontSize"        Value="13"/>
    <Setter Property="MinHeight"       Value="40"/>
    <Setter Property="SelectionBrush"  Value="{DynamicResource AppPrimaryBrush}"/>
  </Style>
  <Style Selector="TextBox.styled:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="BorderBrush" Value="{DynamicResource AppPrimaryBrush}"/>
  </Style>
  <Style Selector="TextBox.styled:focus /template/ Border#PART_BorderElement">
    <Setter Property="BorderBrush"     Value="{DynamicResource AppPrimaryBrush}"/>
    <Setter Property="BorderThickness" Value="1.5"/>
    <Setter Property="Background"      Value="{DynamicResource AppSurfaceBrush}"/>
  </Style>

  <!-- ══════════════ NAV RAIL ITEMS ══════════════ -->

  <!-- Icon-only nav rail item: 44×44, centered icon -->
  <Style Selector="ListBoxItem.nav-rail-item">
    <Setter Property="Padding"                 Value="0"/>
    <Setter Property="Margin"                  Value="10,3"/>
    <Setter Property="CornerRadius"            Value="10"/>
    <Setter Property="Background"              Value="Transparent"/>
    <Setter Property="Foreground"              Value="{DynamicResource AppTextSecondaryBrush}"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment"   Value="Center"/>
    <Setter Property="Width"                   Value="44"/>
    <Setter Property="Height"                  Value="44"/>
    <Setter Property="Cursor"                  Value="Hand"/>
  </Style>
  <Style Selector="ListBoxItem.nav-rail-item:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AppSurfaceSubtleBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
  </Style>
  <Style Selector="ListBoxItem.nav-rail-item:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AppAccentTintBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource AppPrimaryBrush}"/>
  </Style>

  <!-- Expanded nav drawer item: full width, icon + text -->
  <Style Selector="ListBoxItem.nav-expanded-item">
    <Setter Property="Padding"                 Value="12,9"/>
    <Setter Property="Margin"                  Value="8,2"/>
    <Setter Property="CornerRadius"            Value="8"/>
    <Setter Property="Background"              Value="Transparent"/>
    <Setter Property="Foreground"              Value="{DynamicResource AppTextSecondaryBrush}"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="VerticalContentAlignment"   Value="Center"/>
    <Setter Property="Cursor"                  Value="Hand"/>
  </Style>
  <Style Selector="ListBoxItem.nav-expanded-item:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AppSurfaceSubtleBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
  </Style>
  <Style Selector="ListBoxItem.nav-expanded-item:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AppMenuSelectedBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource AppPrimaryBrush}"/>
  </Style>

  <!-- Unified nav item: seamless height and alignment in both collapsed and expanded states -->
  <Style Selector="ListBoxItem.nav-unified-item">
    <Setter Property="Padding"                 Value="0"/>
    <Setter Property="Margin"                  Value="6,2"/>
    <Setter Property="Height"                  Value="44"/>
    <Setter Property="CornerRadius"            Value="10"/>
    <Setter Property="Background"              Value="Transparent"/>
    <Setter Property="Foreground"              Value="{DynamicResource AppTextSecondaryBrush}"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="VerticalContentAlignment"   Value="Center"/>
    <Setter Property="Cursor"                  Value="Hand"/>
  </Style>
  <Style Selector="ListBoxItem.nav-unified-item:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AppSurfaceSubtleBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
  </Style>
  <Style Selector="ListBoxItem.nav-unified-item:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AppMenuSelectedBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource AppPrimaryBrush}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>

  <!-- Side menu item (compact drawer compat) -->
  <Style Selector="ListBoxItem.side-menu-item">
    <Setter Property="Padding"    Value="12,10"/>
    <Setter Property="Margin"     Value="0,2"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}"/>
    <Setter Property="Cursor"     Value="Hand"/>
  </Style>
  <Style Selector="ListBoxItem.side-menu-item:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AppSurfaceSubtleBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
  </Style>
  <Style Selector="ListBoxItem.side-menu-item:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AppMenuSelectedBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource AppPrimaryBrush}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>

  <!-- Bottom tab bar item (compact mode) -->
  <Style Selector="ListBoxItem.tab-item">
    <Setter Property="Padding"                 Value="0"/>
    <Setter Property="Margin"                  Value="0"/>
    <Setter Property="Background"              Value="Transparent"/>
    <Setter Property="Foreground"              Value="{DynamicResource AppTextSecondaryBrush}"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment"   Value="Center"/>
    <Setter Property="Height"                  Value="56"/>
    <Setter Property="Cursor"                  Value="Hand"/>
  </Style>
  <Style Selector="ListBoxItem.tab-item:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AppSurfaceSubtleBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
  </Style>
  <Style Selector="ListBoxItem.tab-item:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource AppPrimaryBrush}"/>
  </Style>

  <!-- Bottom Tab Bar Button (5-tab explicit binding) -->
  <Style Selector="Button.tab-btn">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Margin" Value="0"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="VerticalAlignment" Value="Stretch"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="CornerRadius" Value="0"/>
    <Setter Property="Cursor" Value="Hand"/>
  </Style>
  <Style Selector="Button.tab-btn:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AppSurfaceSubtleBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
  </Style>
  <Style Selector="Button.tab-btn.active">
    <Setter Property="Foreground" Value="{DynamicResource AppPrimaryBrush}"/>
  </Style>
  <Style Selector="Button.tab-btn.active /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource AppPrimaryBrush}"/>
  </Style>

  <!-- ══════════════ TASK ROW ══════════════ -->

  <!-- Modern Soft Rounded Task Row Card -->
  <Style Selector="Border.task-row">
    <Setter Property="Background"      Value="Transparent"/>
    <Setter Property="Padding"         Value="12,12"/>
    <Setter Property="Margin"          Value="0,2"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="CornerRadius"    Value="10"/>
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.25" Easing="0.1,0.9,0.2,1.0"/>
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Border.task-row:pointerover">
    <Setter Property="Background" Value="{DynamicResource AppSurfaceSubtleBrush}"/>
  </Style>

  <!-- Action Task Row Button (View All Recurring, etc.) -->
  <Style Selector="Button.action-task-row">
    <Setter Property="Background"              Value="Transparent"/>
    <Setter Property="BorderBrush"             Value="Transparent"/>
    <Setter Property="BorderThickness"         Value="0"/>
    <Setter Property="CornerRadius"            Value="10"/>
    <Setter Property="Padding"                 Value="12,12"/>
    <Setter Property="Margin"                  Value="0,2"/>
    <Setter Property="HorizontalAlignment"     Value="Stretch"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Cursor"                  Value="Hand"/>
  </Style>
  <Style Selector="Button.action-task-row /template/ ContentPresenter">
    <Setter Property="CornerRadius"            Value="10"/>
    <Setter Property="BorderThickness"         Value="0"/>
    <Setter Property="BorderBrush"             Value="Transparent"/>
    <Setter Property="Background"              Value="Transparent"/>
  </Style>
  <Style Selector="Button.action-task-row:pointerover /template/ ContentPresenter">
    <Setter Property="Background"              Value="{DynamicResource AppSurfaceSubtleBrush}"/>
    <Setter Property="BorderBrush"             Value="Transparent"/>
  </Style>
  <Style Selector="Button.action-task-row:focus /template/ ContentPresenter">
    <Setter Property="Background"              Value="{DynamicResource AppSurfaceSubtleBrush}"/>
    <Setter Property="BorderBrush"             Value="Transparent"/>
  </Style>

  <!-- Modern Circular Task Toggle Style (Exact TasksView Standard) -->
  <Style Selector="CheckBox.task-checkbox">
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Margin" Value="0,2,16,0"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="VerticalAlignment" Value="Top"/>
    <Setter Property="Template">
      <ControlTemplate>
        <Border x:Name="CheckBorder"
                Width="22" Height="22"
                CornerRadius="11"
                BorderBrush="{DynamicResource AppTextSecondaryBrush}"
                BorderThickness="2"
                Background="Transparent"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
          <PathIcon x:Name="CheckIcon"
                    Data="{StaticResource CheckIconData}"
                    Width="11" Height="11"
                    Foreground="#FFFFFF"
                    Opacity="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
            <PathIcon.Transitions>
              <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.15"/>
                <BrushTransition Property="Foreground" Duration="0:0:0.15"/>
              </Transitions>
            </PathIcon.Transitions>
          </PathIcon>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>

  <!-- Task Row Hover -> Highlight CheckBox Ring prominently with primary preview -->
  <Style Selector="Border.task-row:pointerover CheckBox.task-checkbox /template/ Border#CheckBorder">
    <Setter Property="BorderBrush" Value="{DynamicResource AppPrimaryBrush}"/>
  </Style>
  <Style Selector="Border.task-row:pointerover CheckBox.task-checkbox /template/ PathIcon#CheckIcon">
    <Setter Property="Foreground" Value="{DynamicResource AppPrimaryBrush}"/>
    <Setter Property="Opacity" Value="0.35"/>
  </Style>

  <!-- Direct CheckBox Hover -> Tactile Preview -->
  <Style Selector="CheckBox.task-checkbox:pointerover /template/ Border#CheckBorder">
    <Setter Property="BorderBrush" Value="{DynamicResource AppPrimaryBrush}"/>
  </Style>
  <Style Selector="CheckBox.task-checkbox:pointerover /template/ PathIcon#CheckIcon">
    <Setter Property="Foreground" Value="{DynamicResource AppPrimaryBrush}"/>
    <Setter Property="Opacity" Value="0.65"/>
  </Style>

  <!-- Checked State -->
  <Style Selector="CheckBox.task-checkbox:checked /template/ Border#CheckBorder">
    <Setter Property="Background" Value="{DynamicResource AppPrimaryBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource AppPrimaryBrush}"/>
  </Style>
  <Style Selector="CheckBox.task-checkbox:checked /template/ PathIcon#CheckIcon">
    <Setter Property="Foreground" Value="#FFFFFF"/>
    <Setter Property="Opacity" Value="1"/>
  </Style>
  <Style Selector="CheckBox.task-checkbox:checked:pointerover /template/ PathIcon#CheckIcon">
    <Setter Property="Foreground" Value="#FFFFFF"/>
    <Setter Property="Opacity" Value="1"/>
  </Style>

  <!-- Completed Task Row De-emphasis -->
  <Style Selector="Border.task-row.completed">
    <Setter Property="Opacity" Value="0.55"/>
  </Style>

  <!-- Hover-only Delete Button reveal -->
  <Style Selector="Border.task-row Button.danger">
    <Setter Property="Opacity" Value="0"/>
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.15"/>
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Border.task-row:pointerover Button.danger">
    <Setter Property="Opacity" Value="1"/>
  </Style>

  <!-- task-card compat alias — uses task-row visuals -->
  <Style Selector="Border.task-card">
    <Setter Property="Background"      Value="Transparent"/>
    <Setter Property="Padding"         Value="12,12"/>
    <Setter Property="Margin"          Value="0,2"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="CornerRadius"    Value="10"/>
  </Style>
  <Style Selector="Border.task-card:pointerover">
    <Setter Property="Background" Value="{DynamicResource AppSurfaceSubtleBrush}"/>
  </Style>

  <!-- ══════════════ CONTENT SURFACES ══════════════ -->

  <!-- Content block: settings/info card -->
  <Style Selector="Border.content-block">
    <Setter Property="Background"      Value="{DynamicResource AppSurfaceBrush}"/>
    <Setter Property="BorderBrush"     Value="{DynamicResource AppBorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius"    Value="12"/>
    <Setter Property="Padding"         Value="24"/>
  </Style>

  <!-- Card (compat) -->
  <Style Selector="Border.card">
    <Setter Property="Background"      Value="{DynamicResource AppSurfaceBrush}"/>
    <Setter Property="BorderBrush"     Value="{DynamicResource AppBorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius"    Value="12"/>
    <Setter Property="Padding"         Value="22"/>
  </Style>

  <!-- Card subtle (compat) -->
  <Style Selector="Border.card-subtle">
    <Setter Property="Background"      Value="{DynamicResource AppSurfaceElevatedBrush}"/>
    <Setter Property="BorderBrush"     Value="{DynamicResource AppBorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius"    Value="10"/>
    <Setter Property="Padding"         Value="16"/>
  </Style>

  <!-- Divider line -->
  <Style Selector="Separator.divider">
    <Setter Property="Background" Value="{DynamicResource AppBorderBrush}"/>
    <Setter Property="Height"     Value="1"/>
    <Setter Property="Opacity"    Value="0.4"/>
    <Setter Property="Margin"     Value="0"/>
  </Style>

  <!-- Center the icon visually within the rightmost section of TimePicker -->
  <Style Selector="TimePicker /template/ PathIcon">
    <Setter Property="Data" Value="{DynamicResource BellIconData}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Margin" Value="0" />
  </Style>
  <Style Selector="TimePicker /template/ PathIcon#ClockIcon">
    <Setter Property="Data" Value="{DynamicResource BellIconData}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Margin" Value="0" />
  </Style>
  <Style Selector="TimePicker /template/ PathIcon#PART_ClockIcon">
    <Setter Property="Data" Value="{DynamicResource BellIconData}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Margin" Value="0" />
  </Style>
  <Style Selector="TimePickerPresenter /template/ PathIcon">
    <Setter Property="Data" Value="{DynamicResource BellIconData}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Margin" Value="0" />
  </Style>

  <!-- Style to hide/remove clock icon inside TimePicker -->
  <Style Selector="TimePicker.no-clock /template/ PathIcon">
    <Setter Property="IsVisible" Value="False" />
    <Setter Property="Width" Value="0" />
  </Style>
  <Style Selector="TimePicker.no-clock /template/ PathIcon#ClockIcon">
    <Setter Property="IsVisible" Value="False" />
    <Setter Property="Width" Value="0" />
  </Style>
  <Style Selector="TimePicker.no-clock /template/ PathIcon#PART_ClockIcon">
    <Setter Property="IsVisible" Value="False" />
    <Setter Property="Width" Value="0" />
  </Style>

  <!-- Make CalendarDatePicker act as a click-only button (like ClockTimePicker) -->
  <Style Selector="CalendarDatePicker">
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Focusable" Value="False"/>
  </Style>

  <!-- Strip internal borders, focus elements, and separate backgrounds from TextBox -->
  <Style Selector="CalendarDatePicker /template/ TextBox">
    <Setter Property="IsReadOnly" Value="True"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="IsHitTestVisible" Value="False"/>
    <Setter Property="ZIndex" Value="1"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
  </Style>
  <Style Selector="CalendarDatePicker /template/ TextBox /template/ Border">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
  </Style>
  <Style Selector="CalendarDatePicker /template/ TextBox:focus /template/ Border">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
  </Style>

  <!-- Strip internal borders, focus rings, and separate backgrounds from Button -->
  <Style Selector="CalendarDatePicker /template/ Button">
    <Setter Property="Grid.Column" Value="0"/>
    <Setter Property="Grid.ColumnSpan" Value="2"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="VerticalAlignment" Value="Stretch"/>
    <Setter Property="HorizontalContentAlignment" Value="Right"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="FocusAdorner" Value="{x:Null}"/>
    <Setter Property="ZIndex" Value="0"/>
  </Style>

  <!-- Suppress button internal state styles -->
  <Style Selector="CalendarDatePicker /template/ Button:pointerover">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
  </Style>
  <Style Selector="CalendarDatePicker /template/ Button:pressed">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
  </Style>
  <Style Selector="CalendarDatePicker /template/ Button:focus">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
  </Style>
  <Style Selector="CalendarDatePicker /template/ Button:focus-visible">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
  </Style>
  <Style Selector="CalendarDatePicker /template/ Button /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
  </Style>
  <Style Selector="CalendarDatePicker /template/ Button:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
  </Style>

  <!-- Hover state for CalendarDatePicker (Matches ClockTimePicker 1:1) -->
  <Style Selector="CalendarDatePicker:pointerover">
    <Setter Property="Background" Value="{DynamicResource AppSurfaceElevatedBrush}"/>
  </Style>
  <Style Selector="CalendarDatePicker:pointerover /template/ Border">
    <Setter Property="Background" Value="{DynamicResource AppSurfaceElevatedBrush}"/>
  </Style>
  <Style Selector="CalendarDatePicker:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AppSurfaceElevatedBrush}"/>
  </Style>
  <Style Selector="CalendarDatePicker:pointerover /template/ TextBox">
    <Setter Property="Background" Value="Transparent"/>
  </Style>
  <Style Selector="CalendarDatePicker:pointerover /template/ Button">
    <Setter Property="Background" Value="Transparent"/>
  </Style>

  <!-- ══════════════ TOOLTIP STYLING ══════════════ -->
  <Style Selector="ToolTip">
    <Setter Property="Background" Value="{DynamicResource AppSurfaceElevatedBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="Padding" Value="8,5"/>
    <Setter Property="FontSize" Value="12"/>
  </Style>

  <!-- ══════════════ MODERN COMBOBOX STYLING ══════════════ -->
  <Style Selector="ComboBox">
    <Setter Property="Background" Value="{DynamicResource AppSurfaceSubtleBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="Padding" Value="14,10"/>
    <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
  </Style>

  <Style Selector="ComboBox:pointerover">
    <Setter Property="BorderBrush" Value="{DynamicResource AppPrimaryBrush}"/>
    <Setter Property="Background" Value="{DynamicResource AppSurfaceElevatedBrush}"/>
  </Style>

  <Style Selector="ComboBox:focus">
    <Setter Property="BorderBrush" Value="{DynamicResource AppPrimaryBrush}"/>
  </Style>

  <!-- Popup Box styling -->
  <Style Selector="ComboBox /template/ Popup#PART_Popup > Border">
    <Setter Property="Background" Value="{DynamicResource AppSurfaceElevatedBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="Padding" Value="4"/>
  </Style>

  <!-- ComboBoxItem base styling -->
  <Style Selector="ComboBoxItem">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Padding" Value="12,10"/>
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="Margin" Value="2,1"/>
    <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
  </Style>

  <!-- Hover State (PointerOver) -->
  <Style Selector="ComboBoxItem:pointerover">
    <Setter Property="Background" Value="{DynamicResource AppSurfaceSubtleBrush}"/>
  </Style>
  <Style Selector="ComboBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AppSurfaceSubtleBrush}"/>
  </Style>
  <Style Selector="ComboBoxItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AppSurfaceSubtleBrush}"/>
  </Style>

  <!-- Selected State -->
  <Style Selector="ComboBoxItem:selected">
    <Setter Property="Background" Value="{DynamicResource AppMenuSelectedBrush}"/>
  </Style>
  <Style Selector="ComboBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AppMenuSelectedBrush}"/>
  </Style>
  <Style Selector="ComboBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AppMenuSelectedBrush}"/>
  </Style>

  <!-- ══════════════ TOGGLESWITCH BRAND COLOR STYLING ══════════════ -->
  <Style Selector="ToggleSwitch">
    <Setter Property="OnContent" Value=""/>
    <Setter Property="OffContent" Value=""/>
    <Style.Resources>
      <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="{DynamicResource AppPrimaryColor}" />
      <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="{DynamicResource AppPrimaryHoverColor}" />
      <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="{DynamicResource AppPrimaryHoverColor}" />
      <SolidColorBrush x:Key="ToggleSwitchContainerFillOn" Color="{DynamicResource AppPrimaryColor}" />
      <SolidColorBrush x:Key="ToggleSwitchContainerFillOnPointerOver" Color="{DynamicResource AppPrimaryHoverColor}" />
      <SolidColorBrush x:Key="ToggleSwitchContainerFillOnPressed" Color="{DynamicResource AppPrimaryHoverColor}" />
      <SolidColorBrush x:Key="SemiToggleSwitchContainerFillOn" Color="{DynamicResource AppPrimaryColor}" />
      <SolidColorBrush x:Key="SemiToggleSwitchContainerFillOnPointerOver" Color="{DynamicResource AppPrimaryHoverColor}" />
      <SolidColorBrush x:Key="SemiToggleSwitchContainerFillOnPressed" Color="{DynamicResource AppPrimaryHoverColor}" />
      <SolidColorBrush x:Key="SemiColorSuccess" Color="{DynamicResource AppPrimaryColor}" />
      <SolidColorBrush x:Key="SemiColorSuccessPointerOver" Color="{DynamicResource AppPrimaryHoverColor}" />
    </Style.Resources>
  </Style>

  <!-- Track Container Background (Checked & Hover states) -->
  <Style Selector="ToggleSwitch:checked /template/ Border">
    <Setter Property="Background" Value="{DynamicResource AppPrimaryBrush}"/>
  </Style>
  <Style Selector="ToggleSwitch:checked:pointerover /template/ Border">
    <Setter Property="Background" Value="{DynamicResource AppPrimaryHoverBrush}"/>
  </Style>
  <Style Selector="ToggleSwitch:checked /template/ Rectangle">
    <Setter Property="Fill" Value="{DynamicResource AppPrimaryBrush}"/>
  </Style>
  <Style Selector="ToggleSwitch:checked:pointerover /template/ Rectangle">
    <Setter Property="Fill" Value="{DynamicResource AppPrimaryHoverBrush}"/>
  </Style>

  <!-- Preserve White Inner Circle Knob across all states -->
  <Style Selector="ToggleSwitch /template/ Canvas Border">
    <Setter Property="Background" Value="#FFFFFF"/>
  </Style>
  <Style Selector="ToggleSwitch:checked /template/ Canvas Border">
    <Setter Property="Background" Value="#FFFFFF"/>
  </Style>
  <Style Selector="ToggleSwitch:checked:pointerover /template/ Canvas Border">
    <Setter Property="Background" Value="#FFFFFF"/>
  </Style>
  <Style Selector="ToggleSwitch /template/ ContentPresenter#PART_Knob">
    <Setter Property="Background" Value="#FFFFFF"/>
  </Style>
  <Style Selector="ToggleSwitch:checked /template/ ContentPresenter#PART_Knob">
    <Setter Property="Background" Value="#FFFFFF"/>
  </Style>
  <Style Selector="ToggleSwitch /template/ Ellipse">
    <Setter Property="Fill" Value="#FFFFFF"/>
  </Style>
  <Style Selector="ToggleSwitch:checked /template/ Ellipse">
    <Setter Property="Fill" Value="#FFFFFF"/>
  </Style>

</Styles>
