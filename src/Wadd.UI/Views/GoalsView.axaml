<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Wadd.UI.ViewModels;assembly=Wadd.UI"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="760"
             x:Class="Wadd.UI.Views.GoalsView"
             x:DataType="vm:GoalsViewModel"
             Background="{DynamicResource AppBackgroundBrush}">

  <UserControl.Styles>
    <!-- View Container Margins matching TagsManagementView and SearchView -->
    <Style Selector="StackPanel.view-container">
      <Setter Property="Margin" Value="64,48,80,180"/>
    </Style>
    <Style Selector="StackPanel.view-container.compact">
      <Setter Property="Margin" Value="16,20,16,40"/>
    </Style>

    <!-- Filter Chip Pill Buttons (Smooth Hover, Max Width 150px, Ellipsis for long text) -->
    <Style Selector="Button.filter-chip">
      <Setter Property="Background" Value="{DynamicResource AppSurfaceElevatedBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="12,5"/>
      <Setter Property="MinHeight" Value="34"/>
      <Setter Property="MaxWidth" Value="150"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.15"/>
          <BrushTransition Property="Foreground" Duration="0:0:0.15"/>
          <BrushTransition Property="BorderBrush" Duration="0:0:0.15"/>
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.filter-chip:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AppSurfaceSubtleBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AppPrimaryBrush}"/>
    </Style>
    <Style Selector="Button.filter-chip.active">
      <Setter Property="Background" Value="{DynamicResource AppAccentTintBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource AppPrimaryBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AppPrimaryBrush}"/>
    </Style>
    <Style Selector="Button.filter-chip.active TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource AppPrimaryBrush}"/>
      <Setter Property="FontWeight" Value="Bold"/>
    </Style>
    <Style Selector="Button.filter-chip.active /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AppAccentTintBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource AppPrimaryBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AppPrimaryBrush}"/>
    </Style>

    <!-- Goal Card Item Style: Linear/Notion aesthetic, 3px teal accent border & tint on selected -->
    <Style Selector="Border.goal-card">
      <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="12,10"/>
      <Setter Property="Margin" Value="0,0,0,8"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Border.goal-card:pointerover">
      <Setter Property="Background" Value="{DynamicResource AppSurfaceElevatedBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AppPrimaryBrush}"/>
    </Style>
    <Style Selector="Border.goal-card.selected">
      <Setter Property="Background" Value="{DynamicResource AppMenuSelectedBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AppPrimaryBrush}"/>
      <Setter Property="BorderThickness" Value="3,1,1,1"/>
    </Style>

    <!-- Milestone Item Clean List Row with instant hover (No animation/transition) -->
    <Style Selector="Border.milestone-item">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
      <Setter Property="BorderThickness" Value="0,0,0,1"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Padding" Value="10,8"/>
      <Setter Property="Margin" Value="0,0,0,2"/>
    </Style>
    <Style Selector="Border.milestone-item:pointerover">
      <Setter Property="Background" Value="{DynamicResource AppSurfaceSubtleBrush}"/>
    </Style>
    <Style Selector="Border.milestone-item.completed">
      <Setter Property="Opacity" Value="0.55"/>
    </Style>

    <!-- Disable ghost checkmark animation on uncompleted milestone checkboxes to prevent blinking -->
    <Style Selector="Border.milestone-item CheckBox.task-checkbox:not(:checked):pointerover /template/ PathIcon#CheckIcon">
      <Setter Property="Opacity" Value="0"/>
    </Style>

    <!-- Journal Item Clean List Row with instant hover (No animation/transition) -->
    <Style Selector="Border.journal-item">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
      <Setter Property="BorderThickness" Value="0,0,0,1"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Padding" Value="12,10"/>
      <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>
    <Style Selector="Border.journal-item:pointerover">
      <Setter Property="Background" Value="{DynamicResource AppSurfaceSubtleBrush}"/>
    </Style>

    <Style Selector="TextBlock.milestone-title">
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="TextBlock.milestone-title.completed">
      <Setter Property="TextDecorations" Value="Strikethrough"/>
      <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}"/>
    </Style>
  </UserControl.Styles>

  <Panel>
    <!-- ═══════════════════════════════════════════════════════════════
         1. DESKTOP / WIDE LAYOUT (IsVisible="{Binding !IsCompact}")
         Multi-column Grid: Left Overview Column (320px), Right Details Column (*)
    ═══════════════════════════════════════════════════════════════ -->
    <Grid IsVisible="{Binding !IsCompact}" Margin="24,20,24,24" ColumnDefinitions="340,*" RowDefinitions="Auto,*">

      <!-- DESKTOP HEADER -->
      <Grid Grid.Row="0" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto" Margin="0,0,0,20">
        <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,16,0" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <PathIcon Data="{StaticResource TargetIconData}" Width="22" Height="22" Foreground="{DynamicResource AppPrimaryBrush}" VerticalAlignment="Center"/>
            <TextBlock Text="Life Goals &amp; Reflection Journal" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/>
          </StackPanel>
          <TextBlock Text="Organize long-term vision targets, milestone checklists, and daily reflective journal entries."
                     FontSize="13"
                     TextWrapping="Wrap"
                     Foreground="{DynamicResource AppTextSecondaryBrush}"/>
        </StackPanel>

        <!-- Main New Goal Action Button: Tier 1 Primary Commit Action -->
        <Button Grid.Column="1"
                Command="{Binding OpenCreateGoalDialogCommand}"
                Classes="btn-primary"
                Height="36"
                Padding="16,0"
                VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <PathIcon Data="{StaticResource PlusIconData}" Width="12" Height="12" Foreground="White" VerticalAlignment="Center"/>
            <TextBlock Text="New Life Goal" FontSize="13" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
      </Grid>

      <!-- DESKTOP LEFT COLUMN: GOALS OVERVIEW LIST & CATEGORY FILTERS -->
      <Border Grid.Row="1" Grid.Column="0"
              Classes="card"
              Margin="0,0,16,0"
              Padding="16"
              MinWidth="300">
        <Grid RowDefinitions="Auto,Auto,*">
          <TextBlock Grid.Row="0" Text="CATEGORIES" Classes="micro" IsVisible="{Binding HasCategories}" Margin="4,2,4,8"/>

          <!-- Category Filter Pills with Active Highlight Binding (Scrollable horizontal row with proper scrollbar spacing) -->
          <ScrollViewer x:Name="DesktopCategoriesScrollViewer"
                        Grid.Row="1"
                        HorizontalScrollBarVisibility="Auto"
                        VerticalScrollBarVisibility="Disabled"
                        AllowAutoHide="True"
                        IsVisible="{Binding HasCategories}"
                        Padding="0,2,0,0"
                        Margin="0,0,0,16">
            <ItemsControl ItemsSource="{Binding Categories}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,0,10"/>
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:CategoryFilterItemViewModel">
                  <Button Command="{Binding $parent[UserControl].((vm:GoalsViewModel)DataContext).SetCategoryFilterCommand}"
                          CommandParameter="{Binding Name}"
                          Classes="filter-chip"
                          Classes.active="{Binding IsSelected}">
                    <TextBlock Text="{Binding Name}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>

          <!-- Goals Cards List (Linear/Notion-style cards with Selected State) -->
          <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
            <ItemsControl ItemsSource="{Binding FilteredGoals}" HorizontalAlignment="Stretch" Margin="0,0,10,0">
              <ItemsControl.Styles>
                <Style Selector="ContentPresenter">
                  <Setter Property="HorizontalAlignment" Value="Stretch"/>
                </Style>
              </ItemsControl.Styles>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:LifeGoalItemViewModel">
                  <Button Command="{Binding $parent[UserControl].((vm:GoalsViewModel)DataContext).SelectGoalCommand}"
                          CommandParameter="{Binding}"
                          Classes="task-row-btn"
                          Margin="0,0,0,6"
                          HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Stretch">
                    <Border Classes="goal-card"
                            Classes.selected="{Binding IsSelected}"
                            HorizontalAlignment="Stretch">
                      <Grid RowDefinitions="Auto,Auto,Auto,Auto">
                        <!-- Header Row: Category Badge (Top-Left) & Status Label (Top-Right) -->
                        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,4">
                          <!-- Category Badge (Smaller pill, subtle background) -->
                          <Border Grid.Column="0"
                                  Background="{DynamicResource AppTagBackgroundBrush}"
                                  CornerRadius="6"
                                  Padding="6,2"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Left"
                                  MaxWidth="130"
                                  ClipToBounds="True"
                                  IsVisible="{Binding HasCategory}">
                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                              <PathIcon Data="{StaticResource TagIconData}" Width="9" Height="9" Foreground="{DynamicResource AppTagForegroundBrush}" VerticalAlignment="Center"/>
                              <TextBlock Text="{Binding Category}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AppTagForegroundBrush}" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                          </Border>

                          <!-- Standardized Status Label (Top-Right): "In Progress" or "Achieved" -->
                          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <PathIcon Data="{StaticResource CheckCircleIconData}" Width="11" Height="11" Foreground="{DynamicResource AppPrimaryBrush}" IsVisible="{Binding IsAchieved}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding StatusBadgeText}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource AppPrimaryBrush}"
                                       VerticalAlignment="Center"/>
                          </StackPanel>
                        </Grid>

                        <!-- Goal Title -->
                        <TextBlock Grid.Row="1" Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimaryBrush}" Margin="0,4,0,2" TextWrapping="Wrap"/>

                        <!-- Goal Description -->
                        <TextBlock Grid.Row="2" Text="{Binding Description}" FontSize="12" Foreground="{DynamicResource AppTextSecondaryBrush}" IsVisible="{Binding HasDescription}" MaxLines="1" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" Margin="0,0,0,4"/>

                        <!-- Slim High-Contrast Progress Strip & Consolidated Single Footer Row -->
                        <StackPanel Grid.Row="3" Spacing="6" Margin="0,2,0,0">
                          <!-- Slim, visible progress strip -->
                          <ProgressBar Value="{Binding ProgressPercentage}"
                                       Maximum="100"
                                       Height="4"
                                       CornerRadius="2"
                                       Foreground="{DynamicResource AppPrimaryBrush}"
                                       Background="{DynamicResource AppSurfaceSubtleBrush}"/>

                          <!-- Single Consolidated Footer Row -->
                          <Grid ColumnDefinitions="*,Auto">
                            <!-- Left: Steps Count + Percentage OR "No steps" -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" IsVisible="{Binding HasMilestones}">
                              <PathIcon Data="{StaticResource CheckListIconData}" Width="10" Height="10" Foreground="{DynamicResource AppTextSecondaryBrush}" VerticalAlignment="Center"/>
                              <TextBlock FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}" VerticalAlignment="Center">
                                <Run Text="{Binding CompletedMilestonesCount}"/><Run Text="/"/><Run Text="{Binding TotalMilestonesCount}"/><Run Text=" steps"/><Run Text=" • "/><Run Text="{Binding ProgressPercentage, StringFormat={}{0:0}%}"/>
                              </TextBlock>
                            </StackPanel>
                            <TextBlock Grid.Column="0" Text="No steps" FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}" VerticalAlignment="Center" IsVisible="{Binding !HasMilestones}"/>

                            <!-- Right: Target Date -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                              <PathIcon Data="{StaticResource CalendarIconData}" Width="10" Height="10" Foreground="{DynamicResource AppTextSecondaryBrush}" VerticalAlignment="Center"/>
                              <TextBlock Text="{Binding FormattedTargetDate}" FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                          </Grid>
                        </StackPanel>
                      </Grid>
                    </Border>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </Border>

      <!-- DESKTOP RIGHT COLUMN: FOCUSED GOAL DETAILS & JOURNAL TIMELINE -->
      <Border Grid.Row="1" Grid.Column="1"
              Classes="card"
              Padding="24,20,12,20"
              MinWidth="340"
              ClipToBounds="True"
              IsVisible="{Binding HasSelectedGoal}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" ClipToBounds="False" Padding="0,4,6,4">
          <StackPanel Spacing="24" ClipToBounds="False" Margin="0,0,18,0">

            <!-- FOCUSED GOAL HEADER (OPEN SECTION - NO NESTED CARD) -->
            <StackPanel Spacing="12" ClipToBounds="False">
              <!-- Top Category, Date & Action Bar -->
              <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0" ClipToBounds="False">
                <!-- Left: Category & Date Badges -->
                <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                  <!-- Category Badge -->
                  <Border Background="{DynamicResource AppTagBackgroundBrush}"
                          CornerRadius="10"
                          Padding="8,4"
                          Margin="0,0,8,4"
                          VerticalAlignment="Center"
                          IsVisible="{Binding SelectedGoal.HasCategory}">
                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                      <PathIcon Data="{StaticResource TagIconData}" Width="10" Height="10" Foreground="{DynamicResource AppTagForegroundBrush}" VerticalAlignment="Center"/>
                      <TextBlock Text="{Binding SelectedGoal.Category}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AppTagForegroundBrush}" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                  </Border>

                  <!-- Target Date Info (if any) -->
                  <Border Background="{DynamicResource AppSurfaceSubtleBrush}"
                          BorderBrush="{DynamicResource AppBorderBrush}"
                          BorderThickness="1"
                          CornerRadius="10"
                          Padding="8,4"
                          Margin="0,0,8,4"
                          VerticalAlignment="Center"
                          IsVisible="{Binding SelectedGoal.HasTargetDate}">
                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                      <PathIcon Data="{StaticResource CalendarIconData}" Width="11" Height="11" Foreground="{DynamicResource AppTextSecondaryBrush}" VerticalAlignment="Center"/>
                      <TextBlock Text="{Binding SelectedGoal.FormattedTargetDate}" FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                  </Border>
                </WrapPanel>

                <!-- Right: Action Buttons (Achieve / Reopen + Delete) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                  <!-- Secondary Action: Mark Achieved / Reopen Goal -->
                  <Button Command="{Binding ToggleGoalAchievedCommand}"
                          CommandParameter="{Binding SelectedGoal}"
                          Classes="btn-secondary"
                          Height="32" Padding="12,0"
                          VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                      <PathIcon Data="{StaticResource UndoIconData}" Width="11" Height="11" Foreground="{DynamicResource AppPrimaryBrush}" VerticalAlignment="Center" IsVisible="{Binding SelectedGoal.IsAchieved}"/>
                      <PathIcon Data="{StaticResource SparkleIconData}" Width="11" Height="11" Foreground="{DynamicResource AppPrimaryBrush}" VerticalAlignment="Center" IsVisible="{Binding !SelectedGoal.IsAchieved}"/>
                      <TextBlock Text="Reopen Goal" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppPrimaryBrush}" VerticalAlignment="Center" IsVisible="{Binding SelectedGoal.IsAchieved}"/>
                      <TextBlock Text="Mark Achieved" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppPrimaryBrush}" VerticalAlignment="Center" IsVisible="{Binding !SelectedGoal.IsAchieved}"/>
                    </StackPanel>
                  </Button>

                  <!-- Separated Destructive Action: Delete Button -->
                  <Button Command="{Binding DeleteGoalCommand}"
                          CommandParameter="{Binding SelectedGoal}"
                          Classes="danger"
                          MinHeight="32" Width="32" Padding="6"
                          VerticalAlignment="Center"
                          ToolTip.Tip="Delete Goal">
                    <PathIcon Data="{StaticResource TrashIconData}" Width="13" Height="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Button>
                </StackPanel>
              </Grid>

              <!-- Goal Title & Description (Strong Typography Hierarchy) -->
              <TextBlock Text="{Binding SelectedGoal.Title}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
              <TextBlock Text="{Binding SelectedGoal.Description}" FontSize="14" Foreground="{DynamicResource AppTextSecondaryBrush}" IsVisible="{Binding SelectedGoal.HasDescription}" TextWrapping="Wrap" Margin="0,0,0,4"/>

              <!-- High Contrast Goal Progress Bar -->
              <StackPanel Spacing="6" Margin="0,4,0,0">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Grid.Column="0" Text="Overall Goal Progress" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AppTextSecondaryBrush}" VerticalAlignment="Center"/>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                    <PathIcon Data="{StaticResource CheckCircleIconData}" Width="12" Height="12" Foreground="{DynamicResource AppPrimaryBrush}" IsVisible="{Binding SelectedGoal.IsAchieved}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding SelectedGoal.StatusText}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AppPrimaryBrush}" VerticalAlignment="Center"/>
                  </StackPanel>
                </Grid>
                <ProgressBar Value="{Binding SelectedGoal.ProgressPercentage}" Maximum="100" Height="8" CornerRadius="4" Foreground="{DynamicResource AppPrimaryBrush}" Background="{DynamicResource AppSurfaceSubtleBrush}"/>
              </StackPanel>
            </StackPanel>

            <!-- SECTION 1: SEQUENTIAL MILESTONE CHECKLIST (OPEN SECTION) -->
            <StackPanel Spacing="12">
              <!-- Section Header Row -->
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Grid Grid.Column="0" ColumnDefinitions="Auto,*" ColumnSpacing="8" VerticalAlignment="Center">
                  <PathIcon Grid.Column="0" Data="{StaticResource CheckListIconData}" Width="16" Height="16" Foreground="{DynamicResource AppPrimaryBrush}" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="1" Text="Milestones" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </Grid>

                <!-- Secondary Tier Action: ✨ AI Suggest Steps -->
                <Button Grid.Column="1"
                        Command="{Binding GenerateMilestonesWithAiCommand}"
                        Classes="btn-secondary"
                        IsEnabled="{Binding !IsAiGeneratingMilestones}"
                        Height="28" Padding="10,0"
                        VerticalAlignment="Center"
                        ToolTip.Tip="Automatically decompose this goal into sequential milestone steps">
                  <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                    <PathIcon Data="{StaticResource SparkleIconData}" Width="11" Height="11" Foreground="{DynamicResource AppPrimaryBrush}"/>
                    <TextBlock Text="AI Suggest" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppPrimaryBrush}"/>
                  </StackPanel>
                </Button>
              </Grid>

              <!-- 1px Subtle Section Divider -->
              <Separator Classes="divider"/>
              <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsAiGeneratingMilestones}" Height="2" CornerRadius="1" Foreground="{DynamicResource AppPrimaryBrush}" Margin="0,-6,0,0"/>

              <!-- Milestone Input Bar -->
              <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,4">
                <TextBox Grid.Column="0"
                         Text="{Binding NewMilestoneTitle}"
                         Classes="styled"
                         PlaceholderText="Add next step or milestone..."
                         Padding="12,8"
                         MinHeight="36"
                         MaxLength="100"
                         CornerRadius="6"
                         Margin="0,0,8,0"
                         VerticalContentAlignment="Center">
                  <TextBox.KeyBindings>
                    <KeyBinding Gesture="Enter" Command="{Binding AddMilestoneCommand}"/>
                  </TextBox.KeyBindings>
                </TextBox>

                <!-- Secondary Tier Action: Add Step -->
                <Button Grid.Column="1"
                        Command="{Binding AddMilestoneCommand}"
                        Classes="btn-secondary"
                        Height="36"
                        Padding="14,0"
                        VerticalAlignment="Center">
                  <TextBlock Text="Add Step" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </Button>
              </Grid>

              <!-- Milestone List (Clean List Rows with Hover) -->
              <ItemsControl ItemsSource="{Binding CurrentMilestones}" HorizontalAlignment="Stretch">
                <ItemsControl.Styles>
                  <Style Selector="ContentPresenter">
                    <Setter Property="HorizontalAlignment" Value="Stretch"/>
                  </Style>
                </ItemsControl.Styles>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:GoalMilestoneItemViewModel">
                    <Border Classes="milestone-item" Classes.completed="{Binding IsCompleted}" HorizontalAlignment="Stretch">
                      <Grid ColumnDefinitions="Auto,*,Auto">
                        <CheckBox Grid.Column="0"
                                  Classes="task-checkbox"
                                  IsChecked="{Binding IsCompleted}"
                                  Command="{Binding $parent[UserControl].((vm:GoalsViewModel)DataContext).ToggleMilestoneCommand}"
                                  CommandParameter="{Binding}"
                                  MinHeight="28" MinWidth="28"
                                  Margin="0,0,10,0"
                                  VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding Title}"
                                   Classes="milestone-title"
                                   Classes.completed="{Binding IsCompleted}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,8,0"
                                   FontSize="13"
                                   VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                          <Button Command="{Binding $parent[UserControl].((vm:GoalsViewModel)DataContext).MoveMilestoneUpCommand}"
                                  CommandParameter="{Binding}"
                                  Classes="icon-btn"
                                  MinHeight="26" MinWidth="26" Padding="4"
                                  ToolTip.Tip="Move step up">
                            <PathIcon Data="{StaticResource ChevronUpIconData}" Width="10" Height="10"/>
                          </Button>
                          <Button Command="{Binding $parent[UserControl].((vm:GoalsViewModel)DataContext).MoveMilestoneDownCommand}"
                                  CommandParameter="{Binding}"
                                  Classes="icon-btn"
                                  MinHeight="26" MinWidth="26" Padding="4"
                                  ToolTip.Tip="Move step down">
                            <PathIcon Data="{StaticResource ChevronDownIconData}" Width="10" Height="10"/>
                          </Button>
                          <Button Command="{Binding $parent[UserControl].((vm:GoalsViewModel)DataContext).DeleteMilestoneCommand}"
                                  CommandParameter="{Binding}"
                                  Classes="danger"
                                  MinHeight="26" MinWidth="26" Padding="4"
                                  ToolTip.Tip="Delete step">
                            <PathIcon Data="{StaticResource TrashIconData}" Width="11" Height="11"/>
                          </Button>
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <!-- SECTION 2: REFLECTIVE JOURNAL TIMELINE (OPEN SECTION) -->
            <StackPanel Spacing="12">
              <!-- Section Header Row with Title on Left and Action Buttons on Right -->
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Grid Grid.Column="0" ColumnDefinitions="Auto,*" ColumnSpacing="8" VerticalAlignment="Center">
                  <PathIcon Grid.Column="0" Data="{StaticResource BookIconData}" Width="16" Height="16" Foreground="{DynamicResource AppPrimaryBrush}" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="1" Text="Reflective Journal" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </Grid>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                  <!-- AI Draft Reflection -->
                  <Button Command="{Binding GenerateJournalDraftWithAiCommand}"
                          Classes="btn-secondary"
                          IsEnabled="{Binding !IsAiGeneratingJournal}"
                          Height="28" Padding="8,0"
                          VerticalAlignment="Center"
                          ToolTip.Tip="Generate an inspiring reflection draft based on goal progress">
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                      <PathIcon Data="{StaticResource SparkleIconData}" Width="11" Height="11" Foreground="{DynamicResource AppPrimaryBrush}"/>
                      <TextBlock Text="AI Draft" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppPrimaryBrush}"/>
                    </StackPanel>
                  </Button>

                  <!-- Secondary Tier Action: + Write Entry -->
                  <Button Command="{Binding OpenCreateJournalFormCommand}"
                          Classes="btn-secondary"
                          Height="28" Padding="10,0"
                          VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                      <PathIcon Data="{StaticResource PlusIconData}" Width="11" Height="11" Foreground="{DynamicResource AppPrimaryBrush}" VerticalAlignment="Center"/>
                      <TextBlock Text="Write Entry" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppPrimaryBrush}"/>
                    </StackPanel>
                  </Button>
                </StackPanel>
              </Grid>

              <!-- 1px Subtle Section Divider -->
              <Separator Classes="divider"/>
              <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsAiGeneratingJournal}" Height="2" CornerRadius="1" Foreground="{DynamicResource AppPrimaryBrush}" Margin="0,-6,0,0"/>

              <!-- FLATTENED INLINE COMPOSE FORM (No surrounding box or background fill) -->
              <StackPanel Spacing="10" Margin="0,4,0,10" IsVisible="{Binding IsCreatingJournal}">
                <TextBlock Text="WRITE NEW ENTRY" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AppTextSecondaryBrush}"/>

                <!-- Borderless Underlined Input for Title with Left Padding for Text & Placeholder -->
                <TextBox Text="{Binding NewJournalTitle}"
                         Classes="styled"
                         PlaceholderText="Entry title (e.g. Today's win)..."
                         Background="Transparent"
                         BorderBrush="{DynamicResource AppBorderBrush}"
                         BorderThickness="0,0,0,1"
                         CornerRadius="0"
                         Padding="10,8"
                         MinHeight="38"
                         MaxLength="100"
                         VerticalContentAlignment="Center"/>

                <!-- Borderless Underlined Textarea for Body with Left Padding for Text & Placeholder -->
                <TextBox Text="{Binding NewJournalContent}"
                         Classes="styled"
                         PlaceholderText="What went well or what did you learn today?..."
                         Background="Transparent"
                         BorderBrush="{DynamicResource AppBorderBrush}"
                         BorderThickness="0,0,0,1"
                         CornerRadius="0"
                         Padding="10,8"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         MaxLength="2000"
                         MinHeight="80"
                         VerticalContentAlignment="Top"
                         HorizontalContentAlignment="Left"/>

                <!-- Action Buttons: Cancel (Text-only ghost) + Save Reflection (Primary solid teal) -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,4,0,0">
                  <Button Command="{Binding CancelCreateJournalCommand}"
                          Classes="btn-text"
                          Content="Cancel"
                          Height="32" Padding="12,0"
                          VerticalAlignment="Center"/>
                  <Button Command="{Binding SaveJournalEntryCommand}"
                          Classes="btn-primary"
                          Height="32" Padding="16,0"
                          VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                      <PathIcon Data="{StaticResource CheckIconData}" Width="12" Height="12" Foreground="White" VerticalAlignment="Center"/>
                      <TextBlock Text="Save Reflection" FontSize="12" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                    </StackPanel>
                  </Button>
                </StackPanel>
              </StackPanel>

              <!-- Journal Entries List (Clean List Rows with Hover) -->
              <ItemsControl ItemsSource="{Binding CurrentJournalEntries}" HorizontalAlignment="Stretch">
                <ItemsControl.Styles>
                  <Style Selector="ContentPresenter">
                    <Setter Property="HorizontalAlignment" Value="Stretch"/>
                  </Style>
                </ItemsControl.Styles>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:JournalEntryItemViewModel">
                    <Border Classes="journal-item" HorizontalAlignment="Stretch">
                      <Grid RowDefinitions="Auto,Auto,Auto">
                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                          <TextBlock Grid.Column="0" Text="{Binding FormattedEntryDate}" FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}" VerticalAlignment="Center"/>
                          <Button Grid.Column="1" Command="{Binding $parent[UserControl].((vm:GoalsViewModel)DataContext).DeleteJournalEntryCommand}" CommandParameter="{Binding}" Classes="danger" MinHeight="26" MinWidth="26" Padding="4" VerticalAlignment="Center">
                            <PathIcon Data="{StaticResource TrashIconData}" Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                          </Button>
                        </Grid>
                        <TextBlock Grid.Row="1" Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimaryBrush}" Margin="0,4,0,2" TextWrapping="Wrap"/>
                        <TextBlock Grid.Row="2" Text="{Binding Content}" FontSize="13" Foreground="{DynamicResource AppTextSecondaryBrush}" TextWrapping="Wrap"/>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

          </StackPanel>
        </ScrollViewer>
      </Border>

      <!-- Placeholder when no goal selected on Desktop -->
      <Border Grid.Row="1" Grid.Column="1"
              Classes="card"
              MinWidth="340"
              IsVisible="{Binding !HasSelectedGoal}">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" Margin="24">
          <PathIcon Data="{StaticResource TargetIconData}" Width="44" Height="44" Foreground="{DynamicResource AppPrimaryBrush}" Opacity="0.85" HorizontalAlignment="Center" Margin="0,0,0,4"/>
          <TextBlock Text="Select a Life Goal" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimaryBrush}" TextAlignment="Center" HorizontalAlignment="Center"/>
          <TextBlock Text="Choose a goal from the left to view milestones and journal timeline."
                     FontSize="12"
                     TextWrapping="Wrap"
                     TextAlignment="Center"
                     HorizontalAlignment="Center"
                     MaxWidth="280"
                     Foreground="{DynamicResource AppTextSecondaryBrush}"/>
        </StackPanel>
      </Border>
    </Grid>

    <!-- ═══════════════════════════════════════════════════════════════
         2. ANDROID / NARROW SCREEN PORTRAIT DRILL-DOWN LAYOUT (IsVisible="{Binding IsCompact}")
         Single-column drill-down navigation: Overview List <-> Goal Details
    ═══════════════════════════════════════════════════════════════ -->
    <Grid IsVisible="{Binding IsCompact}" Margin="16,16,16,32" HorizontalAlignment="Stretch">

      <!-- SCREEN 1: GOALS OVERVIEW LIST (When !IsMobileDetailViewOpen) -->
      <Grid IsVisible="{Binding !IsMobileDetailViewOpen}" RowDefinitions="Auto,Auto,*" HorizontalAlignment="Stretch">
        <!-- Header -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,2,0,8">
          <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center" Margin="0,0,8,0">
            <TextBlock Text="LIFE GOALS" Classes="micro" Foreground="{DynamicResource AppPrimaryBrush}"/>
            <TextBlock Text="Goals &amp; Reflection" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimaryBrush}" TextWrapping="Wrap"/>
          </StackPanel>

          <Button Grid.Column="1"
                  Command="{Binding OpenCreateGoalDialogCommand}"
                  Classes="btn-primary"
                  Height="36"
                  Padding="14,0"
                  VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <PathIcon Data="{StaticResource PlusIconData}" Width="12" Height="12" Foreground="White"/>
              <TextBlock Text="Goal" FontSize="12" FontWeight="SemiBold" Foreground="White"/>
            </StackPanel>
          </Button>
        </Grid>

        <!-- Scrollable Category Filter Pills with Active Highlight Binding (Scrollable horizontal row with proper scrollbar spacing) -->
        <ScrollViewer x:Name="MobileCategoriesScrollViewer"
                      Grid.Row="1"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Disabled"
                      AllowAutoHide="True"
                      IsVisible="{Binding HasCategories}"
                      Padding="0,2,0,0"
                      Margin="0,0,0,16">
          <ItemsControl ItemsSource="{Binding Categories}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,0,10"/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:CategoryFilterItemViewModel">
                <Button Command="{Binding $parent[UserControl].((vm:GoalsViewModel)DataContext).SetCategoryFilterCommand}"
                        CommandParameter="{Binding Name}"
                        Classes="filter-chip"
                        Classes.active="{Binding IsSelected}"
                        MinHeight="36">
                  <TextBlock Text="{Binding Name}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

        <!-- Goals Overview Cards List (Mobile - Clean Navigational Cards without persistent selected state) -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" ClipToBounds="True" HorizontalAlignment="Stretch" Padding="0,0,4,0">
          <ItemsControl ItemsSource="{Binding FilteredGoals}" HorizontalAlignment="Stretch" Margin="0,0,10,0">
            <ItemsControl.Styles>
              <Style Selector="ContentPresenter">
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
              </Style>
            </ItemsControl.Styles>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:LifeGoalItemViewModel">
                <Button Command="{Binding $parent[UserControl].((vm:GoalsViewModel)DataContext).SelectGoalCommand}"
                        CommandParameter="{Binding}"
                        Classes="task-row-btn"
                        Margin="0,0,0,8"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch">
                  <Border Classes="goal-card"
                          HorizontalAlignment="Stretch">
                    <StackPanel Spacing="5">
                      <!-- Header Row: Category Badge (Top-Left) & Status Label (Top-Right) -->
                      <Grid ColumnDefinitions="Auto,*,Auto">
                        <Border Grid.Column="0"
                                Background="{DynamicResource AppTagBackgroundBrush}"
                                CornerRadius="6"
                                Padding="6,2"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Left"
                                MaxWidth="130"
                                ClipToBounds="True"
                                IsVisible="{Binding HasCategory}">
                          <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <PathIcon Data="{StaticResource TagIconData}" Width="9" Height="9" Foreground="{DynamicResource AppTagForegroundBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Category}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AppTagForegroundBrush}" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                          </StackPanel>
                        </Border>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                          <PathIcon Data="{StaticResource CheckCircleIconData}" Width="11" Height="11" Foreground="{DynamicResource AppPrimaryBrush}" IsVisible="{Binding IsAchieved}" VerticalAlignment="Center"/>
                          <TextBlock Text="{Binding StatusBadgeText}"
                                     FontSize="11"
                                     FontWeight="SemiBold"
                                     Foreground="{DynamicResource AppTextSecondaryBrush}"
                                     VerticalAlignment="Center"/>
                        </StackPanel>
                      </Grid>

                      <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimaryBrush}" TextWrapping="Wrap"/>
                      <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{DynamicResource AppTextSecondaryBrush}" IsVisible="{Binding HasDescription}" MaxLines="1" TextTrimming="CharacterEllipsis" TextWrapping="Wrap"/>

                      <!-- Consolidated Single Footer Row -->
                      <Grid ColumnDefinitions="*,Auto" Margin="0,2,0,0">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" IsVisible="{Binding HasMilestones}">
                          <PathIcon Data="{StaticResource CheckListIconData}" Width="10" Height="10" Foreground="{DynamicResource AppTextSecondaryBrush}" VerticalAlignment="Center"/>
                          <TextBlock FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}" VerticalAlignment="Center">
                            <Run Text="{Binding CompletedMilestonesCount}"/><Run Text="/"/><Run Text="{Binding TotalMilestonesCount}"/><Run Text=" steps"/><Run Text=" • "/><Run Text="{Binding ProgressPercentage, StringFormat={}{0:0}%}"/>
                          </TextBlock>
                        </StackPanel>
                        <TextBlock Grid.Column="0" Text="No steps" FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}" VerticalAlignment="Center" IsVisible="{Binding !HasMilestones}"/>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                          <PathIcon Data="{StaticResource CalendarIconData}" Width="10" Height="10" Foreground="{DynamicResource AppTextSecondaryBrush}" VerticalAlignment="Center"/>
                          <TextBlock Text="{Binding FormattedTargetDate}" FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                      </Grid>

                      <!-- Slim 3px Progress Strip Under Footer Line -->
                      <ProgressBar Value="{Binding ProgressPercentage}"
                                   Maximum="100"
                                   Height="3"
                                   CornerRadius="1.5"
                                   Foreground="{DynamicResource AppPrimaryBrush}"
                                   Background="{DynamicResource AppSurfaceSubtleBrush}"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                  </Border>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>

      <!-- SCREEN 2: GOAL DETAIL VIEW (When IsMobileDetailViewOpen) -->
      <Grid IsVisible="{Binding IsMobileDetailViewOpen}" RowDefinitions="Auto,*" HorizontalAlignment="Stretch">

        <!-- Top Bar Toolbar (Transparent Header with Clean Back Button) -->
        <Border Grid.Row="0"
                Background="Transparent"
                BorderThickness="0"
                Padding="0,4,0,8"
                Margin="0,0,0,10"
                HorizontalAlignment="Stretch">
          <Grid ColumnDefinitions="Auto,*,Auto,Auto">
            <!-- Back Button -->
            <Button Grid.Column="0"
                    Command="{Binding CloseMobileDetailCommand}"
                    Classes="icon-btn"
                    MinHeight="36" MinWidth="36" Padding="6"
                    VerticalAlignment="Center"
                    ToolTip.Tip="Back to Goals">
              <PathIcon Data="{StaticResource ChevronLeftIconData}" Width="16" Height="16" Foreground="{DynamicResource AppTextPrimaryBrush}"/>
            </Button>

            <TextBlock Grid.Column="1"
                       Text="{Binding SelectedGoal.Title}"
                       FontSize="16" FontWeight="Bold"
                       Foreground="{DynamicResource AppTextPrimaryBrush}"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       Margin="8,0"/>

            <!-- Secondary Tier Action: Reopen / Achieve -->
            <Button Grid.Column="2"
                    Command="{Binding ToggleGoalAchievedCommand}"
                    CommandParameter="{Binding SelectedGoal}"
                    Classes="btn-secondary"
                    Height="32" Padding="10,0" Margin="0,0,6,0"
                    VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <PathIcon Data="{StaticResource UndoIconData}" Width="12" Height="12" Foreground="{DynamicResource AppPrimaryBrush}" VerticalAlignment="Center" IsVisible="{Binding SelectedGoal.IsAchieved}"/>
                <PathIcon Data="{StaticResource SparkleIconData}" Width="12" Height="12" Foreground="{DynamicResource AppPrimaryBrush}" VerticalAlignment="Center" IsVisible="{Binding !SelectedGoal.IsAchieved}"/>
                <TextBlock Text="Reopen" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppPrimaryBrush}" VerticalAlignment="Center" IsVisible="{Binding SelectedGoal.IsAchieved}"/>
                <TextBlock Text="Achieve" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppPrimaryBrush}" VerticalAlignment="Center" IsVisible="{Binding !SelectedGoal.IsAchieved}"/>
              </StackPanel>
            </Button>

            <Button Grid.Column="3"
                    Command="{Binding DeleteGoalCommand}"
                    CommandParameter="{Binding SelectedGoal}"
                    Classes="danger"
                    MinHeight="32" Width="32" Padding="6"
                    VerticalAlignment="Center">
              <PathIcon Data="{StaticResource TrashIconData}" Width="13" Height="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Button>
          </Grid>
        </Border>

        <!-- Scrollable Detail Content (Mobile / Portrait View - Open Sections, No Nested Cards) -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" ClipToBounds="True" HorizontalAlignment="Stretch" Padding="0,4,4,0">
          <StackPanel Spacing="20" Margin="0,0,14,24">

            <!-- Overall Progress Summary (Open Header) -->
            <StackPanel Spacing="10">
              <Grid ColumnDefinitions="*,Auto">
                <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                  <Border Background="{DynamicResource AppTagBackgroundBrush}"
                          CornerRadius="6"
                          Padding="6,2"
                          Margin="0,0,6,2"
                          VerticalAlignment="Center"
                          IsVisible="{Binding SelectedGoal.HasCategory}">
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                      <PathIcon Data="{StaticResource TagIconData}" Width="9" Height="9" Foreground="{DynamicResource AppTagForegroundBrush}"/>
                      <TextBlock Text="{Binding SelectedGoal.Category}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AppTagForegroundBrush}" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                  </Border>
                  <Border Background="{DynamicResource AppSurfaceSubtleBrush}"
                          BorderBrush="{DynamicResource AppBorderBrush}"
                          BorderThickness="1"
                          CornerRadius="6"
                          Padding="6,2"
                          Margin="0,0,6,2"
                          VerticalAlignment="Center"
                          IsVisible="{Binding SelectedGoal.HasTargetDate}">
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                      <PathIcon Data="{StaticResource CalendarIconData}" Width="9" Height="9" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                      <TextBlock Text="{Binding SelectedGoal.FormattedTargetDate}" FontSize="10" Foreground="{DynamicResource AppTextSecondaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                  </Border>
                </WrapPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                  <PathIcon Data="{StaticResource CheckCircleIconData}" Width="11" Height="11" Foreground="{DynamicResource AppPrimaryBrush}" IsVisible="{Binding SelectedGoal.IsAchieved}"/>
                  <TextBlock Text="{Binding SelectedGoal.StatusText}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AppPrimaryBrush}"/>
                </StackPanel>
              </Grid>
              <ProgressBar Value="{Binding SelectedGoal.ProgressPercentage}" Maximum="100" Height="8" CornerRadius="4" Foreground="{DynamicResource AppPrimaryBrush}" Background="{DynamicResource AppSurfaceSubtleBrush}"/>
              <TextBlock Text="{Binding SelectedGoal.Description}" FontSize="13" Foreground="{DynamicResource AppTextSecondaryBrush}" IsVisible="{Binding SelectedGoal.HasDescription}" TextWrapping="Wrap"/>
            </StackPanel>

            <!-- Sequential Milestone Checklist (Open Section) -->
            <StackPanel Spacing="10">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                  <PathIcon Data="{StaticResource CheckListIconData}" Width="16" Height="16" Foreground="{DynamicResource AppPrimaryBrush}" VerticalAlignment="Center"/>
                  <TextBlock Text="Sequential Milestones" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                </StackPanel>
                <Button Grid.Column="1"
                        Command="{Binding GenerateMilestonesWithAiCommand}"
                        Classes="btn-secondary"
                        IsEnabled="{Binding !IsAiGeneratingMilestones}"
                        Height="28" Padding="8,0"
                        VerticalAlignment="Center">
                  <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <PathIcon Data="{StaticResource SparkleIconData}" Width="10" Height="10" Foreground="{DynamicResource AppPrimaryBrush}"/>
                    <TextBlock Text="AI Steps" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppPrimaryBrush}"/>
                  </StackPanel>
                </Button>
              </Grid>
              <Separator Classes="divider"/>
              <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsAiGeneratingMilestones}" Height="2" CornerRadius="1" Foreground="{DynamicResource AppPrimaryBrush}" Margin="0,-6,0,0"/>

              <!-- Add Milestone Form -->
              <Grid ColumnDefinitions="*,Auto" Margin="0,2,0,2">
                <TextBox Grid.Column="0"
                         Text="{Binding NewMilestoneTitle}"
                         Classes="styled"
                         PlaceholderText="Add next milestone step..."
                         Padding="10,6"
                         MinHeight="36"
                         MaxLength="100"
                         CornerRadius="6"
                         Margin="0,0,8,0"
                         VerticalContentAlignment="Center">
                  <TextBox.KeyBindings>
                    <KeyBinding Gesture="Enter" Command="{Binding AddMilestoneCommand}"/>
                  </TextBox.KeyBindings>
                </TextBox>

                <Button Grid.Column="1"
                        Command="{Binding AddMilestoneCommand}"
                        Classes="btn-secondary"
                        Height="36"
                        Padding="14,0"
                        VerticalAlignment="Center">
                  <TextBlock Text="Add" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </Button>
              </Grid>

              <ItemsControl ItemsSource="{Binding CurrentMilestones}" HorizontalAlignment="Stretch">
                <ItemsControl.Styles>
                  <Style Selector="ContentPresenter">
                    <Setter Property="HorizontalAlignment" Value="Stretch"/>
                  </Style>
                </ItemsControl.Styles>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:GoalMilestoneItemViewModel">
                    <Border Classes="milestone-item" Classes.completed="{Binding IsCompleted}" HorizontalAlignment="Stretch">
                      <Grid ColumnDefinitions="Auto,*,Auto">
                        <CheckBox Grid.Column="0" Classes="task-checkbox" IsChecked="{Binding IsCompleted}" Command="{Binding $parent[UserControl].((vm:GoalsViewModel)DataContext).ToggleMilestoneCommand}" CommandParameter="{Binding}" MinHeight="28" MinWidth="28" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding Title}" Classes="milestone-title" Classes.completed="{Binding IsCompleted}" TextWrapping="Wrap" Margin="0,0,8,0" FontSize="13" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                          <Button Command="{Binding $parent[UserControl].((vm:GoalsViewModel)DataContext).MoveMilestoneUpCommand}"
                                  CommandParameter="{Binding}"
                                  Classes="icon-btn"
                                  MinHeight="26" MinWidth="26" Padding="4"
                                  ToolTip.Tip="Move step up">
                            <PathIcon Data="{StaticResource ChevronUpIconData}" Width="10" Height="10"/>
                          </Button>
                          <Button Command="{Binding $parent[UserControl].((vm:GoalsViewModel)DataContext).MoveMilestoneDownCommand}"
                                  CommandParameter="{Binding}"
                                  Classes="icon-btn"
                                  MinHeight="26" MinWidth="26" Padding="4"
                                  ToolTip.Tip="Move step down">
                            <PathIcon Data="{StaticResource ChevronDownIconData}" Width="10" Height="10"/>
                          </Button>
                          <Button Command="{Binding $parent[UserControl].((vm:GoalsViewModel)DataContext).DeleteMilestoneCommand}"
                                  CommandParameter="{Binding}"
                                  Classes="danger"
                                  MinHeight="26" MinWidth="26" Padding="4"
                                  ToolTip.Tip="Delete step">
                            <PathIcon Data="{StaticResource TrashIconData}" Width="11" Height="11"/>
                          </Button>
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <!-- Collapsible Reflection Journal Timeline (Open Section) -->
            <StackPanel Spacing="10">
              <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,0,4,0">
                  <PathIcon Data="{StaticResource BookIconData}" Width="16" Height="16" Foreground="{DynamicResource AppPrimaryBrush}" VerticalAlignment="Center"/>
                  <TextBlock Text="Reflection" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimaryBrush}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                </StackPanel>

                <Button Grid.Column="1"
                        Command="{Binding GenerateJournalDraftWithAiCommand}"
                        Classes="btn-secondary"
                        IsEnabled="{Binding !IsAiGeneratingJournal}"
                        Height="30" Padding="8,0" Margin="0,0,4,0">
                  <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <PathIcon Data="{StaticResource SparkleIconData}" Width="10" Height="10" Foreground="{DynamicResource AppPrimaryBrush}"/>
                    <TextBlock Text="AI Draft" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppPrimaryBrush}"/>
                  </StackPanel>
                </Button>

                <Button Grid.Column="2"
                        Command="{Binding OpenJournalBottomSheetCommand}"
                        Classes="btn-secondary"
                        Height="30" Padding="10,0" Margin="0,0,4,0">
                  <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <PathIcon Data="{StaticResource PlusIconData}" Width="11" Height="11" Foreground="{DynamicResource AppPrimaryBrush}"/>
                    <TextBlock Text="Write" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppPrimaryBrush}"/>
                  </StackPanel>
                </Button>

                <Button Grid.Column="3"
                        Command="{Binding ToggleJournalCollapsibleCommand}"
                        Classes="icon-btn"
                        MinHeight="32" MinWidth="32" Padding="6">
                  <PathIcon Data="{StaticResource ChevronDownIconData}" Width="14" Height="14" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                </Button>
              </Grid>
              <Separator Classes="divider"/>

              <!-- Scrollable timeline entry rows when expanded -->
              <ItemsControl ItemsSource="{Binding CurrentJournalEntries}" IsVisible="{Binding IsJournalCollapsibleExpanded}" HorizontalAlignment="Stretch">
                <ItemsControl.Styles>
                  <Style Selector="ContentPresenter">
                    <Setter Property="HorizontalAlignment" Value="Stretch"/>
                  </Style>
                </ItemsControl.Styles>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:JournalEntryItemViewModel">
                    <Border Classes="journal-item" HorizontalAlignment="Stretch">
                      <Grid RowDefinitions="Auto,Auto,Auto">
                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                          <TextBlock Grid.Column="0" Text="{Binding FormattedEntryDate}" FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Command="{Binding $parent[UserControl].((vm:GoalsViewModel)DataContext).DeleteJournalEntryCommand}" CommandParameter="{Binding}" Classes="danger" MinHeight="26" MinWidth="26" Padding="4">
                            <PathIcon Data="{StaticResource TrashIconData}" Width="12" Height="12"/>
                          </Button>
                        </Grid>
                        <TextBlock Grid.Row="1" Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimaryBrush}" Margin="0,4,0,2" TextWrapping="Wrap"/>
                        <TextBlock Grid.Row="2" Text="{Binding Content}" FontSize="13" Foreground="{DynamicResource AppTextSecondaryBrush}" TextWrapping="Wrap"/>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

          </StackPanel>
        </ScrollViewer>

      </Grid>
    </Grid>

    <!-- ═══════════════════════════════════════════════════════════════
         REFLECTION JOURNAL BOTTOM SHEET / MODAL
    ═══════════════════════════════════════════════════════════════ -->
    <Panel IsVisible="{Binding IsJournalBottomSheetOpen}" ZIndex="2000" Background="#90000000">
      <Border VerticalAlignment="Center"
              HorizontalAlignment="Center"
              MaxWidth="500"
              MaxHeight="580"
              Margin="16,24"
              Background="{DynamicResource AppSurfaceBrush}"
              BorderBrush="{DynamicResource AppBorderBrush}"
              BorderThickness="1"
              CornerRadius="16"
              Padding="0"
              BoxShadow="0 10 25 0 #80000000">
        <Grid RowDefinitions="Auto,*,Auto">
          <!-- Header -->
          <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="20,18,20,12">
            <TextBlock Grid.Column="0" Text="Write Reflection Entry" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimaryBrush}" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Command="{Binding CloseJournalBottomSheetCommand}" Classes="icon-btn" Padding="6" Height="30" Width="30">
              <PathIcon Data="{StaticResource CloseIconData}" Width="12" Height="12"/>
            </Button>
          </Grid>

          <!-- Scrollable Body -->
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="20,0,20,12">
            <StackPanel Spacing="14">
              <TextBox Text="{Binding NewJournalTitle}" Classes="styled" PlaceholderText="Entry title (e.g. Today's win)..." Padding="12,8" MinHeight="42" MaxLength="100" CornerRadius="6" VerticalContentAlignment="Center"/>
              <TextBox Text="{Binding NewJournalContent}" Classes="styled" PlaceholderText="What went well or what did you learn today?..." Padding="12,8" AcceptsReturn="True" TextWrapping="Wrap" MaxLength="2000" MinHeight="140" CornerRadius="6" VerticalContentAlignment="Top" HorizontalContentAlignment="Left"/>
            </StackPanel>
          </ScrollViewer>

          <!-- Footer -->
          <Border Grid.Row="2" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,1,0,0" Padding="20,12" Background="{DynamicResource AppSurfaceSubtleBrush}" CornerRadius="0,0,16,16">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12">
              <Button Command="{Binding CloseJournalBottomSheetCommand}" Classes="btn-text" Content="Cancel" MinHeight="38" Padding="16,0"/>
              <Button Command="{Binding SaveJournalEntryCommand}" Classes="btn-primary" Content="Save Entry" Height="38" Padding="20,0"/>
            </StackPanel>
          </Border>
        </Grid>
      </Border>
    </Panel>

    <!-- ═══════════════════════════════════════════════════════════════
         CREATE NEW GOAL OVERLAY DIALOG (Shared Desktop/Mobile)
    ═══════════════════════════════════════════════════════════════ -->
    <Panel IsVisible="{Binding IsCreatingGoal}" ZIndex="2500" Background="#80000000">
      <Border MaxWidth="480"
              VerticalAlignment="Center"
              HorizontalAlignment="Center"
              Margin="16,24"
              MaxHeight="640"
              Background="{DynamicResource AppSurfaceBrush}"
              BorderBrush="{DynamicResource AppBorderBrush}"
              BorderThickness="1"
              CornerRadius="16"
              Padding="0"
              BoxShadow="0 10 25 0 #80000000">
        <Grid RowDefinitions="Auto,Auto,*,Auto">
          <!-- Sticky Header -->
          <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Margin="20,18,20,10">
            <TextBlock Grid.Column="0" Text="Create New Life Goal" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimaryBrush}" VerticalAlignment="Center"/>
            <Button Grid.Column="1"
                    Command="{Binding AutoFillGoalWithAiCommand}"
                    Classes="btn-secondary"
                    IsEnabled="{Binding !IsAiGeneratingGoal}"
                    Height="30" Padding="10,0"
                    VerticalAlignment="Center"
                    ToolTip.Tip="Type a keyword/title and auto-generate Category, Date, Vision &amp; Milestones">
              <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                <PathIcon Data="{StaticResource SparkleIconData}" Width="11" Height="11" Foreground="{DynamicResource AppPrimaryBrush}"/>
                <TextBlock Text="Auto-Fill with AI" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppPrimaryBrush}"/>
              </StackPanel>
            </Button>
            <Button Grid.Column="2"
                    Command="{Binding CancelCreateGoalCommand}"
                    Classes="icon-btn"
                    Padding="6"
                    Height="30" Width="30"
                    VerticalAlignment="Center">
              <PathIcon Data="{StaticResource CloseIconData}" Width="12" Height="12"/>
            </Button>
          </Grid>

          <!-- Loading Indicator -->
          <ProgressBar Grid.Row="1"
                       IsIndeterminate="True"
                       IsVisible="{Binding IsAiGeneratingGoal}"
                       Height="2"
                       CornerRadius="1"
                       Foreground="{DynamicResource AppPrimaryBrush}"
                       Margin="20,0,20,8"/>

          <!-- Scrollable Form Body -->
          <ScrollViewer Grid.Row="2"
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled"
                        Padding="20,4,20,12">
            <StackPanel Spacing="14">
              <StackPanel Spacing="6">
                <TextBlock Text="Goal Title *" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                <TextBox Text="{Binding NewGoalTitle}" Classes="styled" PlaceholderText="e.g. Run a marathon, Launch my app" Padding="12,8" MinHeight="40" MaxLength="100" CornerRadius="6" VerticalContentAlignment="Center"/>
              </StackPanel>

              <StackPanel Spacing="6">
                <TextBlock Text="Category" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                <TextBox Text="{Binding NewGoalCategory}" Classes="styled" PlaceholderText="e.g. Health, Career, Finance" Padding="12,8" MinHeight="40" MaxLength="24" CornerRadius="6" VerticalContentAlignment="Center"/>
              </StackPanel>

              <StackPanel Spacing="6">
                <TextBlock Text="Target Completion Date" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                <CalendarDatePicker SelectedDate="{Binding NewGoalTargetDate, Mode=TwoWay}" PlaceholderText="Pick target date (dd/mm/yyyy)" SelectedDateFormat="Custom" CustomDateFormatString="dd/MM/yyyy" HorizontalAlignment="Stretch" Padding="12,8" MinHeight="40" CornerRadius="6"/>
              </StackPanel>

              <StackPanel Spacing="6">
                <TextBlock Text="Vision &amp; Description" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                <TextBox Text="{Binding NewGoalDescription}" Classes="styled" PlaceholderText="Why this matters &amp; how you'll get there..." Padding="12,8" AcceptsReturn="True" TextWrapping="Wrap" MaxLength="500" MinHeight="80" CornerRadius="6" VerticalContentAlignment="Top" HorizontalContentAlignment="Left"/>
              </StackPanel>

              <!-- Preview & Management of AI-generated milestones -->
              <StackPanel Spacing="6" IsVisible="{Binding HasPendingAiMilestones}">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Grid.Column="0" Text="AI SUGGESTED STEPS (SAVED ON CREATION)" Classes="micro" Foreground="{DynamicResource AppPrimaryBrush}" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="1" Text="{Binding PendingAiMilestones.Count, StringFormat='{}{0} steps'}" FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}" VerticalAlignment="Center"/>
                </Grid>

                <ItemsControl ItemsSource="{Binding PendingAiMilestones}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Background="{DynamicResource AppSurfaceSubtleBrush}"
                              BorderBrush="{DynamicResource AppBorderBrush}"
                              BorderThickness="1"
                              CornerRadius="6"
                              Padding="10,6"
                              Margin="0,2">
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock Grid.Column="0"
                                     Text="{Binding}"
                                     FontSize="12"
                                     Foreground="{DynamicResource AppTextPrimaryBrush}"
                                     TextWrapping="Wrap"
                                     VerticalAlignment="Center"
                                     Margin="0,0,8,0"/>
                          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <Button Command="{Binding $parent[UserControl].((vm:GoalsViewModel)DataContext).MovePendingMilestoneUpCommand}"
                                    CommandParameter="{Binding}"
                                    Classes="icon-btn"
                                    MinHeight="24" MinWidth="24" Padding="3"
                                    ToolTip.Tip="Move step up">
                              <PathIcon Data="{StaticResource ChevronUpIconData}" Width="10" Height="10"/>
                            </Button>
                            <Button Command="{Binding $parent[UserControl].((vm:GoalsViewModel)DataContext).MovePendingMilestoneDownCommand}"
                                    CommandParameter="{Binding}"
                                    Classes="icon-btn"
                                    MinHeight="24" MinWidth="24" Padding="3"
                                    ToolTip.Tip="Move step down">
                              <PathIcon Data="{StaticResource ChevronDownIconData}" Width="10" Height="10"/>
                            </Button>
                            <Button Command="{Binding $parent[UserControl].((vm:GoalsViewModel)DataContext).DeletePendingMilestoneCommand}"
                                    CommandParameter="{Binding}"
                                    Classes="danger"
                                    MinHeight="24" MinWidth="24" Padding="3"
                                    ToolTip.Tip="Delete step">
                              <PathIcon Data="{StaticResource TrashIconData}" Width="10" Height="10"/>
                            </Button>
                          </StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Quick Add Custom Step into Dialog -->
                <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                  <TextBox Grid.Column="0"
                           Text="{Binding NewPendingMilestoneTitle}"
                           Classes="styled"
                           PlaceholderText="Add another step..."
                           Padding="10,6"
                           MinHeight="34"
                           MaxLength="100"
                           CornerRadius="6"
                           Margin="0,0,8,0"
                           VerticalContentAlignment="Center">
                    <TextBox.KeyBindings>
                      <KeyBinding Gesture="Enter" Command="{Binding AddPendingMilestoneCommand}"/>
                    </TextBox.KeyBindings>
                  </TextBox>
                  <Button Grid.Column="1"
                          Command="{Binding AddPendingMilestoneCommand}"
                          Classes="btn-secondary"
                          Height="34"
                          Padding="12,0"
                          VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                      <PathIcon Data="{StaticResource PlusIconData}" Width="10" Height="10" Foreground="{DynamicResource AppPrimaryBrush}"/>
                      <TextBlock Text="Add Step" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                  </Button>
                </Grid>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>

          <!-- Sticky Footer -->
          <Border Grid.Row="3"
                  BorderBrush="{DynamicResource AppBorderBrush}"
                  BorderThickness="0,1,0,0"
                  Padding="20,12"
                  Background="{DynamicResource AppSurfaceSubtleBrush}"
                  CornerRadius="0,0,16,16">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12">
              <Button Command="{Binding CancelCreateGoalCommand}" Classes="btn-text" Content="Cancel" MinHeight="38" Padding="16,0"/>
              <Button Command="{Binding SaveNewGoalCommand}" Classes="btn-primary" Content="Create Goal" Height="38" Padding="20,0"/>
            </StackPanel>
          </Border>
        </Grid>
      </Border>
    </Panel>

    <!-- ═══════════════════════════════════════════════════════════════
         MILESTONE AI ASSIST CHOICE MODAL (Smart Append vs Replace)
    ═══════════════════════════════════════════════════════════════ -->
    <Panel IsVisible="{Binding IsMilestoneAiChoiceModalOpen}" ZIndex="2600" Background="#80000000">
      <Border MaxWidth="440"
              VerticalAlignment="Center"
              HorizontalAlignment="Center"
              Margin="16"
              Background="{DynamicResource AppSurfaceBrush}"
              BorderBrush="{DynamicResource AppBorderBrush}"
              BorderThickness="1"
              CornerRadius="16"
              Padding="20"
              BoxShadow="0 10 25 0 #80000000">
        <StackPanel Spacing="16">
          <!-- Header -->
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0" Spacing="4">
              <TextBlock Text="AI Milestone Assistance" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimaryBrush}"/>
              <TextBlock Text="You already have existing milestones for this goal. How would you like AI to assist?"
                         FontSize="12"
                         Foreground="{DynamicResource AppTextSecondaryBrush}"
                         TextWrapping="Wrap"/>
            </StackPanel>
            <Button Grid.Column="1"
                    Command="{Binding CloseMilestoneAiChoiceModalCommand}"
                    Classes="icon-btn"
                    Padding="6"
                    Height="30" Width="30"
                    VerticalAlignment="Top">
              <PathIcon Data="{StaticResource CloseIconData}" Width="12" Height="12"/>
            </Button>
          </Grid>

          <!-- Options Buttons Stack -->
          <StackPanel Spacing="10">
            <!-- Option 1: Append Next Steps (Context Aware) -->
            <Button Command="{Binding AppendNextMilestonesWithAiCommand}"
                    Classes="ghost"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    Padding="14,12"
                    CornerRadius="10"
                    Background="{DynamicResource AppSurfaceSubtleBrush}"
                    BorderBrush="{DynamicResource AppBorderBrush}"
                    BorderThickness="1">
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <Border Grid.Column="0"
                        Background="{DynamicResource AppTagBackgroundBrush}"
                        CornerRadius="8"
                        Width="36" Height="36">
                  <PathIcon Data="{StaticResource PlusIconData}" Width="14" Height="14" Foreground="{DynamicResource AppPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                  <TextBlock Text="Generate Next Steps (Build Upon Current)" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                  <TextBlock Text="AI analyzes your current milestones and generates 2-4 next sequential steps without duplicating." FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}" TextWrapping="Wrap"/>
                </StackPanel>
              </Grid>
            </Button>

            <!-- Option 2: Regenerate All (Replace) -->
            <Button Command="{Binding ReplaceAllMilestonesWithAiCommand}"
                    Classes="ghost"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    Padding="14,12"
                    CornerRadius="10"
                    Background="{DynamicResource AppSurfaceSubtleBrush}"
                    BorderBrush="{DynamicResource AppBorderBrush}"
                    BorderThickness="1">
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <Border Grid.Column="0"
                        Background="{DynamicResource AppTagBackgroundBrush}"
                        CornerRadius="8"
                        Width="36" Height="36">
                  <PathIcon Data="{StaticResource UndoIconData}" Width="14" Height="14" Foreground="{DynamicResource AppPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                  <TextBlock Text="Regenerate Entire Roadmap (Replace All)" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                  <TextBlock Text="Clears current milestones and creates a fresh comprehensive roadmap from scratch." FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}" TextWrapping="Wrap"/>
                </StackPanel>
              </Grid>
            </Button>
          </StackPanel>

          <!-- Cancel Footer -->
          <Button Command="{Binding CloseMilestoneAiChoiceModalCommand}"
                  Classes="btn-text"
                  Content="Cancel"
                  HorizontalAlignment="Right"
                  Padding="16,6"
                  Height="34"/>
        </StackPanel>
      </Border>
    </Panel>

  </Panel>
</UserControl>
