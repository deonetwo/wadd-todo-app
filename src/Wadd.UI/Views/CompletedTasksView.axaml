<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Wadd.UI.ViewModels;assembly=Wadd.UI"
             xmlns:controls="clr-namespace:Wadd.UI.Controls;assembly=Wadd.UI"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="700"
             x:Class="Wadd.UI.Views.CompletedTasksView"
             x:DataType="vm:MainViewModel">

  <UserControl.Styles>
    <Style Selector="StackPanel.view-container">
      <Setter Property="Margin" Value="64,52,80,120"/>
    </Style>
    <Style Selector="StackPanel.view-container.compact">
      <Setter Property="Margin" Value="16,20,16,40"/>
    </Style>
  </UserControl.Styles>

  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Classes="view-container" Classes.compact="{Binding IsCompact}" Spacing="0">

      <!-- Page Header (Desktop) -->
      <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,16" IsVisible="{Binding !IsCompact}">
        <StackPanel Grid.Column="0" Spacing="4">
          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <PathIcon Data="{StaticResource CheckListIconData}" Width="18" Height="18" Foreground="{DynamicResource AppPrimaryBrush}"/>
            <TextBlock Text="Completed History" Classes="display"/>
          </StackPanel>
          <TextBlock Text="Archive of all completed tasks."
                     Classes="small"
                     Foreground="{DynamicResource AppTextSecondaryBrush}"/>
        </StackPanel>

        <!-- Toolbar & Count badge -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <!-- Date Range Filter Dropdown Button (Desktop) -->
          <Button Classes="outline"
                  Padding="10,6"
                  CornerRadius="8"
                  Background="{DynamicResource AppSurfaceBrush}"
                  BorderBrush="{DynamicResource AppBorderBrush}"
                  ToolTip.Tip="Filter tasks by Completed Date">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <PathIcon Data="{StaticResource CalendarIconData}" Width="13" Height="13" Foreground="{DynamicResource AppPrimaryBrush}" VerticalAlignment="Center"/>
              <TextBlock Text="{Binding CompletedDateFilterButtonText}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
              <PathIcon Data="{StaticResource ChevronDownIconData}" Width="10" Height="10" Foreground="{DynamicResource AppTextSecondaryBrush}" VerticalAlignment="Center" Margin="2,0,0,0"/>
            </StackPanel>
            <Button.Flyout>
              <Flyout Placement="BottomEdgeAlignedLeft">
                <StackPanel Spacing="6" Width="240">
                  <TextBlock Text="FILTER BY COMPLETED DATE" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="4,2,0,4"/>

                  <Button Classes="ghost" Command="{Binding SetCompletedDateFilterPresetCommand}" CommandParameter="All" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                    <TextBlock Text="All Time" FontSize="12"/>
                  </Button>
                  <Button Classes="ghost" Command="{Binding SetCompletedDateFilterPresetCommand}" CommandParameter="Today" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                    <TextBlock Text="Today" FontSize="12"/>
                  </Button>
                  <Button Classes="ghost" Command="{Binding SetCompletedDateFilterPresetCommand}" CommandParameter="Yesterday" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                    <TextBlock Text="Yesterday" FontSize="12"/>
                  </Button>
                  <Button Classes="ghost" Command="{Binding SetCompletedDateFilterPresetCommand}" CommandParameter="7Days" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                    <TextBlock Text="Last 7 Days" FontSize="12"/>
                  </Button>
                  <Button Classes="ghost" Command="{Binding SetCompletedDateFilterPresetCommand}" CommandParameter="30Days" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                    <TextBlock Text="Last 30 Days" FontSize="12"/>
                  </Button>
                  <Button Classes="ghost" Command="{Binding SetCompletedDateFilterPresetCommand}" CommandParameter="ThisMonth" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                    <TextBlock Text="This Month" FontSize="12"/>
                  </Button>

                  <Separator Classes="divider" Margin="0,4"/>

                  <TextBlock Text="CUSTOM RANGE" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="4,2,0,2"/>
                  <StackPanel Spacing="6">
                    <TextBlock Text="From:" FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                    <CalendarDatePicker SelectedDate="{Binding CompletedDateFilterStartDate, Mode=TwoWay}"
                                        DisplayDateEnd="{Binding CompletedDateFilterEndDate}"
                                        PlaceholderText="Start Date..."
                                        HorizontalAlignment="Stretch"/>
                    <TextBlock Text="To:" FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                    <CalendarDatePicker SelectedDate="{Binding CompletedDateFilterEndDate, Mode=TwoWay}"
                                        DisplayDateStart="{Binding CompletedDateFilterStartDate}"
                                        PlaceholderText="End Date..."
                                        HorizontalAlignment="Stretch"/>
                  </StackPanel>

                  <Separator Classes="divider" Margin="0,4"/>

                  <Button Classes="ghost"
                          Command="{Binding ClearCompletedDateFilterCommand}"
                          Foreground="{DynamicResource AppTextSecondaryBrush}"
                          HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Center">
                    <TextBlock Text="Reset Date Filter" FontSize="12" FontWeight="SemiBold"/>
                  </Button>
                </StackPanel>
              </Flyout>
            </Button.Flyout>
          </Button>

          <!-- Category Filter Dropdown Button (Desktop) -->
          <Button Classes="outline"
                  Padding="10,6"
                  CornerRadius="8"
                  Background="{DynamicResource AppSurfaceBrush}"
                  BorderBrush="{DynamicResource AppBorderBrush}"
                  ToolTip.Tip="Filter tasks by Tag">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <PathIcon Data="{StaticResource TagIconData}" Width="13" Height="13" Foreground="{DynamicResource AppPrimaryBrush}" VerticalAlignment="Center"/>
              <TextBlock Text="{Binding CategoryFilterButtonText}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
              <PathIcon Data="{StaticResource ChevronDownIconData}" Width="10" Height="10" Foreground="{DynamicResource AppTextSecondaryBrush}" VerticalAlignment="Center" Margin="2,0,0,0"/>
            </StackPanel>
            <Button.Flyout>
              <Flyout Placement="BottomEdgeAlignedLeft">
                <StackPanel Spacing="6" Width="200">
                  <TextBlock Text="FILTER BY TAG" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="4,2,0,4"/>
                  <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding CategoryFilterOptions}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <CheckBox Content="{Binding Name}"
                                    IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                    Margin="4,3"
                                    FontSize="12"
                                    FontWeight="Medium"/>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                  <Separator Classes="divider" Margin="0,4"/>
                  <Button Classes="ghost"
                          Command="{Binding OpenTagsViewCommand}"
                          CommandParameter="{Binding $parent[Button].Flyout}"
                          x:CompileBindings="False"
                          Foreground="{DynamicResource AppPrimaryBrush}"
                          FontWeight="SemiBold"
                          HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Left">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                      <PathIcon Data="{StaticResource SettingsIconData}" Width="12" Height="12"/>
                      <TextBlock Text="Manage Tags..." FontSize="12"/>
                    </StackPanel>
                  </Button>
                </StackPanel>
              </Flyout>
            </Button.Flyout>
          </Button>

          <!-- Count Badge -->
          <Border Background="{DynamicResource AppSurfaceElevatedBrush}"
                  CornerRadius="12"
                  Padding="12,6"
                  VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <TextBlock Text="{Binding CompletedHistoryTodoItems.Count}"
                         FontSize="14"
                         FontWeight="Bold"
                         Foreground="{DynamicResource AppPrimaryBrush}"/>
              <TextBlock Text="completed"
                         FontSize="12"
                         Foreground="{DynamicResource AppTextSecondaryBrush}"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>

      <!-- Page Header & Filter Bar (Mobile / Portrait Mode) -->
      <StackPanel IsVisible="{Binding IsCompact}" Margin="0,0,0,16" Spacing="12">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Grid.Column="0" Spacing="2">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <PathIcon Data="{StaticResource CheckListIconData}" Width="16" Height="16" Foreground="{DynamicResource AppPrimaryBrush}"/>
              <TextBlock Text="Completed History" Classes="heading" FontSize="20"/>
            </StackPanel>
            <TextBlock Text="Archive of completed tasks" Classes="small" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
          </StackPanel>

          <!-- Count Badge (Mobile Header) -->
          <Border Grid.Column="1"
                  Background="{DynamicResource AppSurfaceElevatedBrush}"
                  CornerRadius="12"
                  Padding="10,4"
                  VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
              <TextBlock Text="{Binding CompletedHistoryTodoItems.Count}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource AppPrimaryBrush}"/>
              <TextBlock Text="done" FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
            </StackPanel>
          </Border>
        </Grid>

        <!-- Mobile Filter Chips Bar -->
        <WrapPanel Orientation="Horizontal" Margin="0,2,0,0">
          <!-- Date Filter Chip (Mobile) -->
          <Button Classes="outline"
                  Command="{Binding OpenMobileCompletedDateFilterSheetCommand}"
                  Padding="10,6"
                  Margin="0,0,6,6"
                  CornerRadius="8"
                  Background="{DynamicResource AppSurfaceBrush}"
                  BorderBrush="{DynamicResource AppBorderBrush}">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <PathIcon Data="{StaticResource CalendarIconData}" Width="12" Height="12" Foreground="{DynamicResource AppPrimaryBrush}" VerticalAlignment="Center"/>
              <TextBlock Text="{Binding CompletedDateFilterButtonText}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
              <PathIcon Data="{StaticResource ChevronDownIconData}" Width="9" Height="9" Foreground="{DynamicResource AppTextSecondaryBrush}" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>

          <!-- Tag Filter Chip (Mobile) -->
          <Button Classes="outline"
                  Command="{Binding OpenMobileTagFilterSheetCommand}"
                  Padding="10,6"
                  Margin="0,0,6,6"
                  CornerRadius="8"
                  Background="{DynamicResource AppSurfaceBrush}"
                  BorderBrush="{DynamicResource AppBorderBrush}">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <PathIcon Data="{StaticResource TagIconData}" Width="12" Height="12" Foreground="{DynamicResource AppPrimaryBrush}" VerticalAlignment="Center"/>
              <TextBlock Text="{Binding CategoryFilterButtonText}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
              <PathIcon Data="{StaticResource ChevronDownIconData}" Width="9" Height="9" Foreground="{DynamicResource AppTextSecondaryBrush}" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>

          <!-- Clear Filters Button (Mobile) -->
          <Button Classes="ghost"
                  IsVisible="{Binding IsAnyCompletedFilterActive}"
                  Command="{Binding ClearAllCompletedFiltersCommand}"
                  Padding="8,6"
                  Margin="0,0,0,6"
                  ToolTip.Tip="Reset all filters">
            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
              <PathIcon Data="{StaticResource CloseIconData}" Width="10" Height="10" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
              <TextBlock Text="Clear" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
            </StackPanel>
          </Button>
        </WrapPanel>
      </StackPanel>

      <!-- Task History List -->
      <StackPanel IsVisible="{Binding HasCompletedHistoryTodoItems}">
        <ItemsControl ItemsSource="{Binding CompletedHistoryTodoItems}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:TodoItemViewModel">
              <Border Classes="task-row" Classes.completed="True">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                  <!-- Checkbox (allows restoring task by unchecking) -->
                  <CheckBox Grid.Column="0"
                            Classes="task-checkbox"
                            IsChecked="{Binding IsCompleted, Mode=OneWay}"
                            Command="{Binding $parent[UserControl].DataContext.ToggleTodoCommand}"
                            CommandParameter="{Binding}"
                            ToolTip.Tip="Uncheck to restore task"/>

                  <!-- Task metadata -->
                  <Button Grid.Column="1"
                          Classes="task-row-btn"
                          Command="{Binding $parent[UserControl].DataContext.OpenDetailDrawerCommand}"
                          CommandParameter="{Binding}"
                          Padding="0"
                          HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Left"
                          VerticalAlignment="Center"
                          Background="Transparent"
                          BorderThickness="0"
                          Cursor="Hand"
                          ToolTip.Tip="Click to open task details &amp; notes">
                    <StackPanel Spacing="3" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Title}"
                                 Classes="body-bold task-title"
                                 FontSize="14"
                                 TextWrapping="Wrap"/>
                      <!-- Note preview in list view: single-line preview with ellipsis -->
                      <Panel IsVisible="{Binding HasDescription}" IsHitTestVisible="False">
                        <controls:MarkdownTextBlock MarkdownText="{Binding DescriptionPreview}"
                                                     IsVisible="{Binding $parent[UserControl].DataContext.ShowNotePreviewsInList}"
                                                     FontSize="12"
                                                     Foreground="{DynamicResource AppTextSecondaryBrush}"
                                                     Opacity="0.85"
                                                     MaxLines="1"
                                                     TextTrimming="CharacterEllipsis"/>
                      </Panel>
                      
                      <!-- Badges (Due Date, Reminder & Repeat) -->
                      <WrapPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <!-- Due Date Badge -->
                        <Border IsVisible="{Binding HasDueDate}"
                                Background="{DynamicResource AppPrimarySubtleBrush}"
                                CornerRadius="4"
                                Padding="6,2"
                                Margin="0,0,4,3"
                                HorizontalAlignment="Left">
                          <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <PathIcon Data="{StaticResource CalendarIconData}" Width="10" Height="10" Foreground="{DynamicResource AppPrimaryBrush}"/>
                            <TextBlock Text="{Binding DueDateFormatted}" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource AppPrimaryBrush}"/>
                          </StackPanel>
                        </Border>

                        <!-- Reminder Badge -->
                        <Border IsVisible="{Binding HasReminder}"
                                Background="{DynamicResource AppPrimarySubtleBrush}"
                                CornerRadius="4"
                                Padding="6,2"
                                Margin="0,0,4,3"
                                HorizontalAlignment="Left">
                          <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <PathIcon Data="{StaticResource BellIconData}" Width="10" Height="10" Foreground="{DynamicResource AppPrimaryBrush}"/>
                            <TextBlock Text="{Binding ReminderAtFormatted}" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource AppPrimaryBrush}"/>
                          </StackPanel>
                        </Border>

                        <!-- Repeat Badge -->
                        <Border IsVisible="{Binding HasRecurrence}"
                                Background="{DynamicResource AppPrimarySubtleBrush}"
                                CornerRadius="4"
                                Padding="6,2"
                                Margin="0,0,4,3"
                                HorizontalAlignment="Left">
                          <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <PathIcon Data="{StaticResource RepeatIconData}" Width="10" Height="10" Foreground="{DynamicResource AppPrimaryBrush}"/>
                            <TextBlock Text="{Binding RecurrenceFormatted}" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource AppPrimaryBrush}"/>
                          </StackPanel>
                        </Border>
                      </WrapPanel>

                      <!-- Category Badges (Dedicated Row) -->
                      <ItemsControl ItemsSource="{Binding Categories}" IsVisible="{Binding HasCategories}" Margin="0,2,0,0">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Border Background="{DynamicResource AppPrimaryBrush}"
                                    CornerRadius="4"
                                    Padding="6,2"
                                    Margin="0,0,4,3"
                                    HorizontalAlignment="Left">
                              <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <PathIcon Data="{StaticResource TagIconData}" Width="10" Height="10" Foreground="#FFFFFF"/>
                                <TextBlock Text="{Binding}" FontSize="11" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                              </StackPanel>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>

                      <!-- Mobile Completed Timestamp Badge (Portrait mode) -->
                      <StackPanel Orientation="Horizontal"
                                  Spacing="4"
                                  Margin="0,3,0,0"
                                  IsVisible="{Binding $parent[UserControl].DataContext.IsCompact}">
                        <PathIcon Data="{StaticResource CheckListIconData}" Width="10" Height="10" Foreground="{DynamicResource AppTextSecondaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding CompletedAtFormatted}"
                                   FontSize="11"
                                   Foreground="{DynamicResource AppTextSecondaryBrush}"
                                   VerticalAlignment="Center"/>
                      </StackPanel>
                    </StackPanel>
                  </Button>

                  <!-- Completed Timestamp (Desktop mode) -->
                  <TextBlock Grid.Column="2"
                             Text="{Binding CompletedAtFormatted}"
                             IsVisible="{Binding !$parent[UserControl].DataContext.IsCompact}"
                             Classes="small"
                             VerticalAlignment="Center"
                             Margin="14,0,6,0"/>

                  <!-- Delete -->
                  <Button Grid.Column="3"
                          Classes="danger"
                          Command="{Binding $parent[UserControl].DataContext.DeleteTodoCommand}"
                          CommandParameter="{Binding}"
                          VerticalAlignment="Center"
                          ToolTip.Tip="Delete permanently">
                    <PathIcon Data="{StaticResource CloseIconData}" Width="12" Height="12"/>
                  </Button>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <!-- Empty state -->
      <StackPanel IsVisible="{Binding !CompletedHistoryTodoItems.Count}"
                  HorizontalAlignment="Center"
                  Margin="0,48,0,0"
                  Spacing="14">
        <PathIcon Data="{StaticResource CheckListIconData}"
                  Width="44" Height="44"
                  Foreground="{DynamicResource AppBorderBrush}"
                  HorizontalAlignment="Center"/>
        <TextBlock Text="No completed tasks found"
                   Classes="heading"
                   HorizontalAlignment="Center"
                   Foreground="{DynamicResource AppTextSecondaryBrush}"/>
        <TextBlock Text="Try selecting a different date range or tag filter."
                   IsVisible="{Binding IsAnyCompletedFilterActive}"
                   Classes="small"
                   HorizontalAlignment="Center"
                   Foreground="{DynamicResource AppTextSecondaryBrush}"/>
        <TextBlock Text="Tasks completed on previous days will appear here automatically."
                   IsVisible="{Binding !IsAnyCompletedFilterActive}"
                   Classes="small"
                   HorizontalAlignment="Center"
                   Foreground="{DynamicResource AppTextSecondaryBrush}"/>

        <Button Classes="outline"
                IsVisible="{Binding IsAnyCompletedFilterActive}"
                Command="{Binding ClearAllCompletedFiltersCommand}"
                HorizontalAlignment="Center"
                Margin="0,4,0,0"
                Padding="12,6">
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <PathIcon Data="{StaticResource CloseIconData}" Width="11" Height="11"/>
            <TextBlock Text="Clear All Filters" FontSize="12" FontWeight="SemiBold"/>
          </StackPanel>
        </Button>
      </StackPanel>

    </StackPanel>
  </ScrollViewer>
</UserControl>
