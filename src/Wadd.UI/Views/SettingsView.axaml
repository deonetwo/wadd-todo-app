<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Wadd.UI.ViewModels;assembly=Wadd.UI"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="700"
             x:Class="Wadd.UI.Views.SettingsView"
             x:DataType="vm:MainViewModel">

  <UserControl.Styles>
    <Style Selector="StackPanel.view-container">
      <Setter Property="Margin" Value="64,48,80,180"/>
    </Style>
    <Style Selector="StackPanel.view-container.compact">
      <Setter Property="Margin" Value="16,20,16,40"/>
    </Style>
  </UserControl.Styles>

  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Classes="view-container" Classes.compact="{Binding IsCompact}" Spacing="24" HorizontalAlignment="Stretch">

      <!-- Header -->
      <StackPanel Spacing="4">
        <TextBlock Text="Settings &amp; About" Classes="display"/>
        <TextBlock Text="Manage theme preferences, cloud synchronization, data export, and application information."
                   Classes="small"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource AppTextSecondaryBrush}"/>
      </StackPanel>

      <!-- 1. Appearance / Theme -->
      <Border Classes="content-block">
        <StackPanel Spacing="16">
          <TextBlock Text="APPEARANCE" Classes="micro"/>
          <StackPanel Spacing="4">
            <TextBlock Text="Interface Theme" Classes="heading"/>
            <TextBlock Text="Choose your preferred color theme or match your system default."
                       Classes="small"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource AppTextSecondaryBrush}"/>
          </StackPanel>

          <WrapPanel Orientation="Horizontal" Margin="0,4,0,0">
            <Button Classes="outline"
                    Command="{Binding SetThemeModeCommand}"
                    CommandParameter="System"
                    Margin="0,0,8,8">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Data="{StaticResource MonitorIconData}" Width="14" Height="14"/>
                <TextBlock Text="System"/>
              </StackPanel>
            </Button>

            <Button Classes="outline"
                    Command="{Binding SetThemeModeCommand}"
                    CommandParameter="Light"
                    Margin="0,0,8,8">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Data="{StaticResource SunIconData}" Width="14" Height="14"/>
                <TextBlock Text="Light"/>
              </StackPanel>
            </Button>

            <Button Classes="outline"
                    Command="{Binding SetThemeModeCommand}"
                    CommandParameter="Dark"
                    Margin="0,0,8,8">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Data="{StaticResource MoonIconData}" Width="14" Height="14"/>
                <TextBlock Text="Dark"/>
              </StackPanel>
            </Button>
          </WrapPanel>

          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Text="Active mode:" Classes="small"/>
            <TextBlock Text="{Binding CurrentThemeLabel}" Classes="small"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource AppPrimaryBrush}"/>
          </StackPanel>

          <Separator Classes="divider" Margin="0,4"/>

          <!-- Task Note Previews Preference -->
          <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
            <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,16,0">
              <TextBlock Text="Show Note Previews" Classes="heading"/>
              <TextBlock Text="Display note previews under task titles."
                         Classes="small"
                         TextWrapping="Wrap"
                         Foreground="{DynamicResource AppTextSecondaryBrush}"/>
            </StackPanel>
            <ToggleSwitch Grid.Column="1"
                          IsChecked="{Binding ShowNotePreviewsInList, Mode=TwoWay}"
                          OnContent=""
                          OffContent=""
                          VerticalAlignment="Center"/>
          </Grid>

          <Separator Classes="divider" Margin="0,4"/>

          <!-- My Tasks View Layout Mode Setting (Adaptive Desktop Dropdown + Mobile Bottom Sheet) -->
          <StackPanel Spacing="10" Margin="0,4,0,0">
            <StackPanel Spacing="4">
              <TextBlock Text="My Tasks Layout Mode" Classes="heading"/>
              <TextBlock Text="Choose which sections appear and how they are arranged on My Tasks."
                         Classes="small"
                         TextWrapping="Wrap"
                         Foreground="{DynamicResource AppTextSecondaryBrush}"/>
            </StackPanel>

            <!-- 1. PC / Desktop View: ComboBox Dropdown (IsVisible="{Binding !IsCompact}") -->
            <ComboBox IsVisible="{Binding !IsCompact}"
                      ItemsSource="{Binding TasksLayoutOptions}"
                      SelectedItem="{Binding SelectedTasksLayoutOption, Mode=TwoWay}"
                      HorizontalAlignment="Left"
                      MinWidth="320"
                      MaxWidth="440"
                      Margin="0,2,0,0">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:TasksLayoutOption">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="0,2">
                    <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                      <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>

            <!-- 2. Mobile / Portrait View: Bottom Sheet Action Card (IsVisible="{Binding IsCompact}") -->
            <Button IsVisible="{Binding IsCompact}"
                    Classes="ghost"
                    Command="{Binding OpenTasksLayoutPickerCommand}"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    Padding="14,12"
                    CornerRadius="10"
                    Background="{DynamicResource AppSurfaceSubtleBrush}"
                    BorderBrush="{DynamicResource AppBorderBrush}"
                    BorderThickness="1">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                  <TextBlock Text="{Binding SelectedTasksLayoutOption.Name, FallbackValue='Standard (Today → Completed → Upcoming)'}"
                             FontSize="13"
                             FontWeight="SemiBold"
                             Foreground="{DynamicResource AppTextPrimaryBrush}"
                             TextTrimming="CharacterEllipsis"/>
                  <TextBlock Text="{Binding SelectedTasksLayoutOption.Description, FallbackValue='Shows Today, Completed Today, and Upcoming tasks'}"
                             FontSize="11"
                             Foreground="{DynamicResource AppTextSecondaryBrush}"
                             TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <PathIcon Grid.Column="1"
                          Data="{StaticResource ChevronRightIconData}"
                          Width="14" Height="14"
                          Foreground="{DynamicResource AppTextSecondaryBrush}"
                          VerticalAlignment="Center"/>
              </Grid>
            </Button>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- 2. Private Google Drive Cloud Sync -->
      <Border Classes="content-block">
        <StackPanel Spacing="16">
          <TextBlock Text="CLOUD SYNCHRONIZATION" Classes="micro"/>
          <StackPanel Spacing="4">
            <TextBlock Text="Private Google Drive Backup" Classes="heading"/>
            <TextBlock Text="Synchronize your tasks securely to your private Google Drive storage across Windows &amp; Android."
                       Classes="small"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource AppTextSecondaryBrush}"/>
          </StackPanel>

          <!-- Signed Out State -->
          <StackPanel IsVisible="{Binding !IsGoogleSignedIn}" Spacing="14">
            <Button Classes="primary"
                    Command="{Binding SignInWithGoogleCommand}"
                    HorizontalAlignment="Left"
                    ToolTip.Tip="Sign in with your Google Account">
              <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                <Border Width="20" Height="20" CornerRadius="10" Background="#F0FDFA" VerticalAlignment="Center">
                  <TextBlock Text="G" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AppPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="Connect Google Drive Account" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap"/>
              </StackPanel>
            </Button>
            <Grid ColumnDefinitions="Auto,*" Margin="0,2,0,0">
              <TextBlock Grid.Column="0" Text="🔒" FontSize="12" VerticalAlignment="Top" Margin="0,1,6,0"/>
              <TextBlock Grid.Column="1" Text="Your tasks are safely backed up to your personal Google Drive." Classes="small" TextWrapping="Wrap" VerticalAlignment="Center"/>
            </Grid>
          </StackPanel>

          <!-- Signed In State -->
          <StackPanel IsVisible="{Binding IsGoogleSignedIn}" Spacing="16">
            <Border Background="{DynamicResource AppSurfaceElevatedBrush}"
                    BorderBrush="{DynamicResource AppBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14,12">
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18" Background="{DynamicResource AppPrimaryBrush}" VerticalAlignment="Center">
                  <TextBlock Text="G" FontSize="18" FontWeight="Bold" Foreground="#F0FDFA" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                  <TextBlock Text="{Binding GoogleUserEmail}"
                             FontWeight="SemiBold"
                             FontSize="14"
                             Foreground="{DynamicResource AppTextPrimaryBrush}"
                             TextTrimming="CharacterEllipsis"
                             VerticalAlignment="Center"/>
                  <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding GoogleUserName}"
                               Classes="small"
                               Foreground="{DynamicResource AppTextSecondaryBrush}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>
                    <Border Background="{DynamicResource AppAccentTintBrush}"
                            CornerRadius="4"
                            Padding="6,2"
                            VerticalAlignment="Center">
                      <TextBlock Text="Connected" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AppPrimaryBrush}"/>
                    </Border>
                  </WrapPanel>
                </StackPanel>

                <Button Grid.Column="2"
                        Classes="outline"
                        Command="{Binding SignOutGoogleCommand}"
                        VerticalAlignment="Center">
                  <TextBlock Text="Sign Out" FontSize="12"/>
                </Button>
              </Grid>
            </Border>

            <Button Classes="primary" Command="{Binding SyncCommand}" IsEnabled="{Binding !IsSyncing}" HorizontalAlignment="Left">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Data="{StaticResource SyncIconData}" Width="13" Height="13"/>
                <TextBlock Text="Sync Now with Google Drive"/>
              </StackPanel>
            </Button>
          </StackPanel>

        </StackPanel>
      </Border>

      <!-- 3. Export Data -->
      <Border Classes="content-block">
        <StackPanel Spacing="14">
          <TextBlock Text="DATA MANAGEMENT" Classes="micro"/>
          <StackPanel Spacing="4">
            <TextBlock Text="Export To Excel" Classes="heading"/>
            <TextBlock Text="Export all your tasks, due dates, and priorities to an Excel (.xlsx) file."
                       Classes="small"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource AppTextSecondaryBrush}"/>
          </StackPanel>

          <Button Classes="outline" Command="{Binding ExportToExcelCommand}" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <PathIcon Data="{StaticResource ExportIconData}" Width="14" Height="14"/>
              <TextBlock Text="Export Tasks to Excel"/>
            </StackPanel>
          </Button>
        </StackPanel>
      </Border>

      <!-- 4. About & Version Info -->
      <Border Classes="content-block">
        <StackPanel Spacing="14">
          <TextBlock Text="ABOUT APPLICATION" Classes="micro"/>
          <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" Margin="0,4,0,0">
            <!-- App Logo & Name -->
            <Image Grid.Row="0" Grid.Column="0" Source="avares://Wadd.UI/Assets/logo.png"
                   Width="40" Height="40" Margin="0,0,16,12" VerticalAlignment="Center"/>
            <StackPanel Grid.Row="0" Grid.Column="1" VerticalAlignment="Center">
              <TextBlock Text="Wadd ToDo" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimaryBrush}"/>
              <TextBlock Text="Version 1.1.0 (.NET 10 + Avalonia UI 12)" Classes="small" TextWrapping="Wrap" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
            </StackPanel>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Developer:" Classes="small" FontWeight="SemiBold" Margin="0,0,16,6"/>
            <TextBlock Grid.Row="1" Grid.Column="1" Text="Dewanto (Wadd Software Engineering)" Classes="small" TextWrapping="Wrap" Margin="0,0,0,6"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Platforms:" Classes="small" FontWeight="SemiBold" Margin="0,0,16,6"/>
            <TextBlock Grid.Row="2" Grid.Column="1" Text="Windows (x64/Arm64) &amp; Android (min API 21+)" Classes="small" TextWrapping="Wrap" Margin="0,0,0,6"/>

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Copyright:" Classes="small" FontWeight="SemiBold" Margin="0,0,16,0"/>
            <TextBlock Grid.Row="3" Grid.Column="1" Text="© 2026 Wadd Application. All rights reserved." Classes="small" TextWrapping="Wrap"/>
          </Grid>
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>
