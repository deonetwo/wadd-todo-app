<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Wadd.UI.ViewModels;assembly=Wadd.UI"
             xmlns:models="clr-namespace:Wadd.Core.Models;assembly=Wadd.Core"
             xmlns:views="clr-namespace:Wadd.UI.Views;assembly=Wadd.UI"
             xmlns:controls="clr-namespace:Wadd.UI.Controls;assembly=Wadd.UI"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="760"
             x:Class="Wadd.UI.Views.MainView"
             x:DataType="vm:MainViewModel"
             Background="{DynamicResource AppBackgroundBrush}">

  <Design.DataContext>
    <vm:MainViewModel />
  </Design.DataContext>

  <UserControl.KeyBindings>
    <KeyBinding Gesture="Ctrl+B" Command="{Binding ToggleNavExpandedCommand}"/>
  </UserControl.KeyBindings>



  <!-- Root panel: shows either wide or compact layout -->
  <Panel>

    <!-- ══════════════════════════════════════════════════════
         WIDE / DESKTOP LAYOUT — nav rail + overlay drawer content
    ══════════════════════════════════════════════════════ -->
    <Panel IsVisible="{Binding !IsCompact}">

      <!-- ──────────────────────────────────────────────────
           EXPANDABLE LEFT SIDEBAR / NAVIGATION DRAWER (Overlay)
      ────────────────────────────────────────────────── -->
      <Border Width="{Binding SidebarWidth}"
              HorizontalAlignment="Left"
              VerticalAlignment="Stretch"
              ZIndex="100"
              ClipToBounds="True"
              Background="{DynamicResource AppSurfaceBrush}"
              BorderBrush="{DynamicResource AppBorderBrush}"
              BorderThickness="0,0,1,0"
              BoxShadow="4 0 20 0 #50000000">
        <Border.Transitions>
          <Transitions>
            <DoubleTransition Property="Width" Duration="0:0:0.26" Easing="0.1,0.9,0.2,1.0"/>
          </Transitions>
        </Border.Transitions>

        <Grid Width="240" HorizontalAlignment="Left" RowDefinitions="Auto,*,Auto">

          <!-- ─── HEADER (240px wide) ─── -->
          <Grid Grid.Row="0" ColumnDefinitions="64,*,Auto" Height="64">
            <!-- Wadd Logo Button in left 64px column: toggles expansion when clicked -->
            <Button Grid.Column="0"
                    Classes="icon-btn"
                    Command="{Binding ToggleNavExpandedCommand}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    ToolTip.Tip="Wadd ToDo · Toggle navigation (Ctrl+B)">
              <Image Source="avares://Wadd.UI/Assets/logo.png"
                     Width="28" Height="28"
                     RenderOptions.BitmapInterpolationMode="HighQuality"/>
            </Button>

            <!-- App Title in middle column -->
            <TextBlock Grid.Column="1"
                       Text="Wadd"
                       FontSize="18"
                       FontWeight="Bold"
                       Foreground="{DynamicResource AppTextPrimaryBrush}"
                       VerticalAlignment="Center"/>

            <!-- Collapse Toggle Button on the right -->
            <Button Grid.Column="2"
                    Classes="icon-btn"
                    Command="{Binding ToggleNavExpandedCommand}"
                    Margin="0,0,8,0"
                    VerticalAlignment="Center"
                    ToolTip.Tip="Collapse navigation (Ctrl+B)">
              <PathIcon Data="{StaticResource MenuIconData}" Width="16" Height="16"/>
            </Button>
          </Grid>

          <!-- ─── NAVIGATION ITEMS (Single Unified ListBox) ─── -->
          <ListBox Grid.Row="1"
                   Background="Transparent"
                   BorderThickness="0"
                   SelectedIndex="{Binding SelectedNavIndex}"
                   Padding="4,4">

            <!-- Index 0: Tasks -->
            <ListBoxItem Classes="nav-unified-item" ToolTip.Tip="Tasks">
              <Grid ColumnDefinitions="56,*,Auto" Height="44">
                <PathIcon Grid.Column="0" Data="{StaticResource CheckListIconData}" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="Tasks" FontSize="14" VerticalAlignment="Center"/>
                <Border Grid.Column="2"
                        Background="{DynamicResource AppSurfaceElevatedBrush}"
                        CornerRadius="10"
                        Padding="7,2"
                        Margin="0,0,10,0"
                        VerticalAlignment="Center">
                  <TextBlock Text="{Binding TodoItems.Count}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                </Border>
              </Grid>
            </ListBoxItem>

            <!-- Index 1: Completed Tasks -->
            <ListBoxItem Classes="nav-unified-item" ToolTip.Tip="Completed Tasks">
              <Grid ColumnDefinitions="56,*,Auto" Height="44">
                <PathIcon Grid.Column="0" Data="{StaticResource CheckIconData}" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="Completed" FontSize="14" VerticalAlignment="Center"/>
                <Border Grid.Column="2"
                        Background="{DynamicResource AppSurfaceElevatedBrush}"
                        CornerRadius="10"
                        Padding="7,2"
                        Margin="0,0,10,0"
                        VerticalAlignment="Center">
                  <TextBlock Text="{Binding CompletedHistoryTodoItems.Count}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                </Border>
              </Grid>
            </ListBoxItem>

            <!-- Index 2: Repeating Tasks -->
            <ListBoxItem Classes="nav-unified-item" ToolTip.Tip="Repeating Tasks">
              <Grid ColumnDefinitions="56,*,Auto" Height="44">
                <PathIcon Grid.Column="0" Data="{StaticResource RepeatIconData}" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="Repeating" FontSize="14" VerticalAlignment="Center"/>
                <Border Grid.Column="2"
                        Background="{DynamicResource AppSurfaceElevatedBrush}"
                        CornerRadius="10"
                        Padding="7,2"
                        Margin="0,0,10,0"
                        VerticalAlignment="Center">
                  <TextBlock Text="{Binding AllRecurringTodoItems.Count}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                </Border>
              </Grid>
            </ListBoxItem>

            <!-- Index 3: Calendar -->
            <ListBoxItem Classes="nav-unified-item" ToolTip.Tip="Calendar">
              <Grid ColumnDefinitions="56,*" Height="44">
                <PathIcon Grid.Column="0" Data="{StaticResource CalendarIconData}" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="Calendar" FontSize="14" VerticalAlignment="Center"/>
              </Grid>
            </ListBoxItem>

            <!-- Index 4: Search -->
            <ListBoxItem Classes="nav-unified-item" ToolTip.Tip="Search">
              <Grid ColumnDefinitions="56,*" Height="44">
                <PathIcon Grid.Column="0" Data="{StaticResource SearchIconData}" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="Search" FontSize="14" VerticalAlignment="Center"/>
              </Grid>
            </ListBoxItem>

            <!-- Index 5: Tags Management -->
            <ListBoxItem Classes="nav-unified-item" ToolTip.Tip="Tags Management">
              <Grid ColumnDefinitions="56,*" Height="44">
                <PathIcon Grid.Column="0" Data="{StaticResource TagIconData}" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="Tags" FontSize="14" VerticalAlignment="Center"/>
              </Grid>
            </ListBoxItem>

            <!-- Index 6: Settings -->
            <ListBoxItem Classes="nav-unified-item" ToolTip.Tip="Settings">
              <Grid ColumnDefinitions="56,*" Height="44">
                <PathIcon Grid.Column="0" Data="{StaticResource SettingsIconData}" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="Settings" FontSize="14" VerticalAlignment="Center"/>
              </Grid>
            </ListBoxItem>
          </ListBox>

          <!-- Bottom Footer: Collapsed (Width=64 to stay visible in collapsed rail) -->
          <StackPanel Grid.Row="2"
                      IsVisible="{Binding !IsNavExpanded}"
                      Width="64"
                      HorizontalAlignment="Left"
                      Spacing="8"
                      Margin="0,0,0,18">
            <Button Classes="icon-btn"
                    Command="{Binding ToggleThemeCommand}"
                    HorizontalAlignment="Center">
              <Panel>
                <PathIcon Data="{StaticResource MoonIconData}" Width="16" Height="16" IsVisible="{Binding !IsDarkMode}" ToolTip.Tip="Switch to Dark Mode"/>
                <PathIcon Data="{StaticResource SunIconData}" Width="16" Height="16" IsVisible="{Binding IsDarkMode}" ToolTip.Tip="Switch to Light Mode"/>
              </Panel>
            </Button>
            <Button Classes="icon-btn"
                    Command="{Binding SyncCommand}"
                    IsEnabled="{Binding !IsSyncing}"
                    HorizontalAlignment="Center"
                    ToolTip.Tip="Sync Cloud">
              <PathIcon Data="{StaticResource SyncIconData}" Width="16" Height="16"/>
            </Button>
            <!-- Status indicator dot -->
            <Ellipse Width="6" Height="6"
                     HorizontalAlignment="Center"
                     Fill="{DynamicResource AppAccentSuccessBrush}"
                     IsVisible="{Binding !IsSyncing}"
                     ToolTip.Tip="{Binding StorageStatusText}"/>
            <Ellipse Width="6" Height="6"
                     HorizontalAlignment="Center"
                     Fill="{DynamicResource AppPrimaryBrush}"
                     IsVisible="{Binding IsSyncing}"
                     ToolTip.Tip="Syncing…"/>
          </StackPanel>

          <Border Grid.Row="2"
                  IsVisible="{Binding IsNavExpanded}"
                  Margin="10,0,10,16"
                  Padding="12,10"
                  Background="{DynamicResource AppSurfaceElevatedBrush}"
                  BorderBrush="{DynamicResource AppBorderBrush}"
                  BorderThickness="1"
                  CornerRadius="10">
            <StackPanel Spacing="10">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                  <TextBlock Text="STORAGE &amp; SYNC" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource AppPrimaryBrush}"/>
                  <TextBlock Text="Saved on Device" IsVisible="{Binding !IsGoogleSignedIn}" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                  <TextBlock Text="{Binding GoogleUserEmail}" IsVisible="{Binding IsGoogleSignedIn}" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource AppTextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Text="{Binding LastUpdatedFormatted}" FontSize="10" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                </StackPanel>
                <Button Grid.Column="1"
                        Classes="icon-btn"
                        Command="{Binding ToggleThemeCommand}"
                        VerticalAlignment="Center">
                  <Panel>
                    <PathIcon Data="{StaticResource MoonIconData}" Width="14" Height="14" IsVisible="{Binding !IsDarkMode}" ToolTip.Tip="Switch to Dark Mode"/>
                    <PathIcon Data="{StaticResource SunIconData}" Width="14" Height="14" IsVisible="{Binding IsDarkMode}" ToolTip.Tip="Switch to Light Mode"/>
                  </Panel>
                </Button>
              </Grid>
              <Button Classes="outline"
                      Command="{Binding SyncCommand}"
                      IsEnabled="{Binding !IsSyncing}"
                      HorizontalAlignment="Stretch">
                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                  <PathIcon Data="{StaticResource SyncIconData}" Width="13" Height="13"/>
                  <TextBlock Text="Sync Cloud" IsVisible="{Binding !IsSyncing}" FontSize="12" FontWeight="SemiBold"/>
                  <TextBlock Text="Syncing..." IsVisible="{Binding IsSyncing}" FontSize="12" FontWeight="SemiBold"/>
                </StackPanel>
              </Button>
            </StackPanel>
          </Border>

        </Grid>
      </Border>

      <!-- ──────────────────────────────────────────────────
           MAIN CONTENT AREA
      ────────────────────────────────────────────────── -->
      <Panel Margin="64,0,0,0">

        <!-- ─── Sidebar scrim: fades over content when drawer is expanded ─── -->
        <Border ZIndex="50"
                Background="#55000000"
                IsHitTestVisible="{Binding IsNavExpanded}"
                Opacity="{Binding ScrimOpacity}"
                PointerPressed="OnScrimPressed">
          <Border.Transitions>
            <Transitions>
              <DoubleTransition Property="Opacity" Duration="0:0:0.26" Easing="0.1,0.9,0.2,1.0"/>
            </Transitions>
          </Border.Transitions>
        </Border>

        <!-- ─── Sync progress bar (top edge, 2px line) ─── -->
        <ProgressBar IsIndeterminate="True"
                     IsVisible="{Binding IsSyncing}"
                     Height="2"
                     VerticalAlignment="Top"
                     HorizontalAlignment="Stretch"
                     Foreground="{DynamicResource AppPrimaryBrush}"
                     Background="Transparent"/>

        <!-- ═══ TAB 0: TASKS VIEW ═══ -->
        <views:TasksView IsVisible="{Binding IsTasksView}"/>

        <!-- ═══ TAB 1: SEARCH VIEW ═══ -->
        <views:SearchView IsVisible="{Binding IsSearchView}"/>

        <!-- ═══ TAB 2: COMPLETED TASKS VIEW ═══ -->
        <views:CompletedTasksView IsVisible="{Binding IsCompletedView}"/>

        <!-- ═══ TAB 3: RECURRING TASKS VIEW ═══ -->
        <views:RecurringTasksView IsVisible="{Binding IsRecurringView}"/>

        <!-- ═══ TAB 4: CALENDAR VIEW ═══ -->
        <views:CalendarView IsVisible="{Binding IsCalendarView}"/>

        <!-- ═══ TAB 5: TAGS MANAGEMENT VIEW ═══ -->
        <views:TagsManagementView IsVisible="{Binding IsTagsView}"/>

        <!-- ═══ TAB 6: SETTINGS VIEW ═══ -->
        <views:SettingsView IsVisible="{Binding IsSettingsView}"/>

        <!-- ═══ TASK DETAIL DRAWER OVERLAY (Desktop) ═══ -->
        <Grid IsVisible="{Binding IsDetailDrawerOpen}" ZIndex="800">
          <Border Background="#50000000"/>
          <views:TaskDetailDrawer Width="420"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Stretch"/>
        </Grid>

        <!-- ═══ SMALL POST-SYNC PROMPT DIALOG ═══ -->
        <Border IsVisible="{Binding IsReviewPromptVisible}"
                Background="#A0000000"
                ZIndex="1000">
          <Border Background="{DynamicResource AppSurfaceBrush}"
                  BorderBrush="{DynamicResource AppBorderBrush}"
                  BorderThickness="1"
                  CornerRadius="16"
                  Padding="28,24"
                  MaxWidth="440"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center">
            <StackPanel Spacing="16">
              <StackPanel Spacing="4">
                <TextBlock Text="Task Updates Available" FontSize="18" FontWeight="Bold"/>
                <TextBlock Text="Some of your tasks were updated on another device." FontSize="13" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                <TextBlock Text="{Binding UnresolvedConflictCount, StringFormat='We found {0} items that need your review.'}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Margin="0,4,0,0"/>
              </StackPanel>

              <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button Classes="outline" Command="{Binding ReviewLaterCommand}" Padding="16,8">
                  <TextBlock Text="Review Later" FontSize="12"/>
                </Button>
                <Button Classes="primary" Command="{Binding ReviewNowCommand}" Padding="18,8">
                  <TextBlock Text="Review Now" FontSize="12" FontWeight="Bold"/>
                </Button>
              </StackPanel>
            </StackPanel>
          </Border>
        </Border>

        <!-- ═══ MOBILE / ANDROID TASK REVIEW WIZARD OVERLAY ═══ -->
        <Border IsVisible="{Binding IsTaskWizardVisible}"
                Background="#B0000000"
                ZIndex="999">
          <Border Background="{DynamicResource AppSurfaceBrush}"
                  CornerRadius="16"
                  Margin="16"
                  Padding="0"
                  ClipToBounds="True">
            <views:TaskConflictView DataContext="{Binding TaskConflictVm}"/>
          </Border>
        </Border>

        <!-- Floating Historical Status Toast Stack (Desktop) -->
        <ItemsControl ItemsSource="{Binding StatusNotifications}"
                      VerticalAlignment="Bottom"
                      HorizontalAlignment="Right"
                      Margin="0,0,32,24">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:NotificationBubbleItem">
              <Border Margin="0,4,0,4"
                      Padding="14,8"
                      Background="{DynamicResource AppSurfaceElevatedBrush}"
                      BorderBrush="{DynamicResource AppBorderBrush}"
                      BorderThickness="1"
                      CornerRadius="18"
                      Opacity="{Binding Opacity}"
                      HorizontalAlignment="Right">
                <Border.Transitions>
                  <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.4"/>
                  </Transitions>
                </Border.Transitions>
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                  <Ellipse Width="7" Height="7" Fill="{DynamicResource AppPrimaryBrush}" VerticalAlignment="Center"/>
                  <TextBlock Text="{Binding Message}"
                             FontSize="12"
                             FontWeight="Medium"
                             Foreground="{DynamicResource AppTextPrimaryBrush}"
                             VerticalAlignment="Center"/>
                  <TextBlock Text="{Binding Timestamp}"
                             FontSize="10"
                             Foreground="{DynamicResource AppTextSecondaryBrush}"
                             VerticalAlignment="Center"
                             Margin="4,0,0,0"/>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

      </Panel>
    </Panel>

    <!-- ══════════════════════════════════════════════════════
         COMPACT / MOBILE LAYOUT — full height + bottom tab bar
    ══════════════════════════════════════════════════════ -->
    <Grid IsVisible="{Binding IsCompact}" RowDefinitions="*,Auto">

      <!-- Compact content views -->
      <Panel Grid.Row="0">

        <!-- Compact Tasks View -->
        <views:TasksView IsVisible="{Binding IsTasksView}"/>

        <!-- Compact Search View -->
        <views:SearchView IsVisible="{Binding IsSearchView}"/>

        <!-- Compact Completed View -->
        <views:CompletedTasksView IsVisible="{Binding IsCompletedView}"/>

        <!-- Compact Recurring View -->
        <views:RecurringTasksView IsVisible="{Binding IsRecurringView}"/>

        <!-- Compact Calendar View -->
        <views:CalendarView IsVisible="{Binding IsCalendarView}"/>

        <!-- Compact Tags Management View -->
        <views:TagsManagementView IsVisible="{Binding IsTagsView}"/>

        <!-- Compact Settings View -->
        <views:SettingsView IsVisible="{Binding IsSettingsView}"/>

        <!-- ═══ TASK DETAIL DRAWER OVERLAY (Compact Bottom Sheet - Bottom-Docked) ═══ -->
        <Border IsVisible="{Binding IsDetailDrawerOpen}" ZIndex="900" Background="#90000000">
          <Grid RowDefinitions="*,Auto">
            <!-- Dismiss backdrop overlay -->
            <Border Grid.Row="0" Background="Transparent" PointerPressed="OnMobileDetailDrawerBackgroundPressed"/>

            <!-- Bottom Sheet Container (Sticks flush to bottom edge) -->
            <Border Grid.Row="1"
                    Background="{DynamicResource AppSurfaceBrush}"
                    BorderBrush="{DynamicResource AppBorderBrush}"
                    BorderThickness="0,1,0,0"
                    CornerRadius="20,20,0,0"
                    MaxHeight="620"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Bottom"
                    ClipToBounds="True">
              <views:TaskDetailDrawer HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
            </Border>
          </Grid>
        </Border>

        <!-- Floating Historical Status Toast Stack (Compact) -->
        <ItemsControl ItemsSource="{Binding StatusNotifications}"
                      VerticalAlignment="Bottom"
                      HorizontalAlignment="Center"
                      Margin="0,0,0,16">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:NotificationBubbleItem">
              <Border Margin="0,3,0,3"
                      Padding="12,6"
                      Background="{DynamicResource AppSurfaceElevatedBrush}"
                      BorderBrush="{DynamicResource AppBorderBrush}"
                      BorderThickness="1"
                      CornerRadius="14"
                      Opacity="{Binding Opacity}"
                      HorizontalAlignment="Center">
                <Border.Transitions>
                  <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.4"/>
                  </Transitions>
                </Border.Transitions>
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                  <Ellipse Width="6" Height="6" Fill="{DynamicResource AppPrimaryBrush}" VerticalAlignment="Center"/>
                  <TextBlock Text="{Binding Message}"
                             FontSize="11"
                             FontWeight="Medium"
                             Foreground="{DynamicResource AppTextPrimaryBrush}"
                             VerticalAlignment="Center"/>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Compact side drawer overlay (retained for compat) -->
        <Grid IsVisible="{Binding IsSideMenuOpen}" Background="#80000000">
          <Border HorizontalAlignment="Left"
                  Width="272"
                  Background="{DynamicResource AppSurfaceBrush}"
                  BorderBrush="{DynamicResource AppBorderBrush}"
                  BorderThickness="0,0,1,0"
                  Padding="20">
            <Grid RowDefinitions="Auto,*">
              <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,20">
                <TextBlock Grid.Column="0" Text="Navigation" Classes="heading" VerticalAlignment="Center"/>
                <Button Grid.Column="1"
                        Classes="ghost"
                        Command="{Binding CloseSideMenuCommand}"
                        Padding="6">
                  <PathIcon Data="{StaticResource CloseIconData}"
                            Width="14" Height="14"
                            Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                </Button>
              </Grid>
              <ListBox Grid.Row="1"
                       Background="Transparent"
                       SelectedIndex="{Binding SelectedNavIndex}">
                <ListBoxItem Classes="side-menu-item">
                  <StackPanel Orientation="Horizontal" Spacing="12">
                    <PathIcon Data="{StaticResource CheckListIconData}" Width="17" Height="17"/>
                    <TextBlock Text="Tasks" VerticalAlignment="Center"/>
                  </StackPanel>
                </ListBoxItem>
                <ListBoxItem Classes="side-menu-item">
                  <StackPanel Orientation="Horizontal" Spacing="12">
                    <PathIcon Data="{StaticResource CheckIconData}" Width="15" Height="15"/>
                    <TextBlock Text="Completed" VerticalAlignment="Center"/>
                  </StackPanel>
                </ListBoxItem>
                <ListBoxItem Classes="side-menu-item">
                  <StackPanel Orientation="Horizontal" Spacing="12">
                    <PathIcon Data="{StaticResource RepeatIconData}" Width="15" Height="15"/>
                    <TextBlock Text="Recurring" VerticalAlignment="Center"/>
                  </StackPanel>
                </ListBoxItem>
                <ListBoxItem Classes="side-menu-item">
                  <StackPanel Orientation="Horizontal" Spacing="12">
                    <PathIcon Data="{StaticResource CalendarIconData}" Width="17" Height="17"/>
                    <TextBlock Text="Calendar" VerticalAlignment="Center"/>
                  </StackPanel>
                </ListBoxItem>
                <ListBoxItem Classes="side-menu-item">
                  <StackPanel Orientation="Horizontal" Spacing="12">
                    <PathIcon Data="{StaticResource SearchIconData}" Width="17" Height="17"/>
                    <TextBlock Text="Search" VerticalAlignment="Center"/>
                  </StackPanel>
                </ListBoxItem>
                <ListBoxItem Classes="side-menu-item">
                  <StackPanel Orientation="Horizontal" Spacing="12">
                    <PathIcon Data="{StaticResource TagIconData}" Width="17" Height="17"/>
                    <TextBlock Text="Tags" VerticalAlignment="Center"/>
                  </StackPanel>
                </ListBoxItem>
                <ListBoxItem Classes="side-menu-item">
                  <StackPanel Orientation="Horizontal" Spacing="12">
                    <PathIcon Data="{StaticResource SettingsIconData}" Width="17" Height="17"/>
                    <TextBlock Text="Settings" VerticalAlignment="Center"/>
                  </StackPanel>
                </ListBoxItem>
              </ListBox>
            </Grid>
          </Border>
        </Grid>

      </Panel>

      <!-- ── Bottom Tab Bar (5 Tabs) ── -->
      <Border Grid.Row="1"
              Background="{DynamicResource AppSurfaceBrush}"
              BorderBrush="{DynamicResource AppBorderBrush}"
              BorderThickness="0,1,0,0"
              Height="56">
        <UniformGrid Columns="5">
          <Button Classes="tab-btn" Command="{Binding OpenTasksViewCommand}" Classes.active="{Binding IsTasksView}">
            <StackPanel Spacing="4" HorizontalAlignment="Center">
              <PathIcon Data="{StaticResource CheckListIconData}" Width="18" Height="18" HorizontalAlignment="Center"/>
              <TextBlock Text="Tasks" FontSize="10" FontWeight="Medium" HorizontalAlignment="Center"/>
            </StackPanel>
          </Button>

          <Button Classes="tab-btn" Command="{Binding OpenCompletedViewCommand}" Classes.active="{Binding IsCompletedView}">
            <StackPanel Spacing="4" HorizontalAlignment="Center">
              <PathIcon Data="{StaticResource CheckIconData}" Width="16" Height="16" HorizontalAlignment="Center"/>
              <TextBlock Text="Done" FontSize="10" FontWeight="Medium" HorizontalAlignment="Center"/>
            </StackPanel>
          </Button>

          <Button Classes="tab-btn" Command="{Binding OpenRecurringViewCommand}" Classes.active="{Binding IsRecurringView}">
            <StackPanel Spacing="4" HorizontalAlignment="Center">
              <PathIcon Data="{StaticResource RepeatIconData}" Width="18" Height="18" HorizontalAlignment="Center"/>
              <TextBlock Text="Repeating" FontSize="10" FontWeight="Medium" HorizontalAlignment="Center"/>
            </StackPanel>
          </Button>

          <Button Classes="tab-btn" Command="{Binding OpenCalendarViewCommand}" Classes.active="{Binding IsCalendarView}">
            <StackPanel Spacing="4" HorizontalAlignment="Center">
              <PathIcon Data="{StaticResource CalendarIconData}" Width="18" Height="18" HorizontalAlignment="Center"/>
              <TextBlock Text="Calendar" FontSize="10" FontWeight="Medium" HorizontalAlignment="Center"/>
            </StackPanel>
          </Button>

          <Button Classes="tab-btn" Command="{Binding ToggleMobileMoreSheetCommand}" Classes.active="{Binding IsMoreActive}" ToolTip.Tip="More Options">
            <StackPanel Spacing="4" HorizontalAlignment="Center">
              <PathIcon Data="{StaticResource MoreHorizontalIconData}" Width="18" Height="18" HorizontalAlignment="Center"/>
              <TextBlock Text="More" FontSize="10" FontWeight="Medium" HorizontalAlignment="Center"/>
            </StackPanel>
          </Button>
        </UniformGrid>
      </Border>

    </Grid>

    <!-- ══════════════════════════════════════════════════════
         MOBILE FLOATING TASK COMPOSER MODAL (Bottom Sheet)
    ══════════════════════════════════════════════════════ -->
    <Border x:Name="MobileTaskComposerPanel"
            IsVisible="{Binding IsMobileTaskComposerOpen}"
            Background="#90000000"
            ZIndex="2000">
      <Panel>
        <!-- Background Scrim (Tapping closes modal) -->
        <Border Background="Transparent" PointerPressed="OnMobileComposerBackgroundPressed"/>

        <Border VerticalAlignment="Bottom"
                HorizontalAlignment="Stretch"
                Background="{DynamicResource AppSurfaceBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="0,1,0,0"
                CornerRadius="24,24,0,0"
                Padding="24,16,24,24"
                BoxShadow="0 -8 32 0 #50000000">
          <StackPanel Spacing="16">

            <!-- Drag Handle & Close Row -->
            <Grid ColumnDefinitions="*,Auto">
              <Border Grid.Column="0"
                      Width="36" Height="4"
                      CornerRadius="2"
                      Background="{DynamicResource AppTextSecondaryBrush}"
                      Opacity="0.4"
                      HorizontalAlignment="Center"/>
              <Button Grid.Column="1"
                      Classes="ghost"
                      Command="{Binding CloseMobileTaskComposerCommand}"
                      Padding="6">
                <PathIcon Data="{StaticResource CloseIconData}" Width="14" Height="14"/>
              </Button>
            </Grid>

            <TextBlock Text="New Task" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimaryBrush}"/>

            <!-- Task Title Input -->
            <TextBox x:Name="MobileTaskTitleInput"
                     Classes="composer"
                     PlaceholderText="What do you need to do?"
                     Text="{Binding NewTaskTitle, Mode=TwoWay}"
                     FontSize="18"
                     FontWeight="SemiBold"
                     MinHeight="40"
                     Padding="14,8">
              <TextBox.KeyBindings>
                <KeyBinding Gesture="Enter" Command="{Binding AddTaskCommand}"/>
              </TextBox.KeyBindings>
            </TextBox>

            <!-- Task Description Input -->
            <TextBox Classes="composer"
                     PlaceholderText="Add details or context… (optional)"
                     Text="{Binding NewTaskDescription, Mode=TwoWay}"
                     FontSize="13"
                     Padding="14,6"
                     MinHeight="32"
                     AcceptsReturn="True"
                     MaxHeight="80"
                     TextWrapping="Wrap"/>

            <!-- Active Chips Preview Row -->
            <WrapPanel Orientation="Horizontal" Margin="0,4,0,4">
              <!-- Selected Due Date Chip (Matches action buttons 1:1) -->
              <Border IsVisible="{Binding HasNewTaskDueDate}"
                      Background="{DynamicResource AppPrimarySubtleBrush}"
                      BorderBrush="{DynamicResource AppPrimaryBrush}"
                      BorderThickness="1"
                      CornerRadius="16"
                      Padding="10,6"
                      Margin="0,0,8,8">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                  <PathIcon Data="{StaticResource CalendarIconData}" Width="12" Height="12" Foreground="{DynamicResource AppPrimaryBrush}" VerticalAlignment="Center"/>
                  <TextBlock Text="{Binding NewTaskDueDateFormatted}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AppPrimaryBrush}" VerticalAlignment="Center"/>
                  <Button Command="{Binding ClearDueDateCommand}" Classes="ghost" Padding="0" Width="14" Height="14" MinWidth="0" MinHeight="0" VerticalAlignment="Center" VerticalContentAlignment="Center">
                    <PathIcon Data="{StaticResource CloseIconData}" Width="9" Height="9" Foreground="{DynamicResource AppPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Button>
                </StackPanel>
              </Border>

              <!-- Selected Reminder Chip (Matches action buttons 1:1) -->
              <Border IsVisible="{Binding HasNewTaskReminder}"
                      Background="{DynamicResource AppPrimarySubtleBrush}"
                      BorderBrush="{DynamicResource AppPrimaryBrush}"
                      BorderThickness="1"
                      CornerRadius="16"
                      Padding="10,6"
                      Margin="0,0,8,8">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                  <PathIcon Data="{StaticResource BellIconData}" Width="12" Height="12" Foreground="{DynamicResource AppPrimaryBrush}" VerticalAlignment="Center"/>
                  <TextBlock Text="{Binding NewTaskReminderFormatted}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AppPrimaryBrush}" VerticalAlignment="Center"/>
                  <Button Command="{Binding ClearReminderCommand}" Classes="ghost" Padding="0" Width="14" Height="14" MinWidth="0" MinHeight="0" VerticalAlignment="Center" VerticalContentAlignment="Center">
                    <PathIcon Data="{StaticResource CloseIconData}" Width="9" Height="9" Foreground="{DynamicResource AppPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Button>
                </StackPanel>
              </Border>

              <!-- Selected Recurrence Chip (Matches action buttons 1:1) -->
              <Border IsVisible="{Binding HasNewTaskRecurrence}"
                      Background="{DynamicResource AppPrimarySubtleBrush}"
                      BorderBrush="{DynamicResource AppPrimaryBrush}"
                      BorderThickness="1"
                      CornerRadius="16"
                      Padding="10,6"
                      Margin="0,0,8,8">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                  <PathIcon Data="{StaticResource RepeatIconData}" Width="12" Height="12" Foreground="{DynamicResource AppPrimaryBrush}" VerticalAlignment="Center"/>
                  <TextBlock Text="{Binding NewTaskRecurrenceFormatted}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AppPrimaryBrush}" VerticalAlignment="Center"/>
                  <Button Command="{Binding ClearRecurrenceCommand}" Classes="ghost" Padding="0" Width="14" Height="14" MinWidth="0" MinHeight="0" VerticalAlignment="Center" VerticalContentAlignment="Center">
                    <PathIcon Data="{StaticResource CloseIconData}" Width="9" Height="9" Foreground="{DynamicResource AppPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Button>
                </StackPanel>
              </Border>

              <!-- Selected Category Chips (Matches action buttons 1:1) -->
              <ItemsControl ItemsSource="{Binding NewTaskCategories}" IsVisible="{Binding HasNewTaskCategories}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal"/>
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Background="{DynamicResource AppPrimaryBrush}"
                            BorderBrush="{DynamicResource AppPrimaryBrush}"
                            BorderThickness="1"
                            CornerRadius="16"
                            Padding="10,6"
                            Margin="0,0,8,8">
                      <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <PathIcon Data="{StaticResource TagIconData}" Width="12" Height="12" Foreground="#F8FAFC" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding}" FontSize="12" FontWeight="SemiBold" Foreground="#F8FAFC" VerticalAlignment="Center"/>
                        <Button Command="{Binding $parent[UserControl].DataContext.RemoveNewTaskCategoryCommand}" CommandParameter="{Binding}" Classes="ghost" Padding="0" Width="14" Height="14" MinWidth="0" MinHeight="0" VerticalAlignment="Center" VerticalContentAlignment="Center">
                          <PathIcon Data="{StaticResource CloseIconData}" Width="9" Height="9" Foreground="#F8FAFC" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </WrapPanel>

            <!-- Bottom Action Row: Date, Reminder, Repeat, Category buttons (Wraps cleanly on narrow screens) -->
            <WrapPanel Orientation="Horizontal" Margin="0,8,0,0">
              <Button Classes="outline"
                      Command="{Binding OpenMobileDueDateSheetCommand}"
                      Padding="12,7"
                      Margin="0,0,8,8"
                      CornerRadius="16"
                      ToolTip.Tip="Set due date">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                  <PathIcon Data="{StaticResource CalendarIconData}" Width="13" Height="13" Foreground="{DynamicResource AppPrimaryBrush}" VerticalAlignment="Center"/>
                  <TextBlock Text="Due Date" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>

              <Button Classes="outline"
                      Command="{Binding OpenMobileReminderSheetCommand}"
                      Padding="12,7"
                      Margin="0,0,8,8"
                      CornerRadius="16"
                      ToolTip.Tip="Set reminder">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                  <PathIcon Data="{StaticResource BellIconData}" Width="13" Height="13" Foreground="{DynamicResource AppPrimaryBrush}" VerticalAlignment="Center"/>
                  <TextBlock Text="Reminder" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>

              <Button Classes="outline"
                      Command="{Binding OpenMobileRepeatSheetCommand}"
                      Padding="12,7"
                      Margin="0,0,8,8"
                      CornerRadius="16"
                      ToolTip.Tip="Set recurrence">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                  <PathIcon Data="{StaticResource RepeatIconData}" Width="13" Height="13" Foreground="{DynamicResource AppPrimaryBrush}" VerticalAlignment="Center"/>
                  <TextBlock Text="Repeat" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>

              <Button Classes="outline"
                      Command="{Binding OpenMobileCategorySheetCommand}"
                      Padding="12,7"
                      Margin="0,0,8,8"
                      CornerRadius="16"
                      ToolTip.Tip="Set category">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                  <PathIcon Data="{StaticResource TagIconData}" Width="13" Height="13" Foreground="{DynamicResource AppPrimaryBrush}" VerticalAlignment="Center"/>
                  <TextBlock Text="Category" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
            </WrapPanel>

            <!-- Save Task Button Row (New Line, Right Aligned) -->
            <Button Classes="primary"
                    Command="{Binding AddTaskCommand}"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0"
                    Padding="22,10"
                    CornerRadius="20">
              <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <PathIcon Data="{StaticResource PlusIconData}" Width="13" Height="13" Foreground="#F8FAFC" VerticalAlignment="Center"/>
                <TextBlock Text="Add Task" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>

          </StackPanel>
        </Border>
      </Panel>
    </Border>

    <!-- ══════════════════════════════════════════════════════
         MOBILE DUE DATE SELECTION FLOATING DIALOG
    ══════════════════════════════════════════════════════ -->
    <Border IsVisible="{Binding IsMobileDueDateSheetOpen}"
            Background="#A0000000"
            ZIndex="2100">
      <Panel>
        <Border Background="Transparent" PointerPressed="OnMobileDueDateBackgroundPressed"/>

        <Border VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Width="310"
                Margin="16"
                Background="{DynamicResource AppSurfaceBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                ClipToBounds="True"
                BoxShadow="0 12 40 0 #A0000000">
          <StackPanel Spacing="0">
            <!-- Header Banner -->
            <Border Background="{DynamicResource AppSurfaceElevatedBrush}" Padding="16,10,16,12">
              <StackPanel Spacing="2">
                <TextBlock Text="{Binding DueDateHeaderYear}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                <TextBlock Text="{Binding DueDateHeaderMainText}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimaryBrush}" TextWrapping="Wrap"/>
              </StackPanel>
            </Border>

            <!-- Calendar Picker -->
            <Border Padding="4,4" MinHeight="260" HorizontalAlignment="Center" VerticalAlignment="Center">
              <Calendar SelectedDate="{Binding NewTaskDueDate, Mode=TwoWay}"
                        DisplayDateStart="{Binding MinDueDate}"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="0"
                        Margin="0"
                        HorizontalAlignment="Center"/>
            </Border>

            <Separator Classes="divider" Margin="0"/>

            <!-- Action Buttons Footer -->
            <Border Padding="12,8" Background="{DynamicResource AppSurfaceBrush}">
              <Grid ColumnDefinitions="*,Auto">
                <Button Grid.Column="0" Classes="ghost" Command="{Binding ClearDueDateCommand}" HorizontalAlignment="Left" Padding="8,6">
                  <TextBlock Text="CLEAR" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                </Button>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                  <Button Classes="ghost" Command="{Binding CloseMobileDueDateSheetCommand}" Padding="8,6">
                    <TextBlock Text="CANCEL" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                  </Button>
                  <Button Classes="ghost" Command="{Binding CloseMobileDueDateSheetCommand}" Padding="8,6">
                    <TextBlock Text="SAVE" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AppPrimaryBrush}"/>
                  </Button>
                </StackPanel>
              </Grid>
            </Border>
          </StackPanel>
        </Border>
      </Panel>
    </Border>

    <!-- ══════════════════════════════════════════════════════
         MOBILE REMINDER SELECTION FLOATING DIALOG
    ══════════════════════════════════════════════════════ -->
    <Border IsVisible="{Binding IsMobileReminderSheetOpen}"
            Background="#A0000000"
            ZIndex="2100">
      <Panel>
        <Border Background="Transparent" PointerPressed="OnMobileReminderBackgroundPressed"/>

        <Border VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Width="310"
                Margin="16"
                Background="{DynamicResource AppSurfaceBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                ClipToBounds="True"
                BoxShadow="0 12 40 0 #A0000000">
          <StackPanel Spacing="0">
            <!-- 1. Tabs Header (DATE | TIME) -->
            <Grid ColumnDefinitions="*,*" Background="{DynamicResource AppSurfaceElevatedBrush}">
              <!-- DATE Tab -->
              <Button Grid.Column="0"
                      Classes="ghost"
                      Command="{Binding SelectReminderDateTabCommand}"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Stretch"
                      Padding="0"
                      CornerRadius="0">
                <Grid RowDefinitions="Auto,Auto" HorizontalAlignment="Stretch" Margin="0,10,0,0">
                  <TextBlock Grid.Row="0"
                             Text="DATE"
                             FontSize="12"
                             FontWeight="Bold"
                             HorizontalAlignment="Center"
                             Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                  <Border Grid.Row="1"
                          Height="2"
                          Width="44"
                          Margin="0,6,0,0"
                          HorizontalAlignment="Center"
                          Background="{DynamicResource AppPrimaryBrush}"
                          IsVisible="{Binding IsReminderDateTabSelected}"/>
                </Grid>
              </Button>

              <!-- TIME Tab -->
              <Button Grid.Column="1"
                      Classes="ghost"
                      Command="{Binding SelectReminderTimeTabCommand}"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Stretch"
                      Padding="0"
                      CornerRadius="0">
                <Grid RowDefinitions="Auto,Auto" HorizontalAlignment="Stretch" Margin="0,10,0,0">
                  <TextBlock Grid.Row="0"
                             Text="TIME"
                             FontSize="12"
                             FontWeight="Bold"
                             HorizontalAlignment="Center"
                             Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                  <Border Grid.Row="1"
                          Height="2"
                          Width="44"
                          Margin="0,6,0,0"
                          HorizontalAlignment="Center"
                          Background="{DynamicResource AppPrimaryBrush}"
                          IsVisible="{Binding IsReminderTimeTabSelected}"/>
                </Grid>
              </Button>
            </Grid>

            <!-- 2. Big Date/Time Header Banner -->
            <Border Background="{DynamicResource AppSurfaceElevatedBrush}" Padding="16,10,16,12">
              <StackPanel Spacing="2">
                <TextBlock Text="{Binding ReminderHeaderYear}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                <TextBlock Text="{Binding ReminderHeaderMainText}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimaryBrush}" TextWrapping="Wrap"/>
              </StackPanel>
            </Border>

            <!-- 3. Tab Contents -->
            <!-- DATE Tab Content -->
            <Border IsVisible="{Binding IsReminderDateTabSelected}" Padding="4,4" MinHeight="260" HorizontalAlignment="Center" VerticalAlignment="Center">
              <Calendar SelectedDate="{Binding NewTaskReminderDate, Mode=TwoWay}"
                        DisplayDateStart="{Binding MinDueDate}"
                        DisplayDateEnd="{Binding NewTaskDueDate}"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="0"
                        Margin="0"
                        HorizontalAlignment="Center"/>
            </Border>

            <!-- TIME Tab Content -->
            <Border IsVisible="{Binding IsReminderTimeTabSelected}" Padding="14,12" MinHeight="260">
              <StackPanel Spacing="10" VerticalAlignment="Center">
                <TextBlock Text="TIME PRESETS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                <UniformGrid Columns="2" Rows="2">
                  <Button Classes="ghost"
                          Command="{Binding SetReminderPresetMorningCommand}"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Margin="3"
                          Padding="8,10"
                          Background="{DynamicResource AppSurfaceElevatedBrush}"
                          BorderBrush="{DynamicResource AppBorderBrush}"
                          BorderThickness="1"
                          CornerRadius="8">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="2">
                      <TextBlock Text="09:00" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{DynamicResource AppPrimaryBrush}"/>
                      <TextBlock Text="Morning" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                    </StackPanel>
                  </Button>

                  <Button Classes="ghost"
                          Command="{Binding SetReminderPresetAfternoonCommand}"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Margin="3"
                          Padding="8,10"
                          Background="{DynamicResource AppSurfaceElevatedBrush}"
                          BorderBrush="{DynamicResource AppBorderBrush}"
                          BorderThickness="1"
                          CornerRadius="8">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="2">
                      <TextBlock Text="13:00" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{DynamicResource AppPrimaryBrush}"/>
                      <TextBlock Text="Afternoon" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                    </StackPanel>
                  </Button>

                  <Button Classes="ghost"
                          Command="{Binding SetReminderPresetEveningCommand}"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Margin="3"
                          Padding="8,10"
                          Background="{DynamicResource AppSurfaceElevatedBrush}"
                          BorderBrush="{DynamicResource AppBorderBrush}"
                          BorderThickness="1"
                          CornerRadius="8">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="2">
                      <TextBlock Text="17:00" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{DynamicResource AppPrimaryBrush}"/>
                      <TextBlock Text="Evening" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                    </StackPanel>
                  </Button>

                  <Button Classes="ghost"
                          Command="{Binding SetReminderPresetNightCommand}"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Margin="3"
                          Padding="8,10"
                          Background="{DynamicResource AppSurfaceElevatedBrush}"
                          BorderBrush="{DynamicResource AppBorderBrush}"
                          BorderThickness="1"
                          CornerRadius="8">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="2">
                      <TextBlock Text="20:00" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{DynamicResource AppPrimaryBrush}"/>
                      <TextBlock Text="Night" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                    </StackPanel>
                  </Button>
                </UniformGrid>

                <Separator Classes="divider" Margin="0,2"/>

                <TextBlock Text="CUSTOM TIME" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                <controls:ClockTimePicker SelectedTime="{Binding NewTaskReminderTime, Mode=TwoWay}"
                                          HorizontalAlignment="Stretch"/>
              </StackPanel>
            </Border>

            <Separator Classes="divider" Margin="0"/>

            <!-- 4. Footer Action Buttons (CANCEL / SAVE) -->
            <Border Padding="12,8" Background="{DynamicResource AppSurfaceBrush}">
              <Grid ColumnDefinitions="*,Auto">
                <Button Grid.Column="0" Classes="ghost" Command="{Binding ClearReminderCommand}" HorizontalAlignment="Left" Padding="8,6">
                  <TextBlock Text="CLEAR" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                </Button>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                  <Button Classes="ghost" Command="{Binding CloseMobileReminderSheetCommand}" Padding="8,6">
                    <TextBlock Text="CANCEL" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                  </Button>
                  <Button Classes="ghost" Command="{Binding CloseMobileReminderSheetCommand}" Padding="8,6">
                    <TextBlock Text="SAVE" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AppPrimaryBrush}"/>
                  </Button>
                </StackPanel>
              </Grid>
            </Border>
          </StackPanel>
        </Border>
      </Panel>
    </Border>

    <!-- ══════════════════════════════════════════════════════
         MOBILE REPEAT SELECTION BOTTOM SHEET
    ══════════════════════════════════════════════════════ -->
    <Border IsVisible="{Binding IsMobileRepeatSheetOpen}"
            Background="#90000000"
            ZIndex="2100">
      <Panel>
        <Border Background="Transparent" PointerPressed="OnMobileRepeatBackgroundPressed"/>

        <Border VerticalAlignment="Bottom"
                HorizontalAlignment="Stretch"
                Background="{DynamicResource AppSurfaceBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="0,1,0,0"
                CornerRadius="24,24,0,0"
                Padding="24,16,24,24"
                BoxShadow="0 -8 32 0 #50000000">
          <StackPanel Spacing="14">
            <!-- Fixed Header -->
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Grid.Column="0" Text="Repeat Frequency" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimaryBrush}"/>
              <Button Grid.Column="1" Classes="ghost" Command="{Binding CloseMobileRepeatSheetCommand}" Padding="6">
                <PathIcon Data="{StaticResource CloseIconData}" Width="14" Height="14"/>
              </Button>
            </Grid>

            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="380" Padding="0,0,8,0">
              <StackPanel Spacing="10">
                <Button Classes="ghost" Command="{Binding SetRecurrenceTypeCommand}" CommandParameter="Daily" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12,10">
                  <StackPanel Orientation="Horizontal" Spacing="12">
                    <PathIcon Data="{StaticResource RepeatIconData}" Width="16" Height="16" Foreground="{DynamicResource AppPrimaryBrush}"/>
                    <TextBlock Text="Daily" FontSize="14" FontWeight="SemiBold"/>
                  </StackPanel>
                </Button>
                <Button Classes="ghost" Command="{Binding SetRecurrenceTypeCommand}" CommandParameter="Weekdays" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12,10">
                  <StackPanel Orientation="Horizontal" Spacing="12">
                    <PathIcon Data="{StaticResource RepeatIconData}" Width="16" Height="16" Foreground="{DynamicResource AppPrimaryBrush}"/>
                    <TextBlock Text="Weekdays" FontSize="14" FontWeight="SemiBold"/>
                  </StackPanel>
                </Button>
                <Button Classes="ghost" Command="{Binding SetRecurrenceTypeCommand}" CommandParameter="Weekly" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12,10">
                  <StackPanel Orientation="Horizontal" Spacing="12">
                    <PathIcon Data="{StaticResource RepeatIconData}" Width="16" Height="16" Foreground="{DynamicResource AppPrimaryBrush}"/>
                    <TextBlock Text="Weekly" FontSize="14" FontWeight="SemiBold"/>
                  </StackPanel>
                </Button>
                <Button Classes="ghost" Command="{Binding SetRecurrenceTypeCommand}" CommandParameter="Monthly" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12,10">
                  <StackPanel Orientation="Horizontal" Spacing="12">
                    <PathIcon Data="{StaticResource RepeatIconData}" Width="16" Height="16" Foreground="{DynamicResource AppPrimaryBrush}"/>
                    <TextBlock Text="Monthly" FontSize="14" FontWeight="SemiBold"/>
                  </StackPanel>
                </Button>
                <Button Classes="ghost" Command="{Binding SetRecurrenceTypeCommand}" CommandParameter="Yearly" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12,10">
                  <StackPanel Orientation="Horizontal" Spacing="12">
                    <PathIcon Data="{StaticResource RepeatIconData}" Width="16" Height="16" Foreground="{DynamicResource AppPrimaryBrush}"/>
                    <TextBlock Text="Yearly" FontSize="14" FontWeight="SemiBold"/>
                  </StackPanel>
                </Button>

                <Separator Classes="divider" Margin="0,4"/>

                <Button Classes="ghost" Command="{Binding SetRecurrenceTypeCommand}" CommandParameter="Custom" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12,10">
                  <StackPanel Orientation="Horizontal" Spacing="12">
                    <PathIcon Data="{StaticResource SettingsIconData}" Width="16" Height="16" Foreground="{DynamicResource AppPrimaryBrush}"/>
                    <TextBlock Text="Custom Schedule…" FontSize="14" FontWeight="SemiBold"/>
                  </StackPanel>
                </Button>

                <!-- Custom Recurrence Expansion -->
                <StackPanel IsVisible="{Binding IsCustomRecurrenceVisible}" Spacing="8" Margin="0,4,0,0">
                  <Grid ColumnDefinitions="*,12,*">
                    <StackPanel Grid.Column="0" Spacing="4">
                      <TextBlock Text="Every" FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                      <NumericUpDown Minimum="1" Maximum="365" Value="{Binding CustomInterval, Mode=TwoWay}" FormatString="0" HorizontalAlignment="Stretch"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="4">
                      <TextBlock Text="Unit" FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                      <ComboBox ItemsSource="{Binding CustomUnitOptions}"
                                SelectedItem="{Binding SelectedCustomUnit, Mode=TwoWay}"
                                HorizontalAlignment="Stretch"/>
                    </StackPanel>
                  </Grid>

                  <StackPanel IsVisible="{Binding IsWeeklyDaysPickerVisible}" Spacing="6" Margin="0,4,0,0">
                    <TextBlock Text="Select Days" FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                    <UniformGrid Columns="7">
                      <ToggleButton Content="M" IsChecked="{Binding IsMondaySelected, Mode=TwoWay}" Padding="0" Height="32" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                      <ToggleButton Content="T" IsChecked="{Binding IsTuesdaySelected, Mode=TwoWay}" Padding="0" Height="32" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                      <ToggleButton Content="W" IsChecked="{Binding IsWednesdaySelected, Mode=TwoWay}" Padding="0" Height="32" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                      <ToggleButton Content="T" IsChecked="{Binding IsThursdaySelected, Mode=TwoWay}" Padding="0" Height="32" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                      <ToggleButton Content="F" IsChecked="{Binding IsFridaySelected, Mode=TwoWay}" Padding="0" Height="32" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                      <ToggleButton Content="S" IsChecked="{Binding IsSaturdaySelected, Mode=TwoWay}" Padding="0" Height="32" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                      <ToggleButton Content="S" IsChecked="{Binding IsSundaySelected, Mode=TwoWay}" Padding="0" Height="32" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                    </UniformGrid>
                  </StackPanel>
                </StackPanel>
              </StackPanel>
            </ScrollViewer>

            <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
              <Button Grid.Column="0" Classes="outline" Command="{Binding ClearRecurrenceCommand}" HorizontalAlignment="Left">
                <TextBlock Text="Clear Repeat" FontSize="12"/>
              </Button>
              <Button Grid.Column="1" Classes="primary" Command="{Binding CloseMobileRepeatSheetCommand}" Padding="20,8" CornerRadius="16">
                <TextBlock Text="Done" FontSize="13" FontWeight="Bold"/>
              </Button>
            </Grid>
          </StackPanel>
        </Border>
      </Panel>
    </Border>

    <!-- ══════════════════════════════════════════════════════
         MOBILE CATEGORY SELECTION FLOATING DIALOG
    ══════════════════════════════════════════════════════ -->
    <Border IsVisible="{Binding IsMobileCategorySheetOpen}"
            Background="#A0000000"
            ZIndex="2100">
      <Panel>
        <Border Background="Transparent" PointerPressed="OnMobileCategoryBackgroundPressed"/>

        <Border VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Width="310"
                Margin="16"
                Background="{DynamicResource AppSurfaceBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                ClipToBounds="True"
                BoxShadow="0 12 40 0 #A0000000">
          <StackPanel Spacing="0">
            <!-- Header Banner -->
            <Border Background="{DynamicResource AppSurfaceElevatedBrush}" Padding="16,12,16,14">
              <StackPanel Spacing="2">
                <TextBlock Text="SELECT CATEGORY TAG" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AppPrimaryBrush}"/>
                <TextBlock Text="Assign tags to task" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimaryBrush}"/>
              </StackPanel>
            </Border>

            <!-- Category List -->
            <Border Padding="16,12" MinHeight="140" MaxHeight="260">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="8">
                  <TextBlock Text="No tags created yet."
                             IsVisible="{Binding !HasExistingCategories}"
                             FontSize="13"
                             Foreground="{DynamicResource AppTextSecondaryBrush}"
                             Margin="4,8"/>

                  <ItemsControl ItemsSource="{Binding ExistingCategories}" IsVisible="{Binding HasExistingCategories}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Button Classes="ghost"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Padding="10,8"
                                Command="{Binding $parent[UserControl].DataContext.AddNewTaskCategoryCommand}"
                                CommandParameter="{Binding}">
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <PathIcon Data="{StaticResource TagIconData}" Width="12" Height="12" Foreground="{DynamicResource AppPrimaryBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding}" Foreground="{DynamicResource AppTextPrimaryBrush}" FontSize="13" FontWeight="SemiBold"/>
                          </StackPanel>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <Separator Classes="divider" Margin="0,4"/>

                  <Button Classes="ghost"
                          Command="{Binding OpenTagsViewCommand}"
                          CommandParameter="{Binding $parent[Button].Flyout}"
                          x:CompileBindings="False"
                          Foreground="{DynamicResource AppPrimaryBrush}"
                          FontWeight="SemiBold"
                          HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Left"
                          Padding="10,8">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                      <PathIcon Data="{StaticResource SettingsIconData}" Width="12" Height="12"/>
                      <TextBlock Text="Manage Tags..." FontSize="12"/>
                    </StackPanel>
                  </Button>
                </StackPanel>
              </ScrollViewer>
            </Border>

            <Separator Classes="divider" Margin="0"/>

            <!-- Action Buttons Footer -->
            <Border Padding="12,8" Background="{DynamicResource AppSurfaceBrush}">
              <Button Classes="ghost" Command="{Binding CloseMobileCategorySheetCommand}" HorizontalAlignment="Right" Padding="12,6">
                <TextBlock Text="CLOSE" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AppPrimaryBrush}"/>
              </Button>
            </Border>
          </StackPanel>
        </Border>
      </Panel>
    </Border>

    <!-- ══════════════════════════════════════════════════════
         MOBILE MORE MENU SHEET MODAL (Bottom Sheet)
    ══════════════════════════════════════════════════════ -->
    <Border x:Name="MobileMoreSheetPanel"
            IsVisible="{Binding IsMobileMoreSheetOpen}"
            Background="#90000000"
            ZIndex="2100">
      <Panel>
        <!-- Background Scrim (Tapping closes modal) -->
        <Border Background="Transparent" PointerPressed="OnMobileMoreSheetBackgroundPressed"/>

        <Border VerticalAlignment="Bottom"
                HorizontalAlignment="Stretch"
                Background="{DynamicResource AppSurfaceBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="0,1,0,0"
                CornerRadius="24,24,0,0"
                Padding="24,20"
                BoxShadow="0 -8 32 0 #50000000">
          <StackPanel Spacing="16">

            <!-- Drag Handle & Close Row -->
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Grid.Column="0" Spacing="4">
                <Border Width="36" Height="4"
                        CornerRadius="2"
                        Background="{DynamicResource AppTextSecondaryBrush}"
                        Opacity="0.4"
                        HorizontalAlignment="Left"
                        Margin="0,0,0,4"/>
                <TextBlock Text="MORE OPTIONS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AppPrimaryBrush}"/>
              </StackPanel>
              <Button Grid.Column="1"
                      Classes="icon-btn"
                      Command="{Binding CloseMobileMoreSheetCommand}"
                      ToolTip.Tip="Close options">
                <PathIcon Data="{StaticResource CloseIconData}" Width="14" Height="14"/>
              </Button>
            </Grid>

            <!-- Sheet Menu Actions -->
            <StackPanel Spacing="8">

              <!-- Search Tasks -->
              <Button Classes="outline"
                      Command="{Binding OpenSearchViewCommand}"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Left"
                      Padding="14,12"
                      CornerRadius="12">
                <Grid ColumnDefinitions="Auto,*">
                  <PathIcon Grid.Column="0" Data="{StaticResource SearchIconData}" Width="18" Height="18" Foreground="{DynamicResource AppPrimaryBrush}" VerticalAlignment="Center"/>
                  <StackPanel Grid.Column="1" Spacing="2" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Search Tasks" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                    <TextBlock Text="Search by keywords, notes, or tags" FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                  </StackPanel>
                </Grid>
              </Button>

              <!-- Tags Management -->
              <Button Classes="outline"
                      Command="{Binding OpenTagsViewCommand}"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Left"
                      Padding="14,12"
                      CornerRadius="12">
                <Grid ColumnDefinitions="Auto,*">
                  <PathIcon Grid.Column="0" Data="{StaticResource TagIconData}" Width="18" Height="18" Foreground="{DynamicResource AppPrimaryBrush}" VerticalAlignment="Center"/>
                  <StackPanel Grid.Column="1" Spacing="2" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Tags Management" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                    <TextBlock Text="Create, rename, or delete category tags" FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                  </StackPanel>
                </Grid>
              </Button>

              <!-- Settings -->
              <Button Classes="outline"
                      Command="{Binding OpenSettingsCommand}"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Left"
                      Padding="14,12"
                      CornerRadius="12">
                <Grid ColumnDefinitions="Auto,*">
                  <PathIcon Grid.Column="0" Data="{StaticResource SettingsIconData}" Width="18" Height="18" Foreground="{DynamicResource AppPrimaryBrush}" VerticalAlignment="Center"/>
                  <StackPanel Grid.Column="1" Spacing="2" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Settings" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                    <TextBlock Text="Theme, Cloud Sync, and app preferences" FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                  </StackPanel>
                </Grid>
              </Button>

            </StackPanel>

          </StackPanel>
        </Border>
      </Panel>
    </Border>

    <!-- ══════════════════════════════════════════════════════
         MOBILE TAG FILTER SELECTION FLOATING DIALOG
    ══════════════════════════════════════════════════════ -->
    <Border IsVisible="{Binding IsMobileTagFilterSheetOpen}"
            Background="#A0000000"
            ZIndex="2150">
      <Panel>
        <Border Background="Transparent" PointerPressed="OnMobileTagFilterBackgroundPressed"/>

        <Border VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Width="310"
                Margin="16"
                Background="{DynamicResource AppSurfaceBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                ClipToBounds="True"
                BoxShadow="0 12 40 0 #A0000000">
          <StackPanel Spacing="0">
            <!-- Header Banner -->
            <Border Background="{DynamicResource AppSurfaceElevatedBrush}" Padding="16,12,16,14">
              <StackPanel Spacing="2">
                <TextBlock Text="FILTER BY TAG" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AppPrimaryBrush}"/>
                <TextBlock Text="{Binding CategoryFilterButtonText}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimaryBrush}" TextWrapping="Wrap"/>
              </StackPanel>
            </Border>

            <!-- Tags List with Checkboxes -->
            <Border Padding="16,12" MinHeight="140" MaxHeight="260">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="10">
                  <ItemsControl ItemsSource="{Binding CategoryFilterOptions}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <CheckBox Content="{Binding Name}"
                                  IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                  Margin="0,4"
                                  FontSize="13"
                                  FontWeight="Medium"/>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <Separator Classes="divider" Margin="0,4"/>

                  <Button Classes="ghost"
                          Command="{Binding OpenTagsViewCommand}"
                          CommandParameter="{Binding $parent[Button].Flyout}"
                          x:CompileBindings="False"
                          Foreground="{DynamicResource AppPrimaryBrush}"
                          FontWeight="SemiBold"
                          HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Left"
                          Padding="0,4">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                      <PathIcon Data="{StaticResource SettingsIconData}" Width="12" Height="12"/>
                      <TextBlock Text="Manage Tags..." FontSize="12"/>
                    </StackPanel>
                  </Button>
                </StackPanel>
              </ScrollViewer>
            </Border>

            <Separator Classes="divider" Margin="0"/>

            <!-- Action Buttons Footer -->
            <Border Padding="12,8" Background="{DynamicResource AppSurfaceBrush}">
              <Grid ColumnDefinitions="*,Auto">
                <Button Grid.Column="0" Classes="ghost" Command="{Binding ClearTagFilterCommand}" HorizontalAlignment="Left" Padding="8,6">
                  <TextBlock Text="CLEAR" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                </Button>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                  <Button Classes="ghost" Command="{Binding CloseMobileTagFilterSheetCommand}" Padding="8,6">
                    <TextBlock Text="CANCEL" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                  </Button>
                  <Button Classes="ghost" Command="{Binding CloseMobileTagFilterSheetCommand}" Padding="8,6">
                    <TextBlock Text="SAVE" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AppPrimaryBrush}"/>
                  </Button>
                </StackPanel>
              </Grid>
            </Border>
          </StackPanel>
        </Border>
      </Panel>
    </Border>

    <!-- ══════════════════════════════════════════════════════
         MOBILE COMPLETED DATE FILTER SELECTION FLOATING DIALOG
    ══════════════════════════════════════════════════════ -->
    <Border IsVisible="{Binding IsMobileCompletedDateFilterSheetOpen}"
            Background="#A0000000"
            ZIndex="2100">
      <Panel>
        <Border Background="Transparent" PointerPressed="OnMobileCompletedDateBackgroundPressed"/>

        <Border VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Width="310"
                Margin="16"
                Background="{DynamicResource AppSurfaceBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                ClipToBounds="True"
                BoxShadow="0 12 40 0 #A0000000">
          <StackPanel Spacing="0">
            <!-- Header Banner -->
            <Border Background="{DynamicResource AppSurfaceElevatedBrush}" Padding="16,10,16,12">
              <StackPanel Spacing="2">
                <TextBlock Text="{Binding CompletedDateHeaderYear}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                <TextBlock Text="{Binding CompletedDateHeaderMainText}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimaryBrush}" TextWrapping="Wrap"/>
              </StackPanel>
            </Border>

            <!-- Quick Presets Bar -->
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Padding="10,6">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <Button Classes="ghost" Command="{Binding SetCompletedDateFilterPresetCommand}" CommandParameter="All" Padding="6,4">
                  <TextBlock Text="All Time" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppPrimaryBrush}"/>
                </Button>
                <Button Classes="ghost" Command="{Binding SetCompletedDateFilterPresetCommand}" CommandParameter="Today" Padding="6,4">
                  <TextBlock Text="Today" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppPrimaryBrush}"/>
                </Button>
                <Button Classes="ghost" Command="{Binding SetCompletedDateFilterPresetCommand}" CommandParameter="Yesterday" Padding="6,4">
                  <TextBlock Text="Yesterday" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppPrimaryBrush}"/>
                </Button>
                <Button Classes="ghost" Command="{Binding SetCompletedDateFilterPresetCommand}" CommandParameter="7Days" Padding="6,4">
                  <TextBlock Text="Last 7 Days" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppPrimaryBrush}"/>
                </Button>
                <Button Classes="ghost" Command="{Binding SetCompletedDateFilterPresetCommand}" CommandParameter="30Days" Padding="6,4">
                  <TextBlock Text="Last 30 Days" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppPrimaryBrush}"/>
                </Button>
                <Button Classes="ghost" Command="{Binding SetCompletedDateFilterPresetCommand}" CommandParameter="ThisMonth" Padding="6,4">
                  <TextBlock Text="This Month" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppPrimaryBrush}"/>
                </Button>
              </StackPanel>
            </ScrollViewer>

            <Separator Classes="divider" Margin="0"/>

            <!-- From / To Date Mode Selector Tabs -->
            <Grid ColumnDefinitions="*,*" Margin="8,6,8,2">
              <Button Grid.Column="0"
                      Classes="ghost"
                      Command="{Binding SelectCompletedDateTabCommand}"
                      CommandParameter="Start"
                      Padding="6,4"
                      HorizontalAlignment="Stretch">
                <StackPanel Spacing="1">
                  <TextBlock Text="FROM" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource AppTextSecondaryBrush}" HorizontalAlignment="Center"/>
                  <TextBlock Text="{Binding CompletedDateFilterStartDateFormatted}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AppPrimaryBrush}" HorizontalAlignment="Center"/>
                </StackPanel>
              </Button>
              <Button Grid.Column="1"
                      Classes="ghost"
                      Command="{Binding SelectCompletedDateTabCommand}"
                      CommandParameter="End"
                      Padding="6,4"
                      HorizontalAlignment="Stretch">
                <StackPanel Spacing="1">
                  <TextBlock Text="TO" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource AppTextSecondaryBrush}" HorizontalAlignment="Center"/>
                  <TextBlock Text="{Binding CompletedDateFilterEndDateFormatted}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AppPrimaryBrush}" HorizontalAlignment="Center"/>
                </StackPanel>
              </Button>
            </Grid>

            <!-- Embedded Calendar Picker (Matching Due Date Modal) -->
            <Border Padding="4,4" MinHeight="260" HorizontalAlignment="Center" VerticalAlignment="Center">
              <Panel>
                <!-- Start Date Calendar -->
                <Calendar IsVisible="{Binding IsCompletedDateStartTabActive}"
                          SelectedDate="{Binding CompletedDateFilterStartDate, Mode=TwoWay}"
                          DisplayDateEnd="{Binding CompletedDateFilterEndDate}"
                          Background="Transparent"
                          BorderThickness="0"
                          Padding="0"
                          Margin="0"
                          HorizontalAlignment="Center"/>
                <!-- End Date Calendar -->
                <Calendar IsVisible="{Binding !IsCompletedDateStartTabActive}"
                          SelectedDate="{Binding CompletedDateFilterEndDate, Mode=TwoWay}"
                          DisplayDateStart="{Binding CompletedDateFilterStartDate}"
                          Background="Transparent"
                          BorderThickness="0"
                          Padding="0"
                          Margin="0"
                          HorizontalAlignment="Center"/>
              </Panel>
            </Border>

            <Separator Classes="divider" Margin="0"/>

            <!-- Action Buttons Footer -->
            <Border Padding="12,8" Background="{DynamicResource AppSurfaceBrush}">
              <Grid ColumnDefinitions="*,Auto">
                <Button Grid.Column="0" Classes="ghost" Command="{Binding ClearCompletedDateFilterCommand}" HorizontalAlignment="Left" Padding="8,6">
                  <TextBlock Text="CLEAR" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                </Button>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                  <Button Classes="ghost" Command="{Binding CloseMobileCompletedDateFilterSheetCommand}" Padding="8,6">
                    <TextBlock Text="CANCEL" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                  </Button>
                  <Button Classes="ghost" Command="{Binding CloseMobileCompletedDateFilterSheetCommand}" Padding="8,6">
                    <TextBlock Text="SAVE" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AppPrimaryBrush}"/>
                  </Button>
                </StackPanel>
              </Grid>
            </Border>
          </StackPanel>
        </Border>
      </Panel>
    </Border>

    <!-- My Tasks Layout Picker Bottom Sheet Modal (Mobile/Portrait UX Best Practice) -->
    <Border x:Name="TasksLayoutPickerSheetPanel"
            IsVisible="{Binding IsTasksLayoutPickerSheetOpen}"
            ZIndex="1100"
            Background="#A0000000">
      <Grid RowDefinitions="*,Auto">
        <!-- Dismiss Backdrop Overlay -->
        <Border Grid.Row="0" Background="Transparent" PointerPressed="OnTasksLayoutPickerBackgroundPressed"/>

        <!-- Bottom Sheet Card Container -->
        <Border Grid.Row="1"
                Background="{DynamicResource AppSurfaceElevatedBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="0,1,0,0"
                CornerRadius="20,20,0,0"
                Padding="20,16,20,24"
                MaxWidth="560"
                HorizontalAlignment="Stretch">
          <StackPanel Spacing="16">
            <!-- Sheet Drag Pill -->
            <Border Width="36" Height="4" CornerRadius="2" Background="{DynamicResource AppBorderBrush}" HorizontalAlignment="Center" Margin="0,0,0,4"/>

            <!-- Sheet Header -->
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Grid.Column="0" Spacing="2">
                <TextBlock Text="My Tasks Layout Mode" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                <TextBlock Text="Choose which sections appear and how they are arranged on My Tasks." FontSize="12" Foreground="{DynamicResource AppTextSecondaryBrush}" TextWrapping="Wrap"/>
              </StackPanel>
              <Button Grid.Column="1"
                      Classes="ghost"
                      Command="{Binding CloseTasksLayoutPickerCommand}"
                      Padding="6"
                      VerticalAlignment="Top">
                <PathIcon Data="{StaticResource CloseIconData}" Width="14" Height="14" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
              </Button>
            </Grid>

            <Separator Classes="divider" Margin="0,2"/>

            <!-- Layout Option Cards List -->
            <ItemsControl ItemsSource="{Binding TasksLayoutOptions}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:TasksLayoutOption">
                  <Button Classes="ghost"
                          Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).SelectTasksLayoutOptionCommand}"
                          CommandParameter="{Binding}"
                          HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Stretch"
                          Padding="14,12"
                          Margin="0,0,0,8"
                          CornerRadius="10"
                          Background="{DynamicResource AppSurfaceSubtleBrush}"
                          BorderBrush="{DynamicResource AppBorderBrush}"
                          BorderThickness="1">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                      <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                        <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}" TextWrapping="Wrap"/>
                      </StackPanel>

                      <!-- Checkmark for selected option -->
                      <PathIcon Grid.Column="1"
                                Data="{StaticResource CheckIconData}"
                                Width="16" Height="16"
                                Foreground="{DynamicResource AppPrimaryBrush}"
                                VerticalAlignment="Center"
                                IsVisible="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).TasksViewLayout, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={Binding Id}}"/>
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </Grid>
    </Border>

  </Panel>
</UserControl>
