<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Wadd.UI.ViewModels;assembly=Wadd.UI"
             xmlns:models="clr-namespace:Wadd.Core.Models;assembly=Wadd.Core"
             xmlns:views="clr-namespace:Wadd.UI.Views;assembly=Wadd.UI"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="760"
             x:Class="Wadd.UI.Views.MainView"
             x:DataType="vm:MainViewModel"
             Background="{DynamicResource AppBackgroundBrush}">

  <Design.DataContext>
    <vm:MainViewModel />
  </Design.DataContext>

  <UserControl.KeyBindings>
    <KeyBinding Gesture="Ctrl+B" Command="{Binding ToggleNavExpandedCommand}"/>
  </UserControl.KeyBindings>



  <!-- Root panel: shows either wide or compact layout -->
  <Panel>

    <!-- ══════════════════════════════════════════════════════
         WIDE / DESKTOP LAYOUT — nav rail + overlay drawer content
    ══════════════════════════════════════════════════════ -->
    <Panel IsVisible="{Binding !IsCompact}">

      <!-- ──────────────────────────────────────────────────
           EXPANDABLE LEFT SIDEBAR / NAVIGATION DRAWER (Overlay)
      ────────────────────────────────────────────────── -->
      <Border Width="{Binding SidebarWidth}"
              HorizontalAlignment="Left"
              VerticalAlignment="Stretch"
              ZIndex="100"
              ClipToBounds="True"
              Background="{DynamicResource AppSurfaceBrush}"
              BorderBrush="{DynamicResource AppBorderBrush}"
              BorderThickness="0,0,1,0"
              BoxShadow="4 0 20 0 #50000000">
        <Border.Transitions>
          <Transitions>
            <DoubleTransition Property="Width" Duration="0:0:0.26" Easing="0.1,0.9,0.2,1.0"/>
          </Transitions>
        </Border.Transitions>

        <Grid Width="240" HorizontalAlignment="Left" RowDefinitions="Auto,*,Auto">

          <!-- ─── HEADER (240px wide) ─── -->
          <Grid Grid.Row="0" ColumnDefinitions="64,*,Auto" Height="64">
            <!-- Wadd Logo Button in left 64px column: toggles expansion when clicked -->
            <Button Grid.Column="0"
                    Classes="icon-btn"
                    Command="{Binding ToggleNavExpandedCommand}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    ToolTip.Tip="Wadd ToDo · Toggle navigation (Ctrl+B)">
              <Image Source="avares://Wadd.UI/Assets/logo.png"
                     Width="28" Height="28"
                     RenderOptions.BitmapInterpolationMode="HighQuality"/>
            </Button>

            <!-- App Title in middle column -->
            <TextBlock Grid.Column="1"
                       Text="Wadd"
                       FontSize="18"
                       FontWeight="Bold"
                       Foreground="{DynamicResource AppTextPrimaryBrush}"
                       VerticalAlignment="Center"/>

            <!-- Collapse Toggle Button on the right -->
            <Button Grid.Column="2"
                    Classes="icon-btn"
                    Command="{Binding ToggleNavExpandedCommand}"
                    Margin="0,0,8,0"
                    VerticalAlignment="Center"
                    ToolTip.Tip="Collapse navigation (Ctrl+B)">
              <PathIcon Data="{StaticResource MenuIconData}" Width="16" Height="16"/>
            </Button>
          </Grid>

          <!-- ─── NAVIGATION ITEMS (Single Unified ListBox) ─── -->
          <ListBox Grid.Row="1"
                   Background="Transparent"
                   BorderThickness="0"
                   SelectedIndex="{Binding SelectedNavIndex}"
                   Padding="4,4">

            <ListBoxItem Classes="nav-unified-item" ToolTip.Tip="Tasks">
              <Grid ColumnDefinitions="56,*,Auto" Height="44">
                <PathIcon Grid.Column="0" Data="{StaticResource CheckListIconData}" Width="19" Height="19" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="Tasks" FontSize="14" VerticalAlignment="Center"/>
                <Border Grid.Column="2"
                        Background="{DynamicResource AppSurfaceElevatedBrush}"
                        CornerRadius="10"
                        Padding="7,2"
                        Margin="0,0,10,0"
                        VerticalAlignment="Center">
                  <TextBlock Text="{Binding TodoItems.Count}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                </Border>
              </Grid>
            </ListBoxItem>

            <ListBoxItem Classes="nav-unified-item" ToolTip.Tip="Completed Tasks">
              <Grid ColumnDefinitions="56,*,Auto" Height="44">
                <PathIcon Grid.Column="0" Data="{StaticResource CheckIconData}" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="Completed" FontSize="14" VerticalAlignment="Center"/>
                <Border Grid.Column="2"
                        Background="{DynamicResource AppSurfaceElevatedBrush}"
                        CornerRadius="10"
                        Padding="7,2"
                        Margin="0,0,10,0"
                        VerticalAlignment="Center">
                  <TextBlock Text="{Binding CompletedHistoryTodoItems.Count}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                </Border>
              </Grid>
            </ListBoxItem>

            <ListBoxItem Classes="nav-unified-item" ToolTip.Tip="Repeating Tasks">
              <Grid ColumnDefinitions="56,*,Auto" Height="44">
                <PathIcon Grid.Column="0" Data="{StaticResource RepeatIconData}" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="Repeating" FontSize="14" VerticalAlignment="Center"/>
                <Border Grid.Column="2"
                        Background="{DynamicResource AppSurfaceElevatedBrush}"
                        CornerRadius="10"
                        Padding="7,2"
                        Margin="0,0,10,0"
                        VerticalAlignment="Center">
                  <TextBlock Text="{Binding AllRecurringTodoItems.Count}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                </Border>
              </Grid>
            </ListBoxItem>

            <ListBoxItem Classes="nav-unified-item" ToolTip.Tip="Calendar">
              <Grid ColumnDefinitions="56,*" Height="44">
                <PathIcon Grid.Column="0" Data="{StaticResource CalendarIconData}" Width="19" Height="19" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="Calendar" FontSize="14" VerticalAlignment="Center"/>
              </Grid>
            </ListBoxItem>

            <ListBoxItem Classes="nav-unified-item" ToolTip.Tip="Settings">
              <Grid ColumnDefinitions="56,*" Height="44">
                <PathIcon Grid.Column="0" Data="{StaticResource SettingsIconData}" Width="19" Height="19" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="Settings" FontSize="14" VerticalAlignment="Center"/>
              </Grid>
            </ListBoxItem>
          </ListBox>

          <!-- Bottom Footer: Collapsed (Width=64 to stay visible in collapsed rail) -->
          <StackPanel Grid.Row="2"
                      IsVisible="{Binding !IsNavExpanded}"
                      Width="64"
                      HorizontalAlignment="Left"
                      Spacing="8"
                      Margin="0,0,0,18">
            <Button Classes="icon-btn"
                    Command="{Binding ToggleThemeCommand}"
                    HorizontalAlignment="Center">
              <Panel>
                <PathIcon Data="{StaticResource MoonIconData}" Width="16" Height="16" IsVisible="{Binding !IsDarkMode}" ToolTip.Tip="Switch to Dark Mode"/>
                <PathIcon Data="{StaticResource SunIconData}" Width="16" Height="16" IsVisible="{Binding IsDarkMode}" ToolTip.Tip="Switch to Light Mode"/>
              </Panel>
            </Button>
            <Button Classes="icon-btn"
                    Command="{Binding SyncCommand}"
                    IsEnabled="{Binding !IsSyncing}"
                    HorizontalAlignment="Center"
                    ToolTip.Tip="Sync Cloud">
              <PathIcon Data="{StaticResource SyncIconData}" Width="16" Height="16"/>
            </Button>
            <!-- Status indicator dot -->
            <Ellipse Width="6" Height="6"
                     HorizontalAlignment="Center"
                     Fill="{DynamicResource AppAccentSuccessBrush}"
                     IsVisible="{Binding !IsSyncing}"
                     ToolTip.Tip="{Binding StorageStatusText}"/>
            <Ellipse Width="6" Height="6"
                     HorizontalAlignment="Center"
                     Fill="{DynamicResource AppPrimaryBrush}"
                     IsVisible="{Binding IsSyncing}"
                     ToolTip.Tip="Syncing…"/>
          </StackPanel>

          <Border Grid.Row="2"
                  IsVisible="{Binding IsNavExpanded}"
                  Margin="10,0,10,16"
                  Padding="12,10"
                  Background="{DynamicResource AppSurfaceElevatedBrush}"
                  BorderBrush="{DynamicResource AppBorderBrush}"
                  BorderThickness="1"
                  CornerRadius="10">
            <StackPanel Spacing="10">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                  <TextBlock Text="STORAGE &amp; SYNC" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource AppPrimaryBrush}"/>
                  <TextBlock Text="Local Storage Mode" IsVisible="{Binding !IsGoogleSignedIn}" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                  <TextBlock Text="{Binding GoogleUserEmail}" IsVisible="{Binding IsGoogleSignedIn}" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource AppTextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Text="{Binding LastUpdatedFormatted}" FontSize="10" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                </StackPanel>
                <Button Grid.Column="1"
                        Classes="icon-btn"
                        Command="{Binding ToggleThemeCommand}"
                        VerticalAlignment="Center">
                  <Panel>
                    <PathIcon Data="{StaticResource MoonIconData}" Width="14" Height="14" IsVisible="{Binding !IsDarkMode}" ToolTip.Tip="Switch to Dark Mode"/>
                    <PathIcon Data="{StaticResource SunIconData}" Width="14" Height="14" IsVisible="{Binding IsDarkMode}" ToolTip.Tip="Switch to Light Mode"/>
                  </Panel>
                </Button>
              </Grid>
              <Button Classes="outline"
                      Command="{Binding SyncCommand}"
                      IsEnabled="{Binding !IsSyncing}"
                      HorizontalAlignment="Stretch">
                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                  <PathIcon Data="{StaticResource SyncIconData}" Width="13" Height="13"/>
                  <TextBlock Text="Sync Cloud" IsVisible="{Binding !IsSyncing}" FontSize="12" FontWeight="SemiBold"/>
                  <TextBlock Text="Syncing..." IsVisible="{Binding IsSyncing}" FontSize="12" FontWeight="SemiBold"/>
                </StackPanel>
              </Button>
            </StackPanel>
          </Border>

        </Grid>
      </Border>

      <!-- ──────────────────────────────────────────────────
           MAIN CONTENT AREA
      ────────────────────────────────────────────────── -->
      <Panel Margin="64,0,0,0">

        <!-- ─── Sidebar scrim: fades over content when drawer is expanded ─── -->
        <Border ZIndex="50"
                Background="#55000000"
                IsHitTestVisible="{Binding IsNavExpanded}"
                Opacity="{Binding ScrimOpacity}"
                PointerPressed="OnScrimPressed">
          <Border.Transitions>
            <Transitions>
              <DoubleTransition Property="Opacity" Duration="0:0:0.26" Easing="0.1,0.9,0.2,1.0"/>
            </Transitions>
          </Border.Transitions>
        </Border>

        <!-- ─── Sync progress bar (top edge, 2px line) ─── -->
        <ProgressBar IsIndeterminate="True"
                     IsVisible="{Binding IsSyncing}"
                     Height="2"
                     VerticalAlignment="Top"
                     HorizontalAlignment="Stretch"
                     Foreground="{DynamicResource AppPrimaryBrush}"
                     Background="Transparent"/>

        <!-- ═══ TAB 0: TASKS VIEW ═══ -->
        <views:TasksView IsVisible="{Binding IsTasksView}"/>

        <!-- ═══ TAB 1: COMPLETED TASKS VIEW ═══ -->
        <views:CompletedTasksView IsVisible="{Binding IsCompletedView}"/>

        <!-- ═══ TAB 2: RECURRING TASKS VIEW ═══ -->
        <views:RecurringTasksView IsVisible="{Binding IsRecurringView}"/>

        <!-- ═══ TAB 3: CALENDAR VIEW ═══ -->
        <views:CalendarView IsVisible="{Binding IsCalendarView}"/>

        <!-- ═══ TAB 4: SETTINGS VIEW ═══ -->
        <views:SettingsView IsVisible="{Binding IsSettingsView}"/>

        <!-- ═══ SMALL POST-SYNC PROMPT DIALOG ═══ -->
        <Border IsVisible="{Binding IsReviewPromptVisible}"
                Background="#A0000000"
                ZIndex="1000">
          <Border Background="{DynamicResource AppSurfaceBrush}"
                  BorderBrush="{DynamicResource AppBorderBrush}"
                  BorderThickness="1"
                  CornerRadius="16"
                  Padding="28,24"
                  MaxWidth="440"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center">
            <StackPanel Spacing="16">
              <StackPanel Spacing="4">
                <TextBlock Text="Task Updates Available" FontSize="18" FontWeight="Bold"/>
                <TextBlock Text="Some of your tasks were updated on another device." FontSize="13" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                <TextBlock Text="{Binding UnresolvedConflictCount, StringFormat='We found {0} items that need your review.'}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Margin="0,4,0,0"/>
              </StackPanel>

              <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button Classes="outline" Command="{Binding ReviewLaterCommand}" Padding="16,8">
                  <TextBlock Text="Review Later" FontSize="12"/>
                </Button>
                <Button Classes="primary" Command="{Binding ReviewNowCommand}" Padding="18,8">
                  <TextBlock Text="Review Now" FontSize="12" FontWeight="Bold"/>
                </Button>
              </StackPanel>
            </StackPanel>
          </Border>
        </Border>

        <!-- ═══ MOBILE / ANDROID TASK REVIEW WIZARD OVERLAY ═══ -->
        <Border IsVisible="{Binding IsTaskWizardVisible}"
                Background="#B0000000"
                ZIndex="999">
          <Border Background="{DynamicResource AppSurfaceBrush}"
                  CornerRadius="16"
                  Margin="16"
                  Padding="0"
                  ClipToBounds="True">
            <views:TaskConflictView DataContext="{Binding TaskConflictVm}"/>
          </Border>
        </Border>

        <!-- Floating Historical Status Toast Stack (Desktop) -->
        <ItemsControl ItemsSource="{Binding StatusNotifications}"
                      VerticalAlignment="Bottom"
                      HorizontalAlignment="Right"
                      Margin="0,0,32,24">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:NotificationBubbleItem">
              <Border Margin="0,4,0,4"
                      Padding="14,8"
                      Background="{DynamicResource AppSurfaceElevatedBrush}"
                      BorderBrush="{DynamicResource AppBorderBrush}"
                      BorderThickness="1"
                      CornerRadius="18"
                      Opacity="{Binding Opacity}"
                      HorizontalAlignment="Right">
                <Border.Transitions>
                  <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.4"/>
                  </Transitions>
                </Border.Transitions>
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                  <Ellipse Width="7" Height="7" Fill="{DynamicResource AppPrimaryBrush}" VerticalAlignment="Center"/>
                  <TextBlock Text="{Binding Message}"
                             FontSize="12"
                             FontWeight="Medium"
                             Foreground="{DynamicResource AppTextPrimaryBrush}"
                             VerticalAlignment="Center"/>
                  <TextBlock Text="{Binding Timestamp}"
                             FontSize="10"
                             Foreground="{DynamicResource AppTextSecondaryBrush}"
                             VerticalAlignment="Center"
                             Margin="4,0,0,0"/>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

      </Panel>
    </Panel>

    <!-- ══════════════════════════════════════════════════════
         COMPACT / MOBILE LAYOUT — full height + bottom tab bar
    ══════════════════════════════════════════════════════ -->
    <Grid IsVisible="{Binding IsCompact}" RowDefinitions="*,Auto">

      <!-- Compact content views -->
      <Panel Grid.Row="0">

        <!-- Compact Tasks View -->
        <views:TasksView IsVisible="{Binding IsTasksView}"/>

        <!-- Compact Completed View -->
        <views:CompletedTasksView IsVisible="{Binding IsCompletedView}"/>

        <!-- Compact Recurring View -->
        <views:RecurringTasksView IsVisible="{Binding IsRecurringView}"/>

        <!-- Compact Calendar View -->
        <views:CalendarView IsVisible="{Binding IsCalendarView}"/>

        <!-- Compact Settings View -->
        <views:SettingsView IsVisible="{Binding IsSettingsView}"/>

        <!-- Floating Historical Status Toast Stack (Compact) -->
        <ItemsControl ItemsSource="{Binding StatusNotifications}"
                      VerticalAlignment="Bottom"
                      HorizontalAlignment="Center"
                      Margin="0,0,0,16">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:NotificationBubbleItem">
              <Border Margin="0,3,0,3"
                      Padding="12,6"
                      Background="{DynamicResource AppSurfaceElevatedBrush}"
                      BorderBrush="{DynamicResource AppBorderBrush}"
                      BorderThickness="1"
                      CornerRadius="14"
                      Opacity="{Binding Opacity}"
                      HorizontalAlignment="Center">
                <Border.Transitions>
                  <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.4"/>
                  </Transitions>
                </Border.Transitions>
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                  <Ellipse Width="6" Height="6" Fill="{DynamicResource AppPrimaryBrush}" VerticalAlignment="Center"/>
                  <TextBlock Text="{Binding Message}"
                             FontSize="11"
                             FontWeight="Medium"
                             Foreground="{DynamicResource AppTextPrimaryBrush}"
                             VerticalAlignment="Center"/>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Compact side drawer overlay (retained for compat) -->
        <Grid IsVisible="{Binding IsSideMenuOpen}" Background="#80000000">
          <Border HorizontalAlignment="Left"
                  Width="272"
                  Background="{DynamicResource AppSurfaceBrush}"
                  BorderBrush="{DynamicResource AppBorderBrush}"
                  BorderThickness="0,0,1,0"
                  Padding="20">
            <Grid RowDefinitions="Auto,*">
              <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,20">
                <TextBlock Grid.Column="0" Text="Navigation" Classes="heading" VerticalAlignment="Center"/>
                <Button Grid.Column="1"
                        Classes="ghost"
                        Command="{Binding CloseSideMenuCommand}"
                        Padding="6">
                  <PathIcon Data="{StaticResource CloseIconData}"
                            Width="14" Height="14"
                            Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                </Button>
              </Grid>
              <ListBox Grid.Row="1"
                       Background="Transparent"
                       SelectedIndex="{Binding SelectedNavIndex}">
                <ListBoxItem Classes="side-menu-item">
                  <StackPanel Orientation="Horizontal" Spacing="12">
                    <PathIcon Data="{StaticResource CheckListIconData}" Width="17" Height="17"/>
                    <TextBlock Text="Tasks" VerticalAlignment="Center"/>
                  </StackPanel>
                </ListBoxItem>
                <ListBoxItem Classes="side-menu-item">
                  <StackPanel Orientation="Horizontal" Spacing="12">
                    <PathIcon Data="{StaticResource CheckIconData}" Width="15" Height="15"/>
                    <TextBlock Text="Completed" VerticalAlignment="Center"/>
                  </StackPanel>
                </ListBoxItem>
                <ListBoxItem Classes="side-menu-item">
                  <StackPanel Orientation="Horizontal" Spacing="12">
                    <PathIcon Data="{StaticResource RepeatIconData}" Width="15" Height="15"/>
                    <TextBlock Text="Recurring" VerticalAlignment="Center"/>
                  </StackPanel>
                </ListBoxItem>
                <ListBoxItem Classes="side-menu-item">
                  <StackPanel Orientation="Horizontal" Spacing="12">
                    <PathIcon Data="{StaticResource CalendarIconData}" Width="17" Height="17"/>
                    <TextBlock Text="Calendar" VerticalAlignment="Center"/>
                  </StackPanel>
                </ListBoxItem>
                <ListBoxItem Classes="side-menu-item">
                  <StackPanel Orientation="Horizontal" Spacing="12">
                    <PathIcon Data="{StaticResource SettingsIconData}" Width="17" Height="17"/>
                    <TextBlock Text="Settings" VerticalAlignment="Center"/>
                  </StackPanel>
                </ListBoxItem>
              </ListBox>
            </Grid>
          </Border>
        </Grid>

      </Panel>

      <!-- ── Bottom Tab Bar ── -->
      <Border Grid.Row="1"
              Background="{DynamicResource AppSurfaceBrush}"
              BorderBrush="{DynamicResource AppBorderBrush}"
              BorderThickness="0,1,0,0">
        <ListBox Background="Transparent"
                 BorderThickness="0"
                 SelectedIndex="{Binding SelectedNavIndex}">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Rows="1"/>
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBoxItem Classes="tab-item">
            <StackPanel Spacing="4" HorizontalAlignment="Center">
              <PathIcon Data="{StaticResource CheckListIconData}" Width="18" Height="18" HorizontalAlignment="Center"/>
              <TextBlock Text="Tasks" FontSize="10" FontWeight="Medium" HorizontalAlignment="Center"/>
            </StackPanel>
          </ListBoxItem>
          <ListBoxItem Classes="tab-item">
            <StackPanel Spacing="4" HorizontalAlignment="Center">
              <PathIcon Data="{StaticResource CheckIconData}" Width="16" Height="16" HorizontalAlignment="Center"/>
              <TextBlock Text="Done" FontSize="10" FontWeight="Medium" HorizontalAlignment="Center"/>
            </StackPanel>
          </ListBoxItem>
          <ListBoxItem Classes="tab-item">
            <StackPanel Spacing="4" HorizontalAlignment="Center">
              <PathIcon Data="{StaticResource RepeatIconData}" Width="16" Height="16" HorizontalAlignment="Center"/>
              <TextBlock Text="Repeat" FontSize="10" FontWeight="Medium" HorizontalAlignment="Center"/>
            </StackPanel>
          </ListBoxItem>
          <ListBoxItem Classes="tab-item">
            <StackPanel Spacing="4" HorizontalAlignment="Center">
              <PathIcon Data="{StaticResource CalendarIconData}" Width="18" Height="18" HorizontalAlignment="Center"/>
              <TextBlock Text="Calendar" FontSize="10" FontWeight="Medium" HorizontalAlignment="Center"/>
            </StackPanel>
          </ListBoxItem>
          <ListBoxItem Classes="tab-item">
            <StackPanel Spacing="4" HorizontalAlignment="Center">
              <PathIcon Data="{StaticResource SettingsIconData}" Width="18" Height="18" HorizontalAlignment="Center"/>
              <TextBlock Text="Settings" FontSize="10" FontWeight="Medium" HorizontalAlignment="Center"/>
            </StackPanel>
          </ListBoxItem>
        </ListBox>
      </Border>

    </Grid>

    <!-- ══════════════════════════════════════════════════════
         MOBILE FLOATING TASK COMPOSER MODAL (Bottom Sheet)
    ══════════════════════════════════════════════════════ -->
    <Border IsVisible="{Binding IsMobileTaskComposerOpen}"
            Background="#90000000"
            ZIndex="2000">
      <Panel>
        <!-- Background Scrim (Tapping closes modal) -->
        <Border Background="Transparent" PointerPressed="OnMobileComposerBackgroundPressed"/>

        <Border VerticalAlignment="Bottom"
                HorizontalAlignment="Stretch"
                Background="{DynamicResource AppSurfaceBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="0,1,0,0"
                CornerRadius="24,24,0,0"
                Padding="24,16,24,24"
                BoxShadow="0 -8 32 0 #50000000">
          <StackPanel Spacing="16">

            <!-- Drag Handle & Close Row -->
            <Grid ColumnDefinitions="*,Auto">
              <Border Grid.Column="0"
                      Width="36" Height="4"
                      CornerRadius="2"
                      Background="{DynamicResource AppTextSecondaryBrush}"
                      Opacity="0.4"
                      HorizontalAlignment="Center"/>
              <Button Grid.Column="1"
                      Classes="ghost"
                      Command="{Binding CloseMobileTaskComposerCommand}"
                      Padding="6">
                <PathIcon Data="{StaticResource CloseIconData}" Width="14" Height="14"/>
              </Button>
            </Grid>

            <TextBlock Text="New Task" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimaryBrush}"/>

            <!-- Task Title Input -->
            <TextBox Classes="composer"
                     PlaceholderText="What do you need to do?"
                     Text="{Binding NewTaskTitle, Mode=TwoWay}"
                     FontSize="18"
                     FontWeight="SemiBold"
                     Padding="0,6">
              <TextBox.KeyBindings>
                <KeyBinding Gesture="Enter" Command="{Binding AddTaskCommand}"/>
              </TextBox.KeyBindings>
            </TextBox>

            <!-- Task Description Input -->
            <TextBox Classes="composer"
                     PlaceholderText="Add details or context… (optional)"
                     Text="{Binding NewTaskDescription, Mode=TwoWay}"
                     FontSize="13"
                     Padding="0,4"
                     AcceptsReturn="True"
                     MaxHeight="80"
                     TextWrapping="Wrap"/>

            <!-- Active Chips Preview Row -->
            <WrapPanel Orientation="Horizontal" Margin="0,4,0,4">
              <!-- Selected Due Date Chip -->
              <Border IsVisible="{Binding HasNewTaskDueDate}"
                      Background="{DynamicResource AppPrimarySubtleBrush}"
                      BorderBrush="{DynamicResource AppPrimaryBrush}"
                      BorderThickness="1"
                      CornerRadius="10"
                      Padding="7,3"
                      Margin="0,0,5,5">
                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                  <PathIcon Data="{StaticResource CalendarIconData}" Width="10" Height="10" Foreground="{DynamicResource AppPrimaryBrush}" VerticalAlignment="Center"/>
                  <TextBlock Text="{Binding NewTaskDueDateFormatted}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppPrimaryBrush}" VerticalAlignment="Center"/>
                  <Button Command="{Binding ClearDueDateCommand}" Classes="ghost" Padding="0" Width="14" Height="14" VerticalAlignment="Center" VerticalContentAlignment="Center">
                    <PathIcon Data="{StaticResource CloseIconData}" Width="9" Height="9" Foreground="{DynamicResource AppPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Button>
                </StackPanel>
              </Border>

              <!-- Selected Reminder Chip -->
              <Border IsVisible="{Binding HasNewTaskReminder}"
                      Background="{DynamicResource AppPrimarySubtleBrush}"
                      BorderBrush="{DynamicResource AppPrimaryBrush}"
                      BorderThickness="1"
                      CornerRadius="10"
                      Padding="7,3"
                      Margin="0,0,5,5">
                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                  <PathIcon Data="{StaticResource BellIconData}" Width="10" Height="10" Foreground="{DynamicResource AppPrimaryBrush}" VerticalAlignment="Center"/>
                  <TextBlock Text="{Binding NewTaskReminderFormatted}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppPrimaryBrush}" VerticalAlignment="Center"/>
                  <Button Command="{Binding ClearReminderCommand}" Classes="ghost" Padding="0" Width="14" Height="14" VerticalAlignment="Center" VerticalContentAlignment="Center">
                    <PathIcon Data="{StaticResource CloseIconData}" Width="9" Height="9" Foreground="{DynamicResource AppPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Button>
                </StackPanel>
              </Border>

              <!-- Selected Recurrence Chip -->
              <Border IsVisible="{Binding HasNewTaskRecurrence}"
                      Background="{DynamicResource AppPrimarySubtleBrush}"
                      BorderBrush="{DynamicResource AppPrimaryBrush}"
                      BorderThickness="1"
                      CornerRadius="10"
                      Padding="7,3"
                      Margin="0,0,5,5">
                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                  <PathIcon Data="{StaticResource RepeatIconData}" Width="10" Height="10" Foreground="{DynamicResource AppPrimaryBrush}" VerticalAlignment="Center"/>
                  <TextBlock Text="{Binding NewTaskRecurrenceFormatted}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppPrimaryBrush}" VerticalAlignment="Center"/>
                  <Button Command="{Binding ClearRecurrenceCommand}" Classes="ghost" Padding="0" Width="14" Height="14" VerticalAlignment="Center" VerticalContentAlignment="Center">
                    <PathIcon Data="{StaticResource CloseIconData}" Width="9" Height="9" Foreground="{DynamicResource AppPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Button>
                </StackPanel>
              </Border>
            </WrapPanel>

            <!-- Bottom Action Row: Date, Reminder, Repeat buttons -->
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
              <Button Classes="outline"
                      Command="{Binding OpenMobileDueDateSheetCommand}"
                      Padding="12,7"
                      CornerRadius="16"
                      ToolTip.Tip="Set due date">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                  <PathIcon Data="{StaticResource CalendarIconData}" Width="13" Height="13" Foreground="{DynamicResource AppPrimaryBrush}" VerticalAlignment="Center"/>
                  <TextBlock Text="Due Date" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>

              <Button Classes="outline"
                      Command="{Binding OpenMobileReminderSheetCommand}"
                      Padding="12,7"
                      CornerRadius="16"
                      ToolTip.Tip="Set reminder">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                  <PathIcon Data="{StaticResource BellIconData}" Width="13" Height="13" Foreground="{DynamicResource AppPrimaryBrush}" VerticalAlignment="Center"/>
                  <TextBlock Text="Reminder" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>

              <Button Classes="outline"
                      Command="{Binding OpenMobileRepeatSheetCommand}"
                      Padding="12,7"
                      CornerRadius="16"
                      ToolTip.Tip="Set recurrence">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                  <PathIcon Data="{StaticResource RepeatIconData}" Width="13" Height="13" Foreground="{DynamicResource AppPrimaryBrush}" VerticalAlignment="Center"/>
                  <TextBlock Text="Repeat" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
            </StackPanel>

            <!-- Save Task Button Row (New Line, Right Aligned) -->
            <Button Classes="primary"
                    Command="{Binding AddTaskCommand}"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0"
                    Padding="22,10"
                    CornerRadius="20">
              <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <PathIcon Data="{StaticResource PlusIconData}" Width="13" Height="13" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                <TextBlock Text="Add Task" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>

          </StackPanel>
        </Border>
      </Panel>
    </Border>

    <!-- ══════════════════════════════════════════════════════
         MOBILE DUE DATE SELECTION FLOATING DIALOG
    ══════════════════════════════════════════════════════ -->
    <Border IsVisible="{Binding IsMobileDueDateSheetOpen}"
            Background="#A0000000"
            ZIndex="2100">
      <Panel>
        <Border Background="Transparent" PointerPressed="OnMobileDueDateBackgroundPressed"/>

        <Border VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Width="310"
                Margin="16"
                Background="{DynamicResource AppSurfaceBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                ClipToBounds="True"
                BoxShadow="0 12 40 0 #A0000000">
          <StackPanel Spacing="0">
            <!-- Header Banner -->
            <Border Background="{DynamicResource AppSurfaceElevatedBrush}" Padding="16,10,16,12">
              <StackPanel Spacing="2">
                <TextBlock Text="{Binding DueDateHeaderYear}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                <TextBlock Text="{Binding DueDateHeaderMainText}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimaryBrush}" TextWrapping="Wrap"/>
              </StackPanel>
            </Border>

            <!-- Calendar Picker -->
            <Border Padding="4,4" MinHeight="260" HorizontalAlignment="Center" VerticalAlignment="Center">
              <Calendar SelectedDate="{Binding NewTaskDueDate, Mode=TwoWay}"
                        DisplayDateStart="{Binding MinDueDate}"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="0"
                        Margin="0"
                        HorizontalAlignment="Center"/>
            </Border>

            <Separator Classes="divider" Margin="0"/>

            <!-- Action Buttons Footer -->
            <Border Padding="12,8" Background="{DynamicResource AppSurfaceBrush}">
              <Grid ColumnDefinitions="*,Auto">
                <Button Grid.Column="0" Classes="ghost" Command="{Binding ClearDueDateCommand}" HorizontalAlignment="Left" Padding="8,6">
                  <TextBlock Text="CLEAR" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                </Button>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                  <Button Classes="ghost" Command="{Binding CloseMobileDueDateSheetCommand}" Padding="8,6">
                    <TextBlock Text="CANCEL" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                  </Button>
                  <Button Classes="ghost" Command="{Binding CloseMobileDueDateSheetCommand}" Padding="8,6">
                    <TextBlock Text="SAVE" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AppPrimaryBrush}"/>
                  </Button>
                </StackPanel>
              </Grid>
            </Border>
          </StackPanel>
        </Border>
      </Panel>
    </Border>

    <!-- ══════════════════════════════════════════════════════
         MOBILE REMINDER SELECTION FLOATING DIALOG
    ══════════════════════════════════════════════════════ -->
    <Border IsVisible="{Binding IsMobileReminderSheetOpen}"
            Background="#A0000000"
            ZIndex="2100">
      <Panel>
        <Border Background="Transparent" PointerPressed="OnMobileReminderBackgroundPressed"/>

        <Border VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Width="310"
                Margin="16"
                Background="{DynamicResource AppSurfaceBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                ClipToBounds="True"
                BoxShadow="0 12 40 0 #A0000000">
          <StackPanel Spacing="0">
            <!-- 1. Tabs Header (DATE | TIME) -->
            <Grid ColumnDefinitions="*,*" Background="{DynamicResource AppSurfaceElevatedBrush}">
              <!-- DATE Tab -->
              <Button Grid.Column="0"
                      Classes="ghost"
                      Command="{Binding SelectReminderDateTabCommand}"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Stretch"
                      Padding="0"
                      CornerRadius="0">
                <Grid RowDefinitions="Auto,Auto" HorizontalAlignment="Stretch" Margin="0,10,0,0">
                  <TextBlock Grid.Row="0"
                             Text="DATE"
                             FontSize="12"
                             FontWeight="Bold"
                             HorizontalAlignment="Center"
                             Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                  <Border Grid.Row="1"
                          Height="2"
                          Width="44"
                          Margin="0,6,0,0"
                          HorizontalAlignment="Center"
                          Background="{DynamicResource AppPrimaryBrush}"
                          IsVisible="{Binding IsReminderDateTabSelected}"/>
                </Grid>
              </Button>

              <!-- TIME Tab -->
              <Button Grid.Column="1"
                      Classes="ghost"
                      Command="{Binding SelectReminderTimeTabCommand}"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Stretch"
                      Padding="0"
                      CornerRadius="0">
                <Grid RowDefinitions="Auto,Auto" HorizontalAlignment="Stretch" Margin="0,10,0,0">
                  <TextBlock Grid.Row="0"
                             Text="TIME"
                             FontSize="12"
                             FontWeight="Bold"
                             HorizontalAlignment="Center"
                             Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                  <Border Grid.Row="1"
                          Height="2"
                          Width="44"
                          Margin="0,6,0,0"
                          HorizontalAlignment="Center"
                          Background="{DynamicResource AppPrimaryBrush}"
                          IsVisible="{Binding IsReminderTimeTabSelected}"/>
                </Grid>
              </Button>
            </Grid>

            <!-- 2. Big Date/Time Header Banner -->
            <Border Background="{DynamicResource AppSurfaceElevatedBrush}" Padding="16,10,16,12">
              <StackPanel Spacing="2">
                <TextBlock Text="{Binding ReminderHeaderYear}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                <TextBlock Text="{Binding ReminderHeaderMainText}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimaryBrush}" TextWrapping="Wrap"/>
              </StackPanel>
            </Border>

            <!-- 3. Tab Contents -->
            <!-- DATE Tab Content -->
            <Border IsVisible="{Binding IsReminderDateTabSelected}" Padding="4,4" MinHeight="260" HorizontalAlignment="Center" VerticalAlignment="Center">
              <Calendar SelectedDate="{Binding NewTaskReminderDate, Mode=TwoWay}"
                        DisplayDateStart="{Binding MinDueDate}"
                        DisplayDateEnd="{Binding NewTaskDueDate}"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="0"
                        Margin="0"
                        HorizontalAlignment="Center"/>
            </Border>

            <!-- TIME Tab Content -->
            <Border IsVisible="{Binding IsReminderTimeTabSelected}" Padding="14,12" MinHeight="260">
              <StackPanel Spacing="10" VerticalAlignment="Center">
                <TextBlock Text="TIME PRESETS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                <UniformGrid Columns="2" Rows="2">
                  <Button Classes="ghost"
                          Command="{Binding SetReminderPresetMorningCommand}"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Margin="3"
                          Padding="8,10"
                          Background="{DynamicResource AppSurfaceElevatedBrush}"
                          BorderBrush="{DynamicResource AppBorderBrush}"
                          BorderThickness="1"
                          CornerRadius="8">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="2">
                      <TextBlock Text="09:00" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{DynamicResource AppPrimaryBrush}"/>
                      <TextBlock Text="Morning" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                    </StackPanel>
                  </Button>

                  <Button Classes="ghost"
                          Command="{Binding SetReminderPresetAfternoonCommand}"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Margin="3"
                          Padding="8,10"
                          Background="{DynamicResource AppSurfaceElevatedBrush}"
                          BorderBrush="{DynamicResource AppBorderBrush}"
                          BorderThickness="1"
                          CornerRadius="8">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="2">
                      <TextBlock Text="13:00" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{DynamicResource AppPrimaryBrush}"/>
                      <TextBlock Text="Afternoon" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                    </StackPanel>
                  </Button>

                  <Button Classes="ghost"
                          Command="{Binding SetReminderPresetEveningCommand}"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Margin="3"
                          Padding="8,10"
                          Background="{DynamicResource AppSurfaceElevatedBrush}"
                          BorderBrush="{DynamicResource AppBorderBrush}"
                          BorderThickness="1"
                          CornerRadius="8">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="2">
                      <TextBlock Text="17:00" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{DynamicResource AppPrimaryBrush}"/>
                      <TextBlock Text="Evening" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                    </StackPanel>
                  </Button>

                  <Button Classes="ghost"
                          Command="{Binding SetReminderPresetNightCommand}"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Margin="3"
                          Padding="8,10"
                          Background="{DynamicResource AppSurfaceElevatedBrush}"
                          BorderBrush="{DynamicResource AppBorderBrush}"
                          BorderThickness="1"
                          CornerRadius="8">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="2">
                      <TextBlock Text="20:00" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{DynamicResource AppPrimaryBrush}"/>
                      <TextBlock Text="Night" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                    </StackPanel>
                  </Button>
                </UniformGrid>

                <Separator Classes="divider" Margin="0,2"/>

                <TextBlock Text="CUSTOM TIME" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                <TimePicker Classes="no-clock"
                            SelectedTime="{Binding NewTaskReminderTime, Mode=TwoWay}"
                            ClockIdentifier="24HourClock"
                            HorizontalAlignment="Stretch"/>
              </StackPanel>
            </Border>

            <Separator Classes="divider" Margin="0"/>

            <!-- 4. Footer Action Buttons (CANCEL / SAVE) -->
            <Border Padding="12,8" Background="{DynamicResource AppSurfaceBrush}">
              <Grid ColumnDefinitions="*,Auto">
                <Button Grid.Column="0" Classes="ghost" Command="{Binding ClearReminderCommand}" HorizontalAlignment="Left" Padding="8,6">
                  <TextBlock Text="CLEAR" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                </Button>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                  <Button Classes="ghost" Command="{Binding CloseMobileReminderSheetCommand}" Padding="8,6">
                    <TextBlock Text="CANCEL" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                  </Button>
                  <Button Classes="ghost" Command="{Binding CloseMobileReminderSheetCommand}" Padding="8,6">
                    <TextBlock Text="SAVE" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AppPrimaryBrush}"/>
                  </Button>
                </StackPanel>
              </Grid>
            </Border>
          </StackPanel>
        </Border>
      </Panel>
    </Border>

    <!-- ══════════════════════════════════════════════════════
         MOBILE REPEAT SELECTION BOTTOM SHEET
    ══════════════════════════════════════════════════════ -->
    <Border IsVisible="{Binding IsMobileRepeatSheetOpen}"
            Background="#90000000"
            ZIndex="2100">
      <Panel>
        <Border Background="Transparent" PointerPressed="OnMobileRepeatBackgroundPressed"/>

        <Border VerticalAlignment="Bottom"
                HorizontalAlignment="Stretch"
                Background="{DynamicResource AppSurfaceBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="0,1,0,0"
                CornerRadius="24,24,0,0"
                Padding="24,16,24,24"
                BoxShadow="0 -8 32 0 #50000000">
          <StackPanel Spacing="14">
            <!-- Fixed Header -->
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Grid.Column="0" Text="Repeat Frequency" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimaryBrush}"/>
              <Button Grid.Column="1" Classes="ghost" Command="{Binding CloseMobileRepeatSheetCommand}" Padding="6">
                <PathIcon Data="{StaticResource CloseIconData}" Width="14" Height="14"/>
              </Button>
            </Grid>

            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="380" Padding="0,0,8,0">
              <StackPanel Spacing="10">
                <Button Classes="ghost" Command="{Binding SetRecurrenceTypeCommand}" CommandParameter="Daily" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12,10">
                  <StackPanel Orientation="Horizontal" Spacing="12">
                    <PathIcon Data="{StaticResource RepeatIconData}" Width="16" Height="16" Foreground="{DynamicResource AppPrimaryBrush}"/>
                    <TextBlock Text="Daily" FontSize="14" FontWeight="SemiBold"/>
                  </StackPanel>
                </Button>
                <Button Classes="ghost" Command="{Binding SetRecurrenceTypeCommand}" CommandParameter="Weekdays" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12,10">
                  <StackPanel Orientation="Horizontal" Spacing="12">
                    <PathIcon Data="{StaticResource RepeatIconData}" Width="16" Height="16" Foreground="{DynamicResource AppPrimaryBrush}"/>
                    <TextBlock Text="Weekdays" FontSize="14" FontWeight="SemiBold"/>
                  </StackPanel>
                </Button>
                <Button Classes="ghost" Command="{Binding SetRecurrenceTypeCommand}" CommandParameter="Weekly" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12,10">
                  <StackPanel Orientation="Horizontal" Spacing="12">
                    <PathIcon Data="{StaticResource RepeatIconData}" Width="16" Height="16" Foreground="{DynamicResource AppPrimaryBrush}"/>
                    <TextBlock Text="Weekly" FontSize="14" FontWeight="SemiBold"/>
                  </StackPanel>
                </Button>
                <Button Classes="ghost" Command="{Binding SetRecurrenceTypeCommand}" CommandParameter="Monthly" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12,10">
                  <StackPanel Orientation="Horizontal" Spacing="12">
                    <PathIcon Data="{StaticResource RepeatIconData}" Width="16" Height="16" Foreground="{DynamicResource AppPrimaryBrush}"/>
                    <TextBlock Text="Monthly" FontSize="14" FontWeight="SemiBold"/>
                  </StackPanel>
                </Button>
                <Button Classes="ghost" Command="{Binding SetRecurrenceTypeCommand}" CommandParameter="Yearly" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12,10">
                  <StackPanel Orientation="Horizontal" Spacing="12">
                    <PathIcon Data="{StaticResource RepeatIconData}" Width="16" Height="16" Foreground="{DynamicResource AppPrimaryBrush}"/>
                    <TextBlock Text="Yearly" FontSize="14" FontWeight="SemiBold"/>
                  </StackPanel>
                </Button>

                <Separator Classes="divider" Margin="0,4"/>

                <Button Classes="ghost" Command="{Binding SetRecurrenceTypeCommand}" CommandParameter="Custom" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12,10">
                  <StackPanel Orientation="Horizontal" Spacing="12">
                    <PathIcon Data="{StaticResource SettingsIconData}" Width="16" Height="16" Foreground="{DynamicResource AppPrimaryBrush}"/>
                    <TextBlock Text="Custom Schedule…" FontSize="14" FontWeight="SemiBold"/>
                  </StackPanel>
                </Button>

                <!-- Custom Recurrence Expansion -->
                <StackPanel IsVisible="{Binding IsCustomRecurrenceVisible}" Spacing="8" Margin="0,4,0,0">
                  <Grid ColumnDefinitions="*,12,*">
                    <StackPanel Grid.Column="0" Spacing="4">
                      <TextBlock Text="Every" FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                      <NumericUpDown Minimum="1" Maximum="365" Value="{Binding CustomInterval, Mode=TwoWay}" FormatString="0" HorizontalAlignment="Stretch"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="4">
                      <TextBlock Text="Unit" FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                      <ComboBox ItemsSource="{Binding CustomUnitOptions}"
                                SelectedItem="{Binding SelectedCustomUnit, Mode=TwoWay}"
                                HorizontalAlignment="Stretch"/>
                    </StackPanel>
                  </Grid>

                  <StackPanel IsVisible="{Binding IsWeeklyDaysPickerVisible}" Spacing="6" Margin="0,4,0,0">
                    <TextBlock Text="Select Days" FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                    <UniformGrid Columns="7">
                      <ToggleButton Content="M" IsChecked="{Binding IsMondaySelected, Mode=TwoWay}" Padding="0" Height="32" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                      <ToggleButton Content="T" IsChecked="{Binding IsTuesdaySelected, Mode=TwoWay}" Padding="0" Height="32" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                      <ToggleButton Content="W" IsChecked="{Binding IsWednesdaySelected, Mode=TwoWay}" Padding="0" Height="32" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                      <ToggleButton Content="T" IsChecked="{Binding IsThursdaySelected, Mode=TwoWay}" Padding="0" Height="32" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                      <ToggleButton Content="F" IsChecked="{Binding IsFridaySelected, Mode=TwoWay}" Padding="0" Height="32" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                      <ToggleButton Content="S" IsChecked="{Binding IsSaturdaySelected, Mode=TwoWay}" Padding="0" Height="32" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                      <ToggleButton Content="S" IsChecked="{Binding IsSundaySelected, Mode=TwoWay}" Padding="0" Height="32" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                    </UniformGrid>
                  </StackPanel>
                </StackPanel>
              </StackPanel>
            </ScrollViewer>

            <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
              <Button Grid.Column="0" Classes="outline" Command="{Binding ClearRecurrenceCommand}" HorizontalAlignment="Left">
                <TextBlock Text="Clear Repeat" FontSize="12"/>
              </Button>
              <Button Grid.Column="1" Classes="primary" Command="{Binding CloseMobileRepeatSheetCommand}" Padding="20,8" CornerRadius="16">
                <TextBlock Text="Done" FontSize="13" FontWeight="Bold"/>
              </Button>
            </Grid>
          </StackPanel>
        </Border>
      </Panel>
    </Border>

  </Panel>
</UserControl>
