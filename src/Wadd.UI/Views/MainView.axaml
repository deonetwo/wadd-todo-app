441 16.7296 25.5748 17.1376 25.4586 17.5131C24.9198 19.2536 23.9944 20.8492 22.7517 22.1799C22.4849 22.4657 22.0671 22.5518 21.7093 22.3948ZM16.263 22.1966C16.4982 21.4685 16.9889 20.8288 17.6884 20.4238C18.5702 19.9132 19.6536 19.8547 20.5841 20.2627L21.9281 20.8526C22.791 19.8538 23.4593 18.7013 23.8981 17.4552L22.7095 16.5778L22.7086 16.5771C21.898 15.98 21.4 15.0277 21.4 13.9994C21.4 12.9719 21.8974 12.0195 22.7073 11.4227L22.7085 11.4218L23.8957 10.545C23.4567 9.2988 22.7881 8.14636 21.9248 7.1477L20.5922 7.73425L20.5899 7.73527C20.1844 7.91463 19.7472 8.00722 19.3039 8.00663C17.6715 8.00453 16.3046 6.77431 16.1261 5.15465L16.1259 5.15291L15.9635 3.69304C15.3202 3.57328 14.6677 3.50872 14.013 3.50017C13.3389 3.50891 12.6821 3.57367 12.0377 3.69328L11.8751 5.15452C11.7625 6.16272 11.1793 7.05909 10.3019 7.56986C9.41937 8.0856 8.34453 8.14844 7.40869 7.73694L6.07273 7.14893C5.20949 8.14751 4.54092 9.29983 4.10196 10.5459L5.29181 11.4233C6.11115 12.0269 6.59414 12.9837 6.59414 14.0007C6.59414 15.0173 6.11142 15.9742 5.29237 16.5776L4.10161 17.4566C4.54002 18.7044 5.2085 19.8585 6.07205 20.8587L7.41742 20.2682C8.34745 19.8613 9.41573 19.9215 10.2947 20.4292C11.174 20.937 11.7593 21.832 11.8738 22.84L11.8744 22.8445L12.0362 24.3088C13.3326 24.5638 14.6662 24.5638 15.9626 24.3088L16.1247 22.8418C16.1491 22.6217 16.1955 22.4055 16.263 22.1966Z</StreamGeometry>
    <Geometry x:Key="PlusIconData">M12 4a1 1 0 0 1 1 1v6h6a1 1 0 1 1 0 2h-6v6a1 1 0 1 1-2 0v-6H5a1 1 0 1 1 0-2h6V5a1 1 0 0 1 1-1z</Geometry>
    <Geometry x:Key="SparkleIconData">M12 2l2.4 5.6L20 10l-5.6 2.4L12 18l-2.4-5.6L4 10l5.6-2.4z</Geometry>
    <Geometry x:Key="BellIconData">M12 2a5 5 0 0 0-5 5v3.586l-.707.707A1 1 0 0 0 6 13h12a1 1 0 0 0 .707-1.707L18 10.586V7a5 5 0 0 0-5-5zm-3 12a3 3 0 0 0 6 0h-6z</Geometry>
    <Geometry x:Key="ClockIconData">M12 2a10 10 0 1 0 10 10A10 10 0 0 0 12 2zm0 18a8 8 0 1 1 8-8 8 8 0 0 1-8 8zm.5-13h-1a.5.5 0 0 0-.5.5v5.293l3.146 3.147a.5.5 0 0 0 .708-.708L12 11.707V7.5a.5.5 0 0 0-.5-.5z</Geometry>
  </UserControl.Resources>

  <!-- Root panel: shows either wide or compact layout -->
  <Panel>

    <!-- ══════════════════════════════════════════════════════
         WIDE / DESKTOP LAYOUT — nav rail + content area
    ══════════════════════════════════════════════════════ -->
    <Grid IsVisible="{Binding !IsCompact}" ColumnDefinitions="Auto,*">

      <!-- ──────────────────────────────────────────────────
           EXPANDABLE LEFT SIDEBAR / NAVIGATION DRAWER
      ────────────────────────────────────────────────── -->
      <Border Grid.Column="0"
              Width="{Binding SidebarWidth}"
              ClipToBounds="True"
              Background="{DynamicResource AppSurfaceBrush}"
              BorderBrush="{DynamicResource AppBorderBrush}"
              BorderThickness="0,0,1,0">
        <Border.Transitions>
          <Transitions>
            <DoubleTransition Property="Width" Duration="0:0:0.26" Easing="0.1,0.9,0.2,1.0"/>
          </Transitions>
        </Border.Transitions>

        <Grid Width="240" HorizontalAlignment="Left" RowDefinitions="Auto,*,Auto">

          <!-- ─── HEADER (240px wide) ─── -->
          <Grid Grid.Row="0" ColumnDefinitions="64,*,Auto" Height="64">
            <!-- Wadd Logo Button in left 64px column: toggles expansion when clicked -->
            <Button Grid.Column="0"
                    Classes="icon-btn"
                    Command="{Binding ToggleNavExpandedCommand}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    ToolTip.Tip="Wadd ToDo · Toggle navigation (Ctrl+B)">
              <Image Source="avares://Wadd.UI/Assets/logo.png"
                     Width="28" Height="28"
                     RenderOptions.BitmapInterpolationMode="HighQuality"/>
            </Button>

            <!-- App Title in middle column -->
            <TextBlock Grid.Column="1"
                       Text="Wadd"
                       FontSize="18"
                       FontWeight="Bold"
                       Foreground="{DynamicResource AppTextPrimaryBrush}"
                       VerticalAlignment="Center"/>

            <!-- Collapse Toggle Button on the right -->
            <Button Grid.Column="2"
                    Classes="icon-btn"
                    Command="{Binding ToggleNavExpandedCommand}"
                    Margin="0,0,8,0"
                    VerticalAlignment="Center"
                    ToolTip.Tip="Collapse navigation (Ctrl+B)">
              <PathIcon Data="{StaticResource MenuIconData}" Width="16" Height="16"/>
            </Button>
          </Grid>

          <!-- ─── NAVIGATION ITEMS (Single Unified ListBox) ─── -->
          <ListBox Grid.Row="1"
                   Background="Transparent"
                   BorderThickness="0"
                   SelectedIndex="{Binding SelectedNavIndex}"
                   Padding="4,4">

            <ListBoxItem Classes="nav-unified-item" ToolTip.Tip="Tasks">
              <Grid ColumnDefinitions="56,*,Auto" Height="44">
                <PathIcon Grid.Column="0" Data="{StaticResource CheckListIconData}" Width="19" Height="19" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="Tasks" FontSize="14" VerticalAlignment="Center"/>
                <Border Grid.Column="2"
                        Background="{DynamicResource AppSurfaceElevatedBrush}"
                        CornerRadius="10"
                        Padding="7,2"
                        Margin="0,0,10,0"
                        VerticalAlignment="Center">
                  <TextBlock Text="{Binding TodoItems.Count}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                </Border>
              </Grid>
            </ListBoxItem>

            <ListBoxItem Classes="nav-unified-item" ToolTip.Tip="Calendar">
              <Grid ColumnDefinitions="56,*" Height="44">
                <PathIcon Grid.Column="0" Data="{StaticResource CalendarIconData}" Width="19" Height="19" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="Calendar" FontSize="14" VerticalAlignment="Center"/>
              </Grid>
            </ListBoxItem>

            <ListBoxItem Classes="nav-unified-item" ToolTip.Tip="Diagnostics">
              <Grid ColumnDefinitions="56,*" Height="44">
                <PathIcon Grid.Column="0" Data="{StaticResource TracingIconData}" Width="19" Height="19" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="Diagnostics" FontSize="14" VerticalAlignment="Center"/>
              </Grid>
            </ListBoxItem>

            <ListBoxItem Classes="nav-unified-item" ToolTip.Tip="Settings">
              <Grid ColumnDefinitions="56,*" Height="44">
                <PathIcon Grid.Column="0" Data="{StaticResource SettingsIconData}" Width="19" Height="19" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="Settings" FontSize="14" VerticalAlignment="Center"/>
              </Grid>
            </ListBoxItem>
          </ListBox>

          <!-- Bottom Footer: Collapsed (Width=64 to stay visible in collapsed rail) -->
          <StackPanel Grid.Row="2"
                      IsVisible="{Binding !IsNavExpanded}"
                      Width="64"
                      HorizontalAlignment="Left"
                      Spacing="8"
                      Margin="0,0,0,18">
            <Button Classes="icon-btn"
                    Command="{Binding ToggleThemeCommand}"
                    HorizontalAlignment="Center">
              <Panel>
                <PathIcon Data="{StaticResource MoonIconData}" Width="16" Height="16" IsVisible="{Binding !IsDarkMode}" ToolTip.Tip="Switch to Dark Mode"/>
                <PathIcon Data="{StaticResource SunIconData}" Width="16" Height="16" IsVisible="{Binding IsDarkMode}" ToolTip.Tip="Switch to Light Mode"/>
              </Panel>
            </Button>
            <Button Classes="icon-btn"
                    Command="{Binding SyncCommand}"
                    IsEnabled="{Binding !IsSyncing}"
                    HorizontalAlignment="Center"
                    ToolTip.Tip="Sync Cloud">
              <PathIcon Data="{StaticResource SyncIconData}" Width="16" Height="16"/>
            </Button>
            <!-- Status indicator dot -->
            <Ellipse Width="6" Height="6"
                     HorizontalAlignment="Center"
                     Fill="{DynamicResource AppAccentSuccessBrush}"
                     IsVisible="{Binding !IsSyncing}"
                     ToolTip.Tip="Local mode · SQLite active"/>
            <Ellipse Width="6" Height="6"
                     HorizontalAlignment="Center"
                     Fill="{DynamicResource AppPrimaryBrush}"
                     IsVisible="{Binding IsSyncing}"
                     ToolTip.Tip="Syncing…"/>
          </StackPanel>

          <Border Grid.Row="2"
                  IsVisible="{Binding IsNavExpanded}"
                  Margin="10,0,10,16"
                  Padding="12,10"
                  Background="{DynamicResource AppSurfaceElevatedBrush}"
                  BorderBrush="{DynamicResource AppBorderBrush}"
                  BorderThickness="1"
                  CornerRadius="10">
            <StackPanel Spacing="10">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                  <TextBlock Text="STORAGE &amp; SYNC" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource AppPrimaryBrush}"/>
                  <TextBlock Text="SQLite Local Mode" IsVisible="{Binding !IsGoogleSignedIn}" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                  <TextBlock Text="{Binding GoogleUserEmail}" IsVisible="{Binding IsGoogleSignedIn}" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource AppTextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <Button Grid.Column="1"
                        Classes="icon-btn"
                        Command="{Binding ToggleThemeCommand}"
                        VerticalAlignment="Center">
                  <Panel>
                    <PathIcon Data="{StaticResource MoonIconData}" Width="14" Height="14" IsVisible="{Binding !IsDarkMode}" ToolTip.Tip="Switch to Dark Mode"/>
                    <PathIcon Data="{StaticResource SunIconData}" Width="14" Height="14" IsVisible="{Binding IsDarkMode}" ToolTip.Tip="Switch to Light Mode"/>
                  </Panel>
                </Button>
              </Grid>
              <Button Classes="outline"
                      Command="{Binding SyncCommand}"
                      IsEnabled="{Binding !IsSyncing}"
                      HorizontalAlignment="Stretch">
                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                  <PathIcon Data="{StaticResource SyncIconData}" Width="13" Height="13"/>
                  <TextBlock Text="Sync Cloud" IsVisible="{Binding !IsSyncing}" FontSize="12" FontWeight="SemiBold"/>
                  <TextBlock Text="Syncing..." IsVisible="{Binding IsSyncing}" FontSize="12" FontWeight="SemiBold"/>
                </StackPanel>
              </Button>
            </StackPanel>
          </Border>

        </Grid>
      </Border>

      <!-- ──────────────────────────────────────────────────
           MAIN CONTENT AREA
      ────────────────────────────────────────────────── -->
      <Panel Grid.Column="1">

        <!-- ─── Sync progress bar (top edge, 2px line) ─── -->
        <ProgressBar IsIndeterminate="True"
                     IsVisible="{Binding IsSyncing}"
                     Height="2"
                     VerticalAlignment="Top"
                     HorizontalAlignment="Stretch"
                     Foreground="{DynamicResource AppPrimaryBrush}"
                     Background="Transparent"/>

        <!-- ═══ TAB 0: TASKS VIEW ═══ -->
        <Grid IsVisible="{Binding IsTasksView}" RowDefinitions="*">
          <ScrollViewer VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="64,52,80,80" Spacing="0">

              <!-- Page header -->
              <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                <StackPanel Grid.Column="0" Spacing="4">
                  <TextBlock Text="{Binding CurrentDateFormatted}"
                             Classes="micro"
                             Foreground="{DynamicResource AppPrimaryBrush}"
                             Margin="0,0,0,2"/>
                  <TextBlock Text="My Tasks" Classes="display-xl"/>
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="{Binding TodoItems.Count, StringFormat='{}{0} items'}"
                               Classes="small"/>
                    <TextBlock Text="·" Classes="small"/>
                    <TextBlock IsVisible="{Binding !IsSyncing}"
                               Text="SQLite local storage"
                               Classes="small"/>
                    <TextBlock IsVisible="{Binding IsSyncing}"
                               Text="Syncing with cloud…"
                               Classes="small"
                               Foreground="{DynamicResource AppPrimaryBrush}"/>
                  </StackPanel>
                </StackPanel>
                <!-- Toolbar -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Bottom"
                            Margin="0,0,0,4">
                  <Button Classes="outline"
                          Command="{Binding ExportToExcelCommand}"
                          ToolTip.Tip="Export tasks to Excel">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <PathIcon Data="{StaticResource ExportIconData}" Width="12" Height="12"/>
                      <TextBlock Text="Export" FontSize="12"/>
                    </StackPanel>
                  </Button>
                </StackPanel>
              </Grid>

              <!-- Full-width divider -->
              <Separator Classes="divider" Margin="0,24,0,32"/>

              <!-- ── Task Composer ── -->
              <StackPanel Spacing="0" Margin="0,0,0,40">
                <!-- Title input + Add button -->
                <Grid ColumnDefinitions="*,Auto">
                  <TextBox Grid.Column="0"
                           Classes="composer"
                           Watermark="What do you need to do?"
                           Text="{Binding NewTaskTitle, Mode=TwoWay}"
                           FontSize="20"
                           FontWeight="Medium"
                           Padding="0,10"
                           HorizontalAlignment="Stretch">
                    <TextBox.InnerRightContent>
                      <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="0,0,8,0">
                        <!-- Reminder button (Bell) -->
                        <Button Classes="icon-btn"
                                ToolTip.Tip="Set reminder (date &amp; time)"
                                VerticalAlignment="Center">
                          <PathIcon Data="{StaticResource BellIconData}" Width="16" Height="16"/>
                          <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedRight">
                              <StackPanel Spacing="8" Width="230">
                                <TextBlock Text="REMINDER PRESETS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="2,0,0,2"/>
                                <Button Classes="ghost"
                                        Foreground="{DynamicResource AppTextPrimaryBrush}"
                                        FontWeight="SemiBold"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Command="{Binding SetReminderLaterTodayCommand}"
                                        Content="Later Today (17:00)"/>
                                <Button Classes="ghost"
                                        Foreground="{DynamicResource AppTextPrimaryBrush}"
                                        FontWeight="SemiBold"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Command="{Binding SetReminderTomorrowMorningCommand}"
                                        Content="Tomorrow Morning (09:00)"/>
                                <Button Classes="ghost"
                                        Foreground="{DynamicResource AppTextPrimaryBrush}"
                                        FontWeight="SemiBold"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Command="{Binding SetReminderNextWeekCommand}"
                                        Content="Next Week (09:00)"/>

                                <Separator Classes="divider" Margin="0,4"/>

                                <TextBlock Text="CUSTOM DATE &amp; TIME" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="2,0,0,2"/>
                                <CalendarDatePicker SelectedDate="{Binding NewTaskReminderDate, Mode=TwoWay}"
                                                    Watermark="Reminder Date..."
                                                    HorizontalAlignment="Stretch"/>
                                <TimePicker Classes="no-clock"
                                            SelectedTime="{Binding NewTaskReminderTime, Mode=TwoWay}"
                                            ClockIdentifier="24HourClock"
                                            HorizontalAlignment="Stretch"/>
                              </StackPanel>
                            </Flyout>
                          </Button.Flyout>
                        </Button>

                        <!-- Due Date button -->
                        <Button Classes="icon-btn"
                                ToolTip.Tip="Set due date"
                                VerticalAlignment="Center">
                          <PathIcon Data="{StaticResource CalendarIconData}" Width="16" Height="16"/>
                          <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedRight">
                              <StackPanel Spacing="6" Width="210">
                                <Button Classes="ghost"
                                        Foreground="{DynamicResource AppTextPrimaryBrush}"
                                        FontWeight="SemiBold"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Command="{Binding SetDueDateLaterTodayCommand}"
                                        Content="Today"/>
                                <Button Classes="ghost"
                                        Foreground="{DynamicResource AppTextPrimaryBrush}"
                                        FontWeight="SemiBold"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Command="{Binding SetDueDateTomorrowCommand}"
                                        Content="Tomorrow"/>
                                <Button Classes="ghost"
                                        Foreground="{DynamicResource AppTextPrimaryBrush}"
                                        FontWeight="SemiBold"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Command="{Binding SetDueDateNextWeekCommand}"
                                        Content="Next Week"/>

                                <Separator Classes="divider" Margin="0,4"/>

                                <CalendarDatePicker SelectedDate="{Binding NewTaskDueDate, Mode=TwoWay}"
                                                    Watermark="Choose Date..."
                                                    HorizontalAlignment="Stretch"/>
                              </StackPanel>
                            </Flyout>
                          </Button.Flyout>
                        </Button>
                      </StackPanel>
                    </TextBox.InnerRightContent>
                  </TextBox>
                  <Button Grid.Column="1"
                          Classes="composer-add"
                          Command="{Binding AddTaskCommand}"
                          Margin="16,0,0,0"
                          VerticalAlignment="Bottom"
                          ToolTip.Tip="Add task (Enter)">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                      <Border Width="20" Height="20" CornerRadius="10" Background="#33FFFFFF" VerticalAlignment="Center">
                        <PathIcon Data="{StaticResource PlusIconData}"
                                  Width="10" Height="10"
                                  Foreground="#FFFFFF"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                      </Border>
                      <TextBlock Text="Add task" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                  </Button>
                </Grid>

                <!-- Description input -->
                <TextBox Classes="composer"
                         Watermark="Add a note or context… (optional)"
                         Text="{Binding NewTaskDescription, Mode=TwoWay}"
                         FontSize="13"
                         Padding="0,8"
                         Margin="0,12,0,0"/>

                <!-- Selected Chips (Due Date & Reminder) -->
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
                  <!-- Selected Due Date Chip -->
                  <Border IsVisible="{Binding HasNewTaskDueDate}"
                          Background="{DynamicResource AppPrimarySubtleBrush}"
                          BorderBrush="{DynamicResource AppPrimaryBrush}"
                          BorderThickness="1"
                          CornerRadius="14"
                          Padding="10,6"
                          HorizontalAlignment="Left">
                    <Grid ColumnDefinitions="Auto,Auto,Auto" VerticalAlignment="Center">
                      <PathIcon Grid.Column="0"
                                Data="{StaticResource CalendarIconData}"
                                Width="13" Height="13"
                                Foreground="{DynamicResource AppPrimaryBrush}"
                                VerticalAlignment="Center"
                                Margin="0,0,8,0"/>

                      <TextBlock Grid.Column="1"
                                 Text="{Binding NewTaskDueDateFormatted}"
                                 FontSize="12"
                                 FontWeight="SemiBold"
                                 Foreground="{DynamicResource AppPrimaryBrush}"
                                 VerticalAlignment="Center"
                                 Margin="0,0,10,0"/>

                      <Button Grid.Column="2"
                              Command="{Binding ClearDueDateCommand}"
                              ToolTip.Tip="Remove due date"
                              Background="Transparent"
                              BorderThickness="0"
                              Padding="0"
                              Width="16" Height="16"
                              MinWidth="16" MinHeight="16"
                              HorizontalContentAlignment="Center"
                              VerticalContentAlignment="Center"
                              VerticalAlignment="Center"
                              Cursor="Hand">
                        <PathIcon Data="{StaticResource CloseIconData}"
                                  Width="10" Height="10"
                                  Foreground="{DynamicResource AppPrimaryBrush}"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Center"/>
                      </Button>
                    </Grid>
                  </Border>

                  <!-- Selected Reminder Chip -->
                  <Border IsVisible="{Binding HasNewTaskReminder}"
                          Background="{DynamicResource AppAccentTintBrush}"
                          BorderBrush="{DynamicResource AppAccentBrush}"
                          BorderThickness="1"
                          CornerRadius="14"
                          Padding="10,6"
                          HorizontalAlignment="Left">
                    <Grid ColumnDefinitions="Auto,Auto,Auto" VerticalAlignment="Center">
                      <PathIcon Grid.Column="0"
                                Data="{StaticResource BellIconData}"
                                Width="13" Height="13"
                                Foreground="{DynamicResource AppAccentBrush}"
                                VerticalAlignment="Center"
                                Margin="0,0,8,0"/>

                      <TextBlock Grid.Column="1"
                                 Text="{Binding NewTaskReminderFormatted}"
                                 FontSize="12"
                                 FontWeight="SemiBold"
                                 Foreground="{DynamicResource AppAccentBrush}"
                                 VerticalAlignment="Center"
                                 Margin="0,0,10,0"/>

                      <Button Grid.Column="2"
                              Command="{Binding ClearReminderCommand}"
                              ToolTip.Tip="Remove reminder"
                              Background="Transparent"
                              BorderThickness="0"
                              Padding="0"
                              Width="16" Height="16"
                              MinWidth="16" MinHeight="16"
                              HorizontalContentAlignment="Center"
                              VerticalContentAlignment="Center"
                              VerticalAlignment="Center"
                              Cursor="Hand">
                        <PathIcon Data="{StaticResource CloseIconData}"
                                  Width="10" Height="10"
                                  Foreground="{DynamicResource AppAccentBrush}"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Center"/>
                      </Button>
                    </Grid>
                  </Border>
                </StackPanel>
              </StackPanel>

              <!-- ── Section label ── -->
              <TextBlock Text="ALL TASKS"
                         Classes="micro"
                         Margin="0,0,0,4"/>

              <!-- ── Task List ── -->
              <ItemsControl ItemsSource="{Binding TodoItems}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:TodoItemViewModel">
                    <Border Classes="task-row" Padding="4,14">
                      <Grid ColumnDefinitions="Auto,*,Auto,Auto">

                        <!-- Checkbox -->
                        <CheckBox Grid.Column="0"
                                  IsChecked="{Binding IsCompleted, Mode=TwoWay}"
                                  Command="{Binding $parent[UserControl].DataContext.ToggleTodoCommand}"
                                  CommandParameter="{Binding}"
                                  VerticalAlignment="Top"
                                  Margin="0,1,16,0"/>

                        <!-- Task metadata -->
                        <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Title}"
                                     Classes="body-bold"
                                     FontSize="14"
                                     TextWrapping="Wrap"/>
                          <TextBlock Text="{Binding Description}"
                                     Classes="small"
                                     IsVisible="{Binding Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                     TextWrapping="Wrap"/>
                          <!-- Badges (Due Date & Reminder) -->
                          <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2,0,0">
                            <!-- Due Date Badge -->
                            <Border IsVisible="{Binding HasDueDate}"
                                    Background="{DynamicResource AppPrimarySubtleBrush}"
                                    CornerRadius="4"
                                    Padding="6,2"
                                    HorizontalAlignment="Left">
                              <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <PathIcon Data="{StaticResource CalendarIconData}" Width="10" Height="10" Foreground="{DynamicResource AppPrimaryBrush}"/>
                                <TextBlock Text="{Binding DueDateFormatted}" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource AppPrimaryBrush}"/>
                              </StackPanel>
                            </Border>

                            <!-- Reminder Badge -->
                            <Border IsVisible="{Binding HasReminder}"
                                    Background="{DynamicResource AppAccentTintBrush}"
                                    CornerRadius="4"
                                    Padding="6,2"
                                    HorizontalAlignment="Left">
                              <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <PathIcon Data="{StaticResource BellIconData}" Width="10" Height="10" Foreground="{DynamicResource AppAccentBrush}"/>
                                <TextBlock Text="{Binding ReminderAtFormatted}" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource AppAccentBrush}"/>
                              </StackPanel>
                            </Border>
                          </StackPanel>
                        </StackPanel>

                        <!-- Timestamp -->
                        <TextBlock Grid.Column="2"
                                   Text="{Binding CreatedAt, StringFormat='{}{0:MMM d}'}"
                                   Classes="small"
                                   VerticalAlignment="Center"
                                   Margin="14,0,6,0"/>

                        <!-- Delete -->
                        <Button Grid.Column="3"
                                Classes="danger"
                                Command="{Binding $parent[UserControl].DataContext.DeleteTodoCommand}"
                                CommandParameter="{Binding}"
                                VerticalAlignment="Center"
                                ToolTip.Tip="Delete task">
                          <PathIcon Data="{StaticResource CloseIconData}" Width="12" Height="12"/>
                        </Button>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <!-- Empty state -->
              <StackPanel IsVisible="{Binding !TodoItems.Count}"
                          HorizontalAlignment="Center"
                          Margin="0,72,0,0"
                          Spacing="14">
                <PathIcon Data="{StaticResource CheckListIconData}"
                          Width="40" Height="40"
                          Foreground="{DynamicResource AppBorderBrush}"
                          HorizontalAlignment="Center"/>
                <TextBlock Text="No tasks yet"
                           Classes="heading"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                <TextBlock Text="Type something above and press Add task."
                           Classes="small"
                           HorizontalAlignment="Center"/>
              </StackPanel>

            </StackPanel>
          </ScrollViewer>
        </Grid>

        <!-- ═══ TAB 1: CALENDAR VIEW ═══ -->
        <ScrollViewer IsVisible="{Binding IsCalendarView}"
                      VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="64,52,80,80" Spacing="0">
            <TextBlock Text="{Binding CurrentDateFull}" Classes="micro" Foreground="{DynamicResource AppPrimaryBrush}" Margin="0,0,0,4"/>
            <TextBlock Text="Calendar" Classes="display-xl" Margin="0,0,0,6"/>
            <TextBlock Text="Upcoming schedule and task timeline." Classes="small" Margin="0,0,0,0"/>
            <Separator Classes="divider" Margin="0,28,0,40"/>

            <Grid ColumnDefinitions="*,*,*">
              <Border Grid.Column="0" Classes="content-block" Margin="0,0,12,0">
                <StackPanel Spacing="10">
                  <TextBlock Text="TODAY" Classes="micro" Foreground="{DynamicResource AppPrimaryBrush}"/>
                  <TextBlock Text="Task Review" Classes="heading"/>
                  <TextBlock Text="Review all pending local tasks" Classes="small"/>
                </StackPanel>
              </Border>
              <Border Grid.Column="1" Classes="content-block" Margin="0,0,12,0">
                <StackPanel Spacing="10">
                  <TextBlock Text="TOMORROW" Classes="micro" Foreground="{DynamicResource AppAccentSuccessBrush}"/>
                  <TextBlock Text="Cloud Sync" Classes="heading"/>
                  <TextBlock Text="Google Apps Script backup" Classes="small"/>
                </StackPanel>
              </Border>
              <Border Grid.Column="2" Classes="content-block">
                <StackPanel Spacing="10">
                  <TextBlock Text="THIS WEEK" Classes="micro" Foreground="{DynamicResource AppAccentWarningBrush}"/>
                  <TextBlock Text="Weekly Export" Classes="heading"/>
                  <TextBlock Text="Generate Excel reports" Classes="small"/>
                </StackPanel>
              </Border>
            </Grid>
          </StackPanel>
        </ScrollViewer>

        <!-- ═══ TAB 2: DIAGNOSTICS VIEW ═══ -->
        <ScrollViewer IsVisible="{Binding IsTracingView}"
                      VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="64,52,80,80" Spacing="0">
            <TextBlock Text="Diagnostics" Classes="display-xl" Margin="0,0,0,6"/>
            <TextBlock Text="Application health, SQLite telemetry, and sync status." Classes="small"/>
            <Separator Classes="divider" Margin="0,28,0,40"/>

            <Grid ColumnDefinitions="*,*,*">
              <Border Grid.Column="0" Classes="content-block" Margin="0,0,12,0">
                <StackPanel Spacing="10">
                  <TextBlock Text="DATABASE" Classes="micro"/>
                  <TextBlock Text="SQLite" Classes="heading"/>
                  <TextBlock Text="Connected · WAL Mode" Classes="small"
                             Foreground="{DynamicResource AppAccentSuccessBrush}"/>
                </StackPanel>
              </Border>
              <Border Grid.Column="1" Classes="content-block" Margin="0,0,12,0">
                <StackPanel Spacing="10">
                  <TextBlock Text="LATENCY" Classes="micro"/>
                  <TextBlock Text="0.14 ms" Classes="heading"/>
                  <TextBlock Text="Optimal read speed" Classes="small"/>
                </StackPanel>
              </Border>
              <Border Grid.Column="2" Classes="content-block">
                <StackPanel Spacing="10">
                  <TextBlock Text="SYNC" Classes="micro"/>
                  <TextBlock Text="Ready" Classes="heading"/>
                  <TextBlock Text="Google Apps Script endpoint" Classes="small"
                             Foreground="{DynamicResource AppPrimaryBrush}"/>
                </StackPanel>
              </Border>
            </Grid>
          </StackPanel>
        </ScrollViewer>

        <!-- ═══ TAB 3: SETTINGS VIEW ═══ -->
        <ScrollViewer IsVisible="{Binding IsSettingsView}"
                      VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="64,52,80,80" Spacing="0">
            <TextBlock Text="Settings" Classes="display-xl" Margin="0,0,0,6"/>
            <TextBlock Text="Theme, sync, and application preferences." Classes="small"/>
            <Separator Classes="divider" Margin="0,28,0,44"/>

            <StackPanel Spacing="36">

              <!-- Appearance -->
              <StackPanel Spacing="16">
                <TextBlock Text="APPEARANCE" Classes="micro"/>
                <Border Classes="content-block">
                  <StackPanel Spacing="20">
                    <StackPanel Spacing="4">
                      <TextBlock Text="Interface Theme" Classes="heading"/>
                      <TextBlock Text="Choose your preferred visual mode." Classes="small"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Button Classes="outline"
                              Command="{Binding SetThemeModeCommand}"
                              CommandParameter="System">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                          <PathIcon Data="{StaticResource MonitorIconData}" Width="14" Height="14"/>
                          <TextBlock Text="System"/>
                        </StackPanel>
                      </Button>
                      <Button Classes="outline"
                              Command="{Binding SetThemeModeCommand}"
                              CommandParameter="Light">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                          <PathIcon Data="{StaticResource SunIconData}" Width="14" Height="14"/>
                          <TextBlock Text="Light"/>
                        </StackPanel>
                      </Button>
                      <Button Classes="outline"
                              Command="{Binding SetThemeModeCommand}"
                              CommandParameter="Dark">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                          <PathIcon Data="{StaticResource MoonIconData}" Width="14" Height="14"/>
                          <TextBlock Text="Dark"/>
                        </StackPanel>
                      </Button>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <TextBlock Text="Active:" Classes="small"/>
                      <TextBlock Text="{Binding CurrentThemeLabel}"
                                 Classes="small"
                                 FontWeight="SemiBold"
                                 Foreground="{DynamicResource AppPrimaryBrush}"/>
                    </StackPanel>
                  </StackPanel>
                </Border>
              </StackPanel>

              <!-- Cloud Sync: Private Google Drive -->
              <StackPanel Spacing="16">
                <TextBlock Text="CLOUD SYNC" Classes="micro"/>
                <Border Classes="content-block">
                  <StackPanel Spacing="20">
                    <StackPanel Spacing="4">
                      <TextBlock Text="Private Google Drive Backup" Classes="heading"/>
                      <TextBlock Text="Save your data directly to your private Google Drive account. No public endpoints required." Classes="small"/>
                    </StackPanel>

                    <!-- Signed Out State -->
                    <StackPanel IsVisible="{Binding !IsGoogleSignedIn}" Spacing="14">
                      <Button Classes="composer-add"
                              Command="{Binding SignInWithGoogleCommand}"
                              HorizontalAlignment="Left"
                              ToolTip.Tip="Sign in with your Google Account">
                        <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                          <Border Width="20" Height="20" CornerRadius="10" Background="#FFFFFF" VerticalAlignment="Center">
                            <TextBlock Text="G" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AppPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                          </Border>
                          <TextBlock Text="Sign in with Google" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                      </Button>
                      <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Text="🔒" FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock Text="Data is saved privately inside your Google Drive storage." Classes="small" VerticalAlignment="Center"/>
                      </StackPanel>
                    </StackPanel>

                    <!-- Signed In State -->
                    <StackPanel IsVisible="{Binding IsGoogleSignedIn}" Spacing="16">
                      <Border Background="{DynamicResource AppSurfaceElevatedBrush}"
                              BorderBrush="{DynamicResource AppBorderBrush}"
                              BorderThickness="1"
                              CornerRadius="10"
                              Padding="14,12">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                          <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18" Background="{DynamicResource AppPrimaryBrush}" Margin="0,0,12,0">
                            <TextBlock Text="G" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                          </Border>
                          <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                              <TextBlock Text="{Binding GoogleUserEmail}" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                              <Border Background="{DynamicResource AppAccentTintBrush}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                <TextBlock Text="Connected" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AppPrimaryBrush}"/>
                              </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding GoogleUserName}" Classes="small" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                          </StackPanel>
                          <Button Grid.Column="2"
                                  Classes="outline"
                                  Command="{Binding SignOutGoogleCommand}"
                                  VerticalAlignment="Center">
                            <TextBlock Text="Sign out" FontSize="12"/>
                          </Button>
                        </Grid>
                      </Border>

                      <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Classes="primary"
                                Command="{Binding SyncCommand}"
                                IsEnabled="{Binding !IsSyncing}">
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="{StaticResource SyncIconData}" Width="13" Height="13"/>
                            <TextBlock Text="Sync now"/>
                          </StackPanel>
                        </Button>
                      </StackPanel>
                    </StackPanel>

                  </StackPanel>
                </Border>
              </StackPanel>

              <!-- Storage info -->
              <StackPanel Spacing="16">
                <TextBlock Text="STORAGE" Classes="micro"/>
                <Border Classes="content-block">
                  <StackPanel Spacing="16">
                    <Grid ColumnDefinitions="148,*">
                      <TextBlock Grid.Column="0" Text="Database" Classes="small" FontWeight="SemiBold"/>
                      <TextBlock Grid.Column="1" Text="%LOCALAPPDATA%\Wadd\wadd.db" Classes="mono"/>
                    </Grid>
                    <Separator Classes="divider"/>
                    <Grid ColumnDefinitions="148,*">
                      <TextBlock Grid.Column="0" Text="Excel Exports" Classes="small" FontWeight="SemiBold"/>
                      <TextBlock Grid.Column="1" Text="%LOCALAPPDATA%\Wadd\Exports\" Classes="mono"/>
                    </Grid>
                    <Separator Classes="divider"/>
                    <Grid ColumnDefinitions="148,*">
                      <TextBlock Grid.Column="0" Text="Runtime" Classes="small" FontWeight="SemiBold"/>
                      <TextBlock Grid.Column="1" Text=".NET 10 · Avalonia UI · Clean Architecture" Classes="small"/>
                    </Grid>
                  </StackPanel>
                </Border>
                <Button Classes="outline"
                        Command="{Binding ExportToExcelCommand}"
                        HorizontalAlignment="Left">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <PathIcon Data="{StaticResource ExportIconData}" Width="13" Height="13"/>
                    <TextBlock Text="Export tasks to Excel"/>
                  </StackPanel>
                </Button>
              </StackPanel>

            </StackPanel>
          </StackPanel>
        </ScrollViewer>

        <!-- Floating Status Toast Notification (Desktop) -->
        <Border VerticalAlignment="Bottom"
                HorizontalAlignment="Right"
                Margin="0,0,32,24"
                Padding="16,10"
                Background="{DynamicResource AppSurfaceElevatedBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="1"
                CornerRadius="20"
                Opacity="{Binding StatusOpacity}"
                IsVisible="{Binding IsStatusVisible}">
          <Border.Transitions>
            <Transitions>
              <DoubleTransition Property="Opacity" Duration="0:0:0.4"/>
            </Transitions>
          </Border.Transitions>
          <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <Ellipse Width="8" Height="8" Fill="{DynamicResource AppPrimaryBrush}" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding StatusMessage}"
                       Classes="small"
                       FontWeight="Medium"
                       Foreground="{DynamicResource AppTextPrimaryBrush}"
                       VerticalAlignment="Center"/>
          </StackPanel>
        </Border>

      </Panel>
    </Grid>

    <!-- ══════════════════════════════════════════════════════
         COMPACT / MOBILE LAYOUT — full height + bottom tab bar
    ══════════════════════════════════════════════════════ -->
    <Grid IsVisible="{Binding IsCompact}" RowDefinitions="*,Auto">

      <!-- Compact content views -->
      <Panel Grid.Row="0">

        <!-- Compact Tasks View -->
        <ScrollViewer IsVisible="{Binding IsTasksView}"
                      Padding="20,24,20,0"
                      VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="0">

            <!-- Compact header -->
            <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,20">
              <Image Grid.Column="0"
                     Source="avares://Wadd.UI/Assets/logo.png"
                     Width="30" Height="30"
                     RenderOptions.BitmapInterpolationMode="HighQuality"
                     Margin="0,0,12,0"
                     VerticalAlignment="Center"/>
              <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                <TextBlock Text="{Binding CurrentDateFormatted}"
                           Classes="micro"
                           Foreground="{DynamicResource AppPrimaryBrush}"/>
                <TextBlock Text="My Tasks" Classes="display"/>
                <TextBlock Text="{Binding TodoItems.Count, StringFormat='{}{0} items'}" Classes="small"/>
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Bottom">
                <Button Classes="icon-btn"
                        Command="{Binding SyncCommand}"
                        IsEnabled="{Binding !IsSyncing}"
                        ToolTip.Tip="Sync now">
                  <PathIcon Data="{StaticResource SyncIconData}" Width="16" Height="16"/>
                </Button>
                <Button Classes="icon-btn"
                        Command="{Binding ExportToExcelCommand}"
                        ToolTip.Tip="Export to Excel">
                  <PathIcon Data="{StaticResource ExportIconData}" Width="16" Height="16"/>
                </Button>
              </StackPanel>
            </Grid>

            <!-- Compact composer -->
            <StackPanel Spacing="0" Margin="0,0,0,24">
              <Grid ColumnDefinitions="*,Auto">
                <TextBox Grid.Column="0"
                         Classes="composer"
                         Watermark="What do you need to do?"
                         Text="{Binding NewTaskTitle, Mode=TwoWay}"
                         FontSize="16"
                         FontWeight="Medium"
                         Padding="0,8">
                  <TextBox.InnerRightContent>
                    <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center" Margin="0,0,6,0">
                      <!-- Reminder button (Bell) -->
                      <Button Classes="icon-btn"
                              ToolTip.Tip="Set reminder (date &amp; time)"
                              VerticalAlignment="Center">
                        <PathIcon Data="{StaticResource BellIconData}" Width="15" Height="15"/>
                        <Button.Flyout>
                          <Flyout Placement="BottomEdgeAlignedRight">
                            <StackPanel Spacing="6" Width="210">
                              <TextBlock Text="REMINDER PRESETS" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="2,0,0,2"/>
                              <Button Classes="ghost"
                                      Foreground="{DynamicResource AppTextPrimaryBrush}"
                                      FontWeight="SemiBold"
                                      HorizontalAlignment="Stretch"
                                      HorizontalContentAlignment="Left"
                                      Command="{Binding SetReminderLaterTodayCommand}"
                                      Content="Later Today (17:00)"/>
                              <Button Classes="ghost"
                                      Foreground="{DynamicResource AppTextPrimaryBrush}"
                                      FontWeight="SemiBold"
                                      HorizontalAlignment="Stretch"
                                      HorizontalContentAlignment="Left"
                                      Command="{Binding SetReminderTomorrowMorningCommand}"
                                      Content="Tomorrow Morning (09:00)"/>
                              <Button Classes="ghost"
                                      Foreground="{DynamicResource AppTextPrimaryBrush}"
                                      FontWeight="SemiBold"
                                      HorizontalAlignment="Stretch"
                                      HorizontalContentAlignment="Left"
                                      Command="{Binding SetReminderNextWeekCommand}"
                                      Content="Next Week (09:00)"/>

                              <Separator Classes="divider" Margin="0,4"/>

                              <TextBlock Text="CUSTOM DATE &amp; TIME" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="2,0,0,2"/>
                              <CalendarDatePicker SelectedDate="{Binding NewTaskReminderDate, Mode=TwoWay}"
                                                  Watermark="Reminder Date..."
                                                  HorizontalAlignment="Stretch"/>
                              <TimePicker Classes="no-clock"
                                          SelectedTime="{Binding NewTaskReminderTime, Mode=TwoWay}"
                                          ClockIdentifier="24HourClock"
                                          HorizontalAlignment="Stretch"/>
                            </StackPanel>
                          </Flyout>
                        </Button.Flyout>
                      </Button>

                      <!-- Due Date button -->
                      <Button Classes="icon-btn"
                              ToolTip.Tip="Set due date"
                              VerticalAlignment="Center">
                        <PathIcon Data="{StaticResource CalendarIconData}" Width="15" Height="15"/>
                        <Button.Flyout>
                          <Flyout Placement="BottomEdgeAlignedRight">
                            <StackPanel Spacing="6" Width="200">
                              <Button Classes="ghost"
                                      Foreground="{DynamicResource AppTextPrimaryBrush}"
                                      FontWeight="SemiBold"
                                      HorizontalAlignment="Stretch"
                                      HorizontalContentAlignment="Left"
                                      Command="{Binding SetDueDateLaterTodayCommand}"
                                      Content="Today"/>
                              <Button Classes="ghost"
                                      Foreground="{DynamicResource AppTextPrimaryBrush}"
                                      FontWeight="SemiBold"
                                      HorizontalAlignment="Stretch"
                                      HorizontalContentAlignment="Left"
                                      Command="{Binding SetDueDateTomorrowCommand}"
                                      Content="Tomorrow"/>
                              <Button Classes="ghost"
                                      Foreground="{DynamicResource AppTextPrimaryBrush}"
                                      FontWeight="SemiBold"
                                      HorizontalAlignment="Stretch"
                                      HorizontalContentAlignment="Left"
                                      Command="{Binding SetDueDateNextWeekCommand}"
                                      Content="Next Week"/>

                              <Separator Classes="divider" Margin="0,4"/>

                              <CalendarDatePicker SelectedDate="{Binding NewTaskDueDate, Mode=TwoWay}"
                                                  Watermark="Choose Date..."
                                                  HorizontalAlignment="Stretch"/>
                            </StackPanel>
                          </Flyout>
                        </Button.Flyout>
                      </Button>
                    </StackPanel>
                  </TextBox.InnerRightContent>
                </TextBox>
                <Button Grid.Column="1"
                        Classes="composer-add"
                        Command="{Binding AddTaskCommand}"
                        Margin="12,0,0,0"
                        Padding="12,9"
                        VerticalAlignment="Bottom"
                        ToolTip.Tip="Add task">
                  <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <PathIcon Data="{StaticResource PlusIconData}" Width="12" Height="12" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                    <TextBlock Text="Add" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                  </StackPanel>
                </Button>
              </Grid>

              <TextBox Classes="composer"
                       Watermark="Note… (optional)"
                       Text="{Binding NewTaskDescription, Mode=TwoWay}"
                       FontSize="12"
                       Margin="0,10,0,0"/>

              <!-- Selected Chips (Compact, Due Date & Reminder) -->
              <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,10,0,0">
                <!-- Selected Due Date Chip -->
                <Border IsVisible="{Binding HasNewTaskDueDate}"
                        Background="{DynamicResource AppPrimarySubtleBrush}"
                        BorderBrush="{DynamicResource AppPrimaryBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="9,5"
                        HorizontalAlignment="Left">
                  <Grid ColumnDefinitions="Auto,Auto,Auto" VerticalAlignment="Center">
                    <PathIcon Grid.Column="0"
                              Data="{StaticResource CalendarIconData}"
                              Width="11" Height="11"
                              Foreground="{DynamicResource AppPrimaryBrush}"
                              VerticalAlignment="Center"
                              Margin="0,0,6,0"/>

                    <TextBlock Grid.Column="1"
                               Text="{Binding NewTaskDueDateFormatted}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AppPrimaryBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>

                    <Button Grid.Column="2"
                            Command="{Binding ClearDueDateCommand}"
                            ToolTip.Tip="Remove due date"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="0"
                            Width="14" Height="14"
                            MinWidth="14" MinHeight="14"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            VerticalAlignment="Center"
                            Cursor="Hand">
                      <PathIcon Data="{StaticResource CloseIconData}"
                                Width="9" Height="9"
                                Foreground="{DynamicResource AppPrimaryBrush}"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"/>
                    </Button>
                  </Grid>
                </Border>

                <!-- Selected Reminder Chip -->
                <Border IsVisible="{Binding HasNewTaskReminder}"
                        Background="{DynamicResource AppAccentTintBrush}"
                        BorderBrush="{DynamicResource AppAccentBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="9,5"
                        HorizontalAlignment="Left">
                  <Grid ColumnDefinitions="Auto,Auto,Auto" VerticalAlignment="Center">
                    <PathIcon Grid.Column="0"
                              Data="{StaticResource BellIconData}"
                              Width="11" Height="11"
                              Foreground="{DynamicResource AppAccentBrush}"
                              VerticalAlignment="Center"
                              Margin="0,0,6,0"/>

                    <TextBlock Grid.Column="1"
                               Text="{Binding NewTaskReminderFormatted}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AppAccentBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>

                    <Button Grid.Column="2"
                            Command="{Binding ClearReminderCommand}"
                            ToolTip.Tip="Remove reminder"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="0"
                            Width="14" Height="14"
                            MinWidth="14" MinHeight="14"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            VerticalAlignment="Center"
                            Cursor="Hand">
                      <PathIcon Data="{StaticResource CloseIconData}"
                                Width="9" Height="9"
                                Foreground="{DynamicResource AppAccentBrush}"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"/>
                    </Button>
                  </Grid>
                </Border>
              </StackPanel>
            </StackPanel>

            <TextBlock Text="ALL TASKS" Classes="micro" Margin="0,0,0,4"/>

            <!-- Compact task list -->
            <ItemsControl ItemsSource="{Binding TodoItems}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:TodoItemViewModel">
                  <Border Classes="task-row" Padding="4,12">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                      <CheckBox Grid.Column="0"
                                IsChecked="{Binding IsCompleted, Mode=TwoWay}"
                                Command="{Binding $parent[UserControl].DataContext.ToggleTodoCommand}"
                                CommandParameter="{Binding}"
                                Margin="0,0,12,0"/>
                      <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Description}"
                                   Classes="small"
                                   IsVisible="{Binding Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        <!-- Badges (Due Date & Reminder) -->
                        <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,2,0,0">
                          <!-- Due Date Badge -->
                          <Border IsVisible="{Binding HasDueDate}"
                                  Background="{DynamicResource AppPrimarySubtleBrush}"
                                  CornerRadius="4"
                                  Padding="5,1"
                                  HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                              <PathIcon Data="{StaticResource CalendarIconData}" Width="9" Height="9" Foreground="{DynamicResource AppPrimaryBrush}"/>
                              <TextBlock Text="{Binding DueDateFormatted}" FontSize="10" FontWeight="Medium" Foreground="{DynamicResource AppPrimaryBrush}"/>
                            </StackPanel>
                          </Border>

                          <!-- Reminder Badge -->
                          <Border IsVisible="{Binding HasReminder}"
                                  Background="{DynamicResource AppAccentTintBrush}"
                                  CornerRadius="4"
                                  Padding="5,1"
                                  HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                              <PathIcon Data="{StaticResource BellIconData}" Width="9" Height="9" Foreground="{DynamicResource AppAccentBrush}"/>
                              <TextBlock Text="{Binding ReminderAtFormatted}" FontSize="10" FontWeight="Medium" Foreground="{DynamicResource AppAccentBrush}"/>
                            </StackPanel>
                          </Border>
                        </StackPanel>
                      </StackPanel>
                      <Button Grid.Column="2"
                              Classes="danger"
                              Command="{Binding $parent[UserControl].DataContext.DeleteTodoCommand}"
                              CommandParameter="{Binding}"
                              VerticalAlignment="Center">
                        <PathIcon Data="{StaticResource CloseIconData}" Width="12" Height="12"/>
                      </Button>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel IsVisible="{Binding !TodoItems.Count}"
                        HorizontalAlignment="Center"
                        Margin="0,48,0,0"
                        Spacing="12">
              <PathIcon Data="{StaticResource CheckListIconData}"
                        Width="36" Height="36"
                        Foreground="{DynamicResource AppBorderBrush}"
                        HorizontalAlignment="Center"/>
              <TextBlock Text="No tasks yet" Classes="heading"
                         HorizontalAlignment="Center"
                         Foreground="{DynamicResource AppTextSecondaryBrush}"/>
            </StackPanel>

          </StackPanel>
        </ScrollViewer>

        <!-- Compact Calendar View -->
        <ScrollViewer IsVisible="{Binding IsCalendarView}" Padding="20,24,20,0">
          <StackPanel Spacing="0">
            <TextBlock Text="Calendar" Classes="display" Margin="0,0,0,20"/>
            <Border Classes="content-block" Margin="0,0,0,12">
              <StackPanel Spacing="8">
                <TextBlock Text="TODAY" Classes="micro" Foreground="{DynamicResource AppPrimaryBrush}"/>
                <TextBlock Text="Task Review" Classes="heading"/>
                <TextBlock Text="Review pending SQLite tasks" Classes="small"/>
              </StackPanel>
            </Border>
            <Border Classes="content-block" Margin="0,0,0,12">
              <StackPanel Spacing="8">
                <TextBlock Text="TOMORROW" Classes="micro" Foreground="{DynamicResource AppAccentSuccessBrush}"/>
                <TextBlock Text="Cloud Sync" Classes="heading"/>
                <TextBlock Text="Google Apps Script backup" Classes="small"/>
              </StackPanel>
            </Border>
            <Border Classes="content-block">
              <StackPanel Spacing="8">
                <TextBlock Text="THIS WEEK" Classes="micro" Foreground="{DynamicResource AppAccentWarningBrush}"/>
                <TextBlock Text="Weekly Export" Classes="heading"/>
                <TextBlock Text="Generate Excel reports" Classes="small"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <!-- Compact Diagnostics View -->
        <ScrollViewer IsVisible="{Binding IsTracingView}" Padding="20,24,20,0">
          <StackPanel Spacing="0">
            <TextBlock Text="Diagnostics" Classes="display" Margin="0,0,0,20"/>
            <Border Classes="content-block" Margin="0,0,0,12">
              <StackPanel Spacing="6">
                <TextBlock Text="DATABASE" Classes="micro"/>
                <TextBlock Text="SQLite · Connected" Classes="heading"/>
                <TextBlock Text="WAL Mode Enabled" Classes="small" Foreground="{DynamicResource AppAccentSuccessBrush}"/>
              </StackPanel>
            </Border>
            <Border Classes="content-block" Margin="0,0,0,12">
              <StackPanel Spacing="6">
                <TextBlock Text="LATENCY" Classes="micro"/>
                <TextBlock Text="0.14 ms" Classes="heading"/>
                <TextBlock Text="Optimal read speed" Classes="small"/>
              </StackPanel>
            </Border>
            <Border Classes="content-block">
              <StackPanel Spacing="6">
                <TextBlock Text="SYNC" Classes="micro"/>
                <TextBlock Text="Ready" Classes="heading"/>
                <TextBlock Text="Google Apps Script endpoint" Classes="small" Foreground="{DynamicResource AppPrimaryBrush}"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <!-- Compact Settings View -->
        <ScrollViewer IsVisible="{Binding IsSettingsView}" Padding="20,24,20,0">
          <StackPanel Spacing="0">
            <TextBlock Text="Settings" Classes="display" Margin="0,0,0,20"/>

            <Border Classes="content-block" Margin="0,0,0,16">
              <StackPanel Spacing="16">
                <TextBlock Text="APPEARANCE" Classes="micro"/>
                <TextBlock Text="Interface Theme" Classes="heading"/>
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                  <Button Classes="outline"
                          Command="{Binding SetThemeModeCommand}"
                          CommandParameter="System">
                    <TextBlock Text="System" FontSize="12"/>
                  </Button>
                  <Button Classes="outline"
                          Command="{Binding SetThemeModeCommand}"
                          CommandParameter="Light">
                    <TextBlock Text="Light" FontSize="12"/>
                  </Button>
                  <Button Classes="outline"
                          Command="{Binding SetThemeModeCommand}"
                          CommandParameter="Dark">
                    <TextBlock Text="Dark" FontSize="12"/>
                  </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Text="Active:" Classes="small"/>
                  <TextBlock Text="{Binding CurrentThemeLabel}" Classes="small"
                             FontWeight="SemiBold"
                             Foreground="{DynamicResource AppPrimaryBrush}"/>
                </StackPanel>
              </StackPanel>
            </Border>

            <Border Classes="content-block" Margin="0,0,0,16">
              <StackPanel Spacing="14">
                <TextBlock Text="CLOUD SYNC" Classes="micro"/>
                <TextBlock Text="Sync Endpoint" Classes="heading"/>
                <TextBox Classes="styled"
                         Watermark="https://script.google.com/macros/s/…/exec"
                         Text="{Binding SyncEndpointUrl, Mode=TwoWay}"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Classes="primary"
                          Command="{Binding SaveSettingsCommand}">
                    <TextBlock Text="Save"/>
                  </Button>
                  <Button Classes="outline"
                          Command="{Binding SyncCommand}"
                          IsEnabled="{Binding !IsSyncing}">
                    <TextBlock Text="Sync now"/>
                  </Button>
                </StackPanel>
              </StackPanel>
            </Border>

            <Button Classes="outline"
                    Command="{Binding ExportToExcelCommand}"
                    HorizontalAlignment="Stretch">
              <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                <PathIcon Data="{StaticResource ExportIconData}" Width="13" Height="13"/>
                <TextBlock Text="Export to Excel"/>
              </StackPanel>
            </Button>

          </StackPanel>
        </ScrollViewer>

        <!-- Floating Status Toast Notification (Compact) -->
        <Border VerticalAlignment="Bottom"
                HorizontalAlignment="Center"
                Margin="16,0,16,12"
                Padding="14,8"
                Background="{DynamicResource AppSurfaceElevatedBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="1"
                CornerRadius="16"
                Opacity="{Binding StatusOpacity}"
                IsVisible="{Binding IsStatusVisible}">
          <Border.Transitions>
            <Transitions>
              <DoubleTransition Property="Opacity" Duration="0:0:0.4"/>
            </Transitions>
          </Border.Transitions>
          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Ellipse Width="6" Height="6" Fill="{DynamicResource AppPrimaryBrush}" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding StatusMessage}"
                       Classes="small"
                       FontWeight="Medium"
                       Foreground="{DynamicResource AppTextPrimaryBrush}"
                       VerticalAlignment="Center"/>
          </StackPanel>
        </Border>

        <!-- Compact side drawer overlay (retained for compat) -->
        <Grid IsVisible="{Binding IsSideMenuOpen}" Background="#80000000">
          <Border HorizontalAlignment="Left"
                  Width="272"
                  Background="{DynamicResource AppSurfaceBrush}"
                  BorderBrush="{DynamicResource AppBorderBrush}"
                  BorderThickness="0,0,1,0"
                  Padding="20">
            <Grid RowDefinitions="Auto,*">
              <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,20">
                <TextBlock Grid.Column="0" Text="Navigation" Classes="heading" VerticalAlignment="Center"/>
                <Button Grid.Column="1"
                        Classes="ghost"
                        Command="{Binding CloseSideMenuCommand}"
                        Padding="6">
                  <PathIcon Data="{StaticResource CloseIconData}"
                            Width="14" Height="14"
                            Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                </Button>
              </Grid>
              <ListBox Grid.Row="1"
                       Background="Transparent"
                       SelectedIndex="{Binding SelectedNavIndex}">
                <ListBoxItem Classes="side-menu-item">
                  <StackPanel Orientation="Horizontal" Spacing="12">
                    <PathIcon Data="{StaticResource CheckListIconData}" Width="17" Height="17"/>
                    <TextBlock Text="Tasks" VerticalAlignment="Center"/>
                  </StackPanel>
                </ListBoxItem>
                <ListBoxItem Classes="side-menu-item">
                  <StackPanel Orientation="Horizontal" Spacing="12">
                    <PathIcon Data="{StaticResource CalendarIconData}" Width="17" Height="17"/>
                    <TextBlock Text="Calendar" VerticalAlignment="Center"/>
                  </StackPanel>
                </ListBoxItem>
                <ListBoxItem Classes="side-menu-item">
                  <StackPanel Orientation="Horizontal" Spacing="12">
                    <PathIcon Data="{StaticResource TracingIconData}" Width="17" Height="17"/>
                    <TextBlock Text="Diagnostics" VerticalAlignment="Center"/>
                  </StackPanel>
                </ListBoxItem>
                <ListBoxItem Classes="side-menu-item">
                  <StackPanel Orientation="Horizontal" Spacing="12">
                    <PathIcon Data="{StaticResource SettingsIconData}" Width="17" Height="17"/>
                    <TextBlock Text="Settings" VerticalAlignment="Center"/>
                  </StackPanel>
                </ListBoxItem>
              </ListBox>
            </Grid>
          </Border>
        </Grid>

      </Panel>

      <!-- ── Bottom Tab Bar ── -->
      <Border Grid.Row="1"
              Background="{DynamicResource AppSurfaceBrush}"
              BorderBrush="{DynamicResource AppBorderBrush}"
              BorderThickness="0,1,0,0">
        <ListBox Background="Transparent"
                 BorderThickness="0"
                 SelectedIndex="{Binding SelectedNavIndex}">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Rows="1"/>
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBoxItem Classes="tab-item">
            <StackPanel Spacing="4" HorizontalAlignment="Center">
              <PathIcon Data="{StaticResource CheckListIconData}" Width="20" Height="20" HorizontalAlignment="Center"/>
              <TextBlock Text="Tasks" FontSize="10" FontWeight="Medium" HorizontalAlignment="Center"/>
            </StackPanel>
          </ListBoxItem>
          <ListBoxItem Classes="tab-item">
            <StackPanel Spacing="4" HorizontalAlignment="Center">
              <PathIcon Data="{StaticResource CalendarIconData}" Width="20" Height="20" HorizontalAlignment="Center"/>
              <TextBlock Text="Calendar" FontSize="10" FontWeight="Medium" HorizontalAlignment="Center"/>
            </StackPanel>
          </ListBoxItem>
          <ListBoxItem Classes="tab-item">
            <StackPanel Spacing="4" HorizontalAlignment="Center">
              <PathIcon Data="{StaticResource TracingIconData}" Width="20" Height="20" HorizontalAlignment="Center"/>
              <TextBlock Text="Diagnostics" FontSize="10" FontWeight="Medium" HorizontalAlignment="Center"/>
            </StackPanel>
          </ListBoxItem>
          <ListBoxItem Classes="tab-item">
            <StackPanel Spacing="4" HorizontalAlignment="Center">
              <PathIcon Data="{StaticResource SettingsIconData}" Width="20" Height="20" HorizontalAlignment="Center"/>
              <TextBlock Text="Settings" FontSize="10" FontWeight="Medium" HorizontalAlignment="Center"/>
            </StackPanel>
          </ListBoxItem>
        </ListBox>
      </Border>

    </Grid>

  </Panel>
</UserControl>
