<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Wadd.UI.ViewModels;assembly=Wadd.UI"
             xmlns:controls="clr-namespace:Wadd.UI.Controls;assembly=Wadd.UI"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="700"
             x:Class="Wadd.UI.Views.TaskDetailDrawer"
             x:DataType="vm:MainViewModel">

  <UserControl.Styles>
    <Style Selector="TextBox.detail-title">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0,0,0,1"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
      <Setter Property="Padding" Value="14,8"/>
      <Setter Property="MinHeight" Value="40"/>
    </Style>
    <Style Selector="TextBox.detail-title:focus /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0,0,0,2"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AppPrimaryBrush}"/>
    </Style>

    <Style Selector="TextBox.detail-note">
      <Setter Property="Background" Value="{DynamicResource AppSurfaceElevatedBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="14,10"/>
      <Setter Property="VerticalContentAlignment" Value="Top"/>
    </Style>
  </UserControl.Styles>

  <Border Background="{DynamicResource AppSurfaceBrush}"
          BorderBrush="{DynamicResource AppBorderBrush}"
          BorderThickness="1,0,0,0"
          BoxShadow="-4 0 20 0 #40000000">

    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="16,10,16,14">
      <!-- ── Mobile Drag Handle Pill ── -->
      <Border Grid.Row="0"
              Width="36" Height="4"
              CornerRadius="2"
              Background="{DynamicResource AppBorderBrush}"
              HorizontalAlignment="Center"
              Margin="0,0,0,10"/>

      <!-- ── Drawer Header ── -->
      <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,14">
        <CheckBox Grid.Column="0"
                  Classes="task-checkbox"
                  IsChecked="{Binding SelectedDetailTask.IsCompleted, Mode=OneWay}"
                  Command="{Binding ToggleTodoCommand}"
                  CommandParameter="{Binding SelectedDetailTask}"
                  VerticalAlignment="Center"/>

        <TextBlock Grid.Column="1"
                   Text="Task Details"
                   FontSize="14"
                   FontWeight="Bold"
                   Foreground="{DynamicResource AppTextSecondaryBrush}"
                   VerticalAlignment="Center"
                   Margin="10,0,0,0"/>

        <Button Grid.Column="2"
                Classes="icon-btn"
                Command="{Binding CloseDetailDrawerCommand}"
                ToolTip.Tip="Close task details">
          <PathIcon Data="{StaticResource CloseIconData}" Width="14" Height="14"/>
        </Button>
      </Grid>

      <!-- ── Drawer Content ScrollViewer ── -->
      <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="0,0,4,16">
        <StackPanel Spacing="20" Margin="0,0,0,16" IsVisible="{Binding SelectedDetailTask, Converter={x:Static ObjectConverters.IsNotNull}}">

          <!-- 1. Task Title Editor -->
          <StackPanel Spacing="4">
            <TextBlock Text="TITLE" Classes="micro" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
            <TextBox Classes="detail-title"
                     Text="{Binding SelectedDetailTask.Title, Mode=TwoWay}"
                     FontSize="18"
                     FontWeight="SemiBold"
                     TextWrapping="Wrap"
                     PlaceholderText="Task title..."/>
          </StackPanel>

          <!-- 2. Note / Description Editor -->
          <StackPanel Spacing="8">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <PathIcon Data="{StaticResource NoteIconData}" Width="12" Height="12" Foreground="{DynamicResource AppPrimaryBrush}"/>
              <TextBlock Text="NOTE &amp; DESCRIPTION" Classes="micro" Foreground="{DynamicResource AppPrimaryBrush}"/>
            </StackPanel>

            <!-- Direct Multiline Note Editor -->
            <TextBox Classes="detail-note"
                     Text="{Binding SelectedDetailTask.Description, Mode=TwoWay}"
                     PlaceholderText="Add optional notes, sub-steps, or links..."
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     MinHeight="120"
                     MaxHeight="320"
                     FontSize="13"
                     VerticalContentAlignment="Top"
                     HorizontalContentAlignment="Left"/>
          </StackPanel>

          <!-- Divider -->
          <Separator Classes="divider" Margin="0,4"/>

          <!-- 3. Metadata Quick Actions -->
          <StackPanel Spacing="14">
            <TextBlock Text="METADATA &amp; SCHEDULE" Classes="micro" Foreground="{DynamicResource AppTextSecondaryBrush}"/>

            <!-- Due Date Badge & Action -->
            <Grid ColumnDefinitions="Auto,*" MinHeight="24">
              <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Width="95">
                <PathIcon Data="{StaticResource CalendarIconData}" Width="14" Height="14" Foreground="{DynamicResource AppPrimaryBrush}" VerticalAlignment="Center"/>
                <TextBlock Text="Due Date" FontSize="13" FontWeight="Medium" VerticalAlignment="Center"/>
              </StackPanel>
              <Panel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{Binding SelectedDetailTask.DueDateFormatted}"
                           IsVisible="{Binding SelectedDetailTask.HasDueDate}"
                           FontSize="13"
                           Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                <TextBlock Text="No due date"
                           IsVisible="{Binding !SelectedDetailTask.HasDueDate}"
                           FontSize="13"
                           FontStyle="Italic"
                           Foreground="{DynamicResource AppTextSecondaryBrush}"/>
              </Panel>
            </Grid>

            <!-- Reminder Badge -->
            <Grid ColumnDefinitions="Auto,*" MinHeight="24">
              <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Width="95">
                <PathIcon Data="{StaticResource BellIconData}" Width="14" Height="14" Foreground="{DynamicResource AppPrimaryBrush}" VerticalAlignment="Center"/>
                <TextBlock Text="Reminder" FontSize="13" FontWeight="Medium" VerticalAlignment="Center"/>
              </StackPanel>
              <Panel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{Binding SelectedDetailTask.ReminderAtFormatted}"
                           IsVisible="{Binding SelectedDetailTask.HasReminder}"
                           FontSize="13"
                           Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                <TextBlock Text="No reminder set"
                           IsVisible="{Binding !SelectedDetailTask.HasReminder}"
                           FontSize="13"
                           FontStyle="Italic"
                           Foreground="{DynamicResource AppTextSecondaryBrush}"/>
              </Panel>
            </Grid>

            <!-- Recurrence Badge -->
            <Grid ColumnDefinitions="Auto,*" MinHeight="24">
              <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Width="95">
                <PathIcon Data="{StaticResource RepeatIconData}" Width="14" Height="14" Foreground="{DynamicResource AppPrimaryBrush}" VerticalAlignment="Center"/>
                <TextBlock Text="Repeat" FontSize="13" FontWeight="Medium" VerticalAlignment="Center"/>
              </StackPanel>
              <Panel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{Binding SelectedDetailTask.RecurrenceFormatted}"
                           IsVisible="{Binding SelectedDetailTask.HasRecurrence}"
                           FontSize="13"
                           Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                <TextBlock Text="Does not repeat"
                           IsVisible="{Binding !SelectedDetailTask.HasRecurrence}"
                           FontSize="13"
                           FontStyle="Italic"
                           Foreground="{DynamicResource AppTextSecondaryBrush}"/>
              </Panel>
            </Grid>

            <!-- Tags / Categories -->
            <Grid ColumnDefinitions="Auto,*" MinHeight="24">
              <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top" Height="20" Width="95">
                <PathIcon Data="{StaticResource TagIconData}" Width="14" Height="14" Foreground="{DynamicResource AppPrimaryBrush}" VerticalAlignment="Center"/>
                <TextBlock Text="Tags" FontSize="13" FontWeight="Medium" VerticalAlignment="Center"/>
              </StackPanel>

              <Panel Grid.Column="1" VerticalAlignment="Top">
                <ItemsControl ItemsSource="{Binding SelectedDetailTask.Categories}" IsVisible="{Binding SelectedDetailTask.HasCategories}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Background="{DynamicResource AppPrimaryBrush}"
                              CornerRadius="4"
                              Padding="8,3"
                              Margin="0,0,6,6"
                              VerticalAlignment="Top">
                        <TextBlock Text="{Binding}" FontSize="11" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="No tags assigned"
                           IsVisible="{Binding !SelectedDetailTask.HasCategories}"
                           FontSize="13"
                           FontStyle="Italic"
                           Foreground="{DynamicResource AppTextSecondaryBrush}"
                           VerticalAlignment="Center"/>
              </Panel>
            </Grid>
          </StackPanel>

        </StackPanel>
      </ScrollViewer>

      <!-- ── Drawer Footer ── -->
      <Border Grid.Row="3" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,12,0,0">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
            <TextBlock Text="{Binding SelectedDetailTask.CreatedAt, StringFormat='Created {0:MMM d, yyyy}'}"
                       FontSize="11"
                       Foreground="{DynamicResource AppTextSecondaryBrush}"/>
            <TextBlock Text="{Binding SelectedDetailTask.CompletedAtFormatted}"
                       IsVisible="{Binding SelectedDetailTask.HasCompletedAt}"
                       FontSize="11"
                       Foreground="{DynamicResource AppAccentSuccessBrush}"/>
          </StackPanel>

          <Button Grid.Column="1"
                  Classes="danger"
                  Command="{Binding DeleteTodoCommand}"
                  CommandParameter="{Binding SelectedDetailTask}"
                  ToolTip.Tip="Delete task">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Data="{StaticResource CloseIconData}" Width="12" Height="12"/>
              <TextBlock Text="Delete" FontSize="12" FontWeight="SemiBold"/>
            </StackPanel>
          </Button>
        </Grid>
      </Border>

    </Grid>
  </Border>
</UserControl>
