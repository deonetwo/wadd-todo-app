<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Wadd.UI.ViewModels;assembly=Wadd.UI"
             xmlns:controls="clr-namespace:Wadd.UI.Controls;assembly=Wadd.UI"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="700"
             x:Class="Wadd.UI.Views.SearchView"
             x:DataType="vm:MainViewModel">

  <UserControl.Styles>
    <Style Selector="StackPanel.view-container">
      <Setter Property="Margin" Value="64,52,80,120"/>
    </Style>
    <Style Selector="StackPanel.view-container.compact">
      <Setter Property="Margin" Value="16,20,16,40"/>
    </Style>
  </UserControl.Styles>

  <Panel>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Classes="view-container" Classes.compact="{Binding IsCompact}" Spacing="0">

        <!-- Page Header -->
        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,16">
          <StackPanel Grid.Column="0" Spacing="4">
            <TextBlock Text="FULL-TEXT SEARCH"
                       Classes="micro"
                       Foreground="{DynamicResource AppPrimaryBrush}"
                       Margin="0,0,0,2"/>
            <TextBlock Text="Search Tasks &amp; Notes" Classes="display-xl"/>
            <TextBlock Text="Find anything across titles, detailed descriptions, sub-steps, and tags"
                       Classes="small"
                       Foreground="{DynamicResource AppTextSecondaryBrush}"/>
          </StackPanel>
        </Grid>

        <!-- Divider -->
        <Separator Classes="divider" Margin="0,8,0,24"/>

        <!-- ── Search Control Bar ── -->
        <StackPanel Spacing="16" Margin="0,0,0,24">
          <!-- Main Search Input + Dedicated Primary Search Button -->
          <Grid ColumnDefinitions="*,Auto">
            <TextBox Grid.Column="0"
                     x:Name="SearchInputBox"
                     Classes="search-composer"
                     PlaceholderText="Search by title, description notes, or tags…"
                     Text="{Binding SearchQuery, Mode=TwoWay}"
                     FontSize="20"
                     FontWeight="Medium"
                     Padding="14,8"
                     Height="44"
                     CornerRadius="0"
                     HorizontalAlignment="Stretch">
              <TextBox.KeyBindings>
                <KeyBinding Gesture="Enter" Command="{Binding ExecuteSearchCommand}"/>
              </TextBox.KeyBindings>
              <TextBox.InnerRightContent>
                <Button Classes="icon-btn"
                        Command="{Binding ClearSearchQueryCommand}"
                        IsVisible="{Binding SearchQuery, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                        Width="24" Height="24" Padding="0"
                        Margin="0,0,4,0"
                        VerticalAlignment="Center"
                        ToolTip.Tip="Clear search">
                  <PathIcon Data="{StaticResource CloseIconData}" Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
              </TextBox.InnerRightContent>
            </TextBox>

            <!-- Dedicated Primary Search Button (Modern composer-add style, adaptive for desktop & mobile) -->
            <Button Grid.Column="1"
                    Classes="composer-add"
                    Command="{Binding ExecuteSearchCommand}"
                    IsDefault="True"
                    Height="44"
                    Margin="12,0,0,0"
                    VerticalAlignment="Center"
                    ToolTip.Tip="Start search (Enter)">
              <Panel>
                <!-- Desktop Button Content (Circular Icon Badge + Text) -->
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" IsVisible="{Binding !IsCompact}">
                  <Border Width="20" Height="20" CornerRadius="10" Background="#33FFFFFF" VerticalAlignment="Center">
                    <PathIcon Data="{StaticResource SearchIconData}"
                              Width="10" Height="10"
                              Foreground="#F0FDFA"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
                  </Border>
                  <TextBlock Text="Search" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Mobile / Portrait Compact Button Content -->
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" IsVisible="{Binding IsCompact}">
                  <PathIcon Data="{StaticResource SearchIconData}"
                            Width="14" Height="14"
                            Foreground="#F0FDFA"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>
                  <TextBlock Text="Search" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
              </Panel>
            </Button>
          </Grid>

          <!-- Filter Chips Row -->
          <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
            <!-- Filter Option: All -->
            <RadioButton Content="All Tasks"
                         GroupName="SearchFilter"
                         IsChecked="True"
                         Command="{Binding SetSearchStatusFilterCommand}"
                         CommandParameter="All"
                         Margin="0,0,8,6"
                         FontSize="12"
                         FontWeight="SemiBold"/>

            <!-- Filter Option: Active Only -->
            <RadioButton Content="Active"
                         GroupName="SearchFilter"
                         Command="{Binding SetSearchStatusFilterCommand}"
                         CommandParameter="Active"
                         Margin="0,0,8,6"
                         FontSize="12"
                         FontWeight="SemiBold"/>

            <!-- Filter Option: Completed Only -->
            <RadioButton Content="Completed"
                         GroupName="SearchFilter"
                         Command="{Binding SetSearchStatusFilterCommand}"
                         CommandParameter="Completed"
                         Margin="0,0,8,6"
                         FontSize="12"
                         FontWeight="SemiBold"/>

            <!-- Filter Option: With Notes -->
            <RadioButton Content="With Notes"
                         GroupName="SearchFilter"
                         Command="{Binding SetSearchStatusFilterCommand}"
                         CommandParameter="WithNotes"
                         Margin="0,0,8,6"
                         FontSize="12"
                         FontWeight="SemiBold"/>
          </WrapPanel>
        </StackPanel>

        <!-- ── Search Results Section ── -->
        <StackPanel IsVisible="{Binding SearchQuery, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">

          <!-- Results Counter -->
          <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,0,12" VerticalAlignment="Center">
            <TextBlock Text="SEARCH RESULTS" Classes="micro" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
            <Border Background="{DynamicResource AppSurfaceElevatedBrush}" CornerRadius="10" Padding="6,1" VerticalAlignment="Center">
              <TextBlock Text="{Binding SearchResultsTodoItems.Count}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AppPrimaryBrush}"/>
            </Border>
          </StackPanel>

          <!-- Results List -->
          <ItemsControl ItemsSource="{Binding SearchResultsTodoItems}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:TodoItemViewModel">
                <Border Classes="task-row" Classes.completed="{Binding IsCompleted}" Margin="0,0,0,8">
                  <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                    <!-- Checkbox -->
                    <CheckBox Grid.Column="0"
                              Classes="task-checkbox"
                              IsChecked="{Binding IsCompleted, Mode=OneWay}"
                              Command="{Binding $parent[UserControl].DataContext.ToggleTodoCommand}"
                              CommandParameter="{Binding}"/>

                    <!-- Task metadata (Click opens detail drawer) -->
                    <Button Grid.Column="1"
                            Classes="task-row-btn"
                            Command="{Binding $parent[UserControl].DataContext.OpenDetailDrawerCommand}"
                            CommandParameter="{Binding}"
                            Padding="0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            ToolTip.Tip="Click to open task details &amp; notes">
                      <StackPanel Spacing="3" VerticalAlignment="Center">
                        <!-- Task Title Row with Note Indicator -->
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Title}"
                                     Classes="body-bold task-title"
                                     FontSize="14"
                                     TextWrapping="Wrap"/>
                          <PathIcon Data="{StaticResource NoteIconData}"
                                    Width="12" Height="12"
                                    Foreground="{DynamicResource AppPrimaryBrush}"
                                    IsVisible="{Binding HasDescription}"
                                    VerticalAlignment="Center"
                                    ToolTip.Tip="Has note"/>
                        </StackPanel>

                        <!-- Note preview (Markdown rendered) -->
                        <Panel IsVisible="{Binding HasDescription}" IsHitTestVisible="False">
                          <controls:MarkdownTextBlock MarkdownText="{Binding DescriptionPreview}"
                                                      IsVisible="{Binding $parent[UserControl].DataContext.ShowNotePreviewsInList}"
                                                      FontSize="12"
                                                      Foreground="{DynamicResource AppTextSecondaryBrush}"
                                                      Opacity="0.85"
                                                      MaxLines="2"
                                                      TextTrimming="CharacterEllipsis"/>
                        </Panel>

                        <!-- Badges -->
                        <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding HasAnyBadges}">
                          <!-- Due Date Badge -->
                          <Border IsVisible="{Binding HasDueDate}"
                                  Background="{DynamicResource AppPrimarySubtleBrush}"
                                  CornerRadius="4"
                                  Padding="6,2"
                                  HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                              <PathIcon Data="{StaticResource CalendarIconData}" Width="10" Height="10" Foreground="{DynamicResource AppPrimaryBrush}"/>
                              <TextBlock Text="{Binding DueDateFormatted}" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource AppPrimaryBrush}"/>
                            </StackPanel>
                          </Border>

                          <!-- Reminder Badge -->
                          <Border IsVisible="{Binding HasReminder}"
                                  Background="{DynamicResource AppPrimarySubtleBrush}"
                                  CornerRadius="4"
                                  Padding="6,2"
                                  HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                              <PathIcon Data="{StaticResource BellIconData}" Width="10" Height="10" Foreground="{DynamicResource AppPrimaryBrush}"/>
                              <TextBlock Text="{Binding ReminderAtFormatted}" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource AppPrimaryBrush}"/>
                            </StackPanel>
                          </Border>

                          <!-- Repeat Badge -->
                          <Border IsVisible="{Binding HasRecurrence}"
                                  Background="{DynamicResource AppPrimarySubtleBrush}"
                                  CornerRadius="4"
                                  Padding="6,2"
                                  HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                              <PathIcon Data="{StaticResource RepeatIconData}" Width="10" Height="10" Foreground="{DynamicResource AppPrimaryBrush}"/>
                              <TextBlock Text="{Binding RecurrenceFormatted}" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource AppPrimaryBrush}"/>
                            </StackPanel>
                          </Border>
                        </StackPanel>

                        <!-- Category / Tag Badges -->
                        <ItemsControl ItemsSource="{Binding Categories}" IsVisible="{Binding HasCategories}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <Border Background="{DynamicResource AppTagBackgroundBrush}"
                                      CornerRadius="4"
                                      Padding="6,2"
                                      Margin="0,0,4,3"
                                      HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                  <PathIcon Data="{StaticResource TagIconData}" Width="10" Height="10" Foreground="{DynamicResource AppTagForegroundBrush}"/>
                                  <TextBlock Text="{Binding}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppTagForegroundBrush}"/>
                                </StackPanel>
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>

                      </StackPanel>
                    </Button>

                    <!-- Created Date -->
                    <TextBlock Grid.Column="2"
                               Text="{Binding CreatedAt, StringFormat='{}{0:MMM d}'}"
                               Classes="small"
                               VerticalAlignment="Center"
                               Margin="14,0,6,0"/>

                    <!-- Delete Button -->
                    <Button Grid.Column="3"
                            Classes="danger"
                            Command="{Binding $parent[UserControl].DataContext.DeleteTodoCommand}"
                            CommandParameter="{Binding}"
                            VerticalAlignment="Center"
                            ToolTip.Tip="Delete task">
                      <PathIcon Data="{StaticResource CloseIconData}" Width="12" Height="12"/>
                    </Button>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <!-- No Results Match State -->
          <StackPanel IsVisible="{Binding !HasSearchResults}"
                      HorizontalAlignment="Center"
                      Margin="0,48,0,0"
                      Spacing="12">
            <PathIcon Data="{StaticResource SearchIconData}"
                      Width="44" Height="44"
                      Foreground="{DynamicResource AppBorderBrush}"
                      HorizontalAlignment="Center"/>
            <TextBlock Text="No matching tasks found"
                       Classes="heading"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource AppTextSecondaryBrush}"/>
            <TextBlock Text="Try searching with a different keyword or changing status filters."
                       Classes="small"
                       HorizontalAlignment="Center"/>
          </StackPanel>

        </StackPanel>

        <!-- Initial Empty Search State (When query is empty) -->
        <StackPanel IsVisible="{Binding SearchQuery, Converter={x:Static StringConverters.IsNullOrEmpty}}"
                    HorizontalAlignment="Center"
                    Margin="0,64,0,0"
                    Spacing="14">
          <PathIcon Data="{StaticResource SearchIconData}"
                    Width="48" Height="48"
                    Foreground="{DynamicResource AppPrimaryBrush}"
                    HorizontalAlignment="Center"
                    Opacity="0.8"/>
          <TextBlock Text="Search Wadd ToDo"
                     Classes="heading"
                     HorizontalAlignment="Center"
                     Foreground="{DynamicResource AppTextPrimaryBrush}"/>
          <TextBlock Text="Type any keyword above to search through task titles, notes, and tags."
                     Classes="small"
                     HorizontalAlignment="Center"
                     Foreground="{DynamicResource AppTextSecondaryBrush}"/>
        </StackPanel>

      </StackPanel>
    </ScrollViewer>
  </Panel>
</UserControl>
