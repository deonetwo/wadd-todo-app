<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:Wadd.UI.Views;assembly=Wadd.UI"
        xmlns:vm="clr-namespace:Wadd.UI.ViewModels;assembly=Wadd.UI"
        mc:Ignorable="d" d:DesignWidth="1080" d:DesignHeight="720"
        x:Class="Wadd.UI.Views.ConflictResolutionWindow"
        x:DataType="vm:ConflictResolutionViewModel"
        Title="Review Task Changes"
        Width="1080" Height="720"
        MinWidth="880" MinHeight="580"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}">

  <views:ConflictResolutionView/>

</Window>
