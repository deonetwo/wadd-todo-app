<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Wadd.UI.ViewModels;assembly=Wadd.UI"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="700"
             x:Class="Wadd.UI.Views.RecurringTasksView"
             x:DataType="vm:MainViewModel">

  <UserControl.Styles>
    <Style Selector="StackPanel.view-container">
      <Setter Property="Margin" Value="64,52,80,120"/>
    </Style>
    <Style Selector="StackPanel.view-container.compact">
      <Setter Property="Margin" Value="16,20,16,40"/>
    </Style>
  </UserControl.Styles>

  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Classes="view-container" Classes.compact="{Binding IsCompact}" Spacing="0">

      <!-- Page Header -->
      <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,16">
        <StackPanel Grid.Column="0" Spacing="4">
          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <PathIcon Data="{StaticResource RepeatIconData}" Width="18" Height="18" Foreground="{DynamicResource AppPrimaryBrush}"/>
            <TextBlock Text="Repeating Tasks" Classes="display"/>
          </StackPanel>
          <TextBlock Text="Overview of all scheduled repeating tasks."
                     Classes="small"
                     Foreground="{DynamicResource AppTextSecondaryBrush}"/>
        </StackPanel>

        <!-- Toolbar & Count badge -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <!-- Category Filter Dropdown Button (Desktop) -->
          <Button Classes="outline"
                  IsVisible="{Binding !$parent[UserControl].DataContext.IsCompact}"
                  Padding="10,6"
                  CornerRadius="8"
                  Background="{DynamicResource AppSurfaceBrush}"
                  BorderBrush="{DynamicResource AppBorderBrush}"
                  ToolTip.Tip="Filter tasks by Tag">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <PathIcon Data="{StaticResource TagIconData}" Width="13" Height="13" Foreground="{DynamicResource AppPrimaryBrush}" VerticalAlignment="Center"/>
              <TextBlock Text="{Binding CategoryFilterButtonText}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
              <PathIcon Data="{StaticResource ChevronDownIconData}" Width="10" Height="10" Foreground="{DynamicResource AppTextSecondaryBrush}" VerticalAlignment="Center" Margin="2,0,0,0"/>
            </StackPanel>
            <Button.Flyout>
              <Flyout Placement="BottomEdgeAlignedLeft">
                <StackPanel Spacing="6" Width="200">
                  <TextBlock Text="FILTER BY TAG" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="4,2,0,4"/>
                  <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding CategoryFilterOptions}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <CheckBox Content="{Binding Name}"
                                    IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                    Margin="4,3"
                                    FontSize="12"
                                    FontWeight="Medium"/>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                  <Separator Classes="divider" Margin="0,4"/>
                  <Button Classes="ghost"
                          Command="{Binding OpenTagsViewCommand}"
                          CommandParameter="{Binding $parent[Button].Flyout}"
                          x:CompileBindings="False"
                          Foreground="{DynamicResource AppPrimaryBrush}"
                          FontWeight="SemiBold"
                          HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Left">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                      <PathIcon Data="{StaticResource SettingsIconData}" Width="12" Height="12"/>
                      <TextBlock Text="Manage Tags..." FontSize="12"/>
                    </StackPanel>
                  </Button>
                </StackPanel>
              </Flyout>
            </Button.Flyout>
          </Button>

          <Border Background="{DynamicResource AppSurfaceElevatedBrush}"
                  CornerRadius="12"
                  Padding="12,6"
                  VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <TextBlock Text="{Binding AllRecurringTodoItems.Count}"
                         FontSize="14"
                         FontWeight="Bold"
                         Foreground="{DynamicResource AppPrimaryBrush}"/>
              <TextBlock Text="repeating"
                         FontSize="12"
                         Foreground="{DynamicResource AppTextSecondaryBrush}"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>

      <!-- Dedicated Tag Filter Row (Compact / Portrait mode) -->
      <StackPanel IsVisible="{Binding IsCompact}" Margin="0,0,0,16" HorizontalAlignment="Left">
        <Button Classes="outline"
                Command="{Binding OpenMobileTagFilterSheetCommand}"
                Padding="10,6"
                CornerRadius="8"
                Background="{DynamicResource AppSurfaceBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}"
                ToolTip.Tip="Filter tasks by Tag">
          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <PathIcon Data="{StaticResource TagIconData}" Width="13" Height="13" Foreground="{DynamicResource AppPrimaryBrush}" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding CategoryFilterButtonText}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <PathIcon Data="{StaticResource ChevronDownIconData}" Width="10" Height="10" Foreground="{DynamicResource AppTextSecondaryBrush}" VerticalAlignment="Center" Margin="2,0,0,0"/>
          </StackPanel>
        </Button>
      </StackPanel>

      <!-- Recurring Task List -->
      <StackPanel IsVisible="{Binding HasAllRecurringTodoItems}">
        <ItemsControl ItemsSource="{Binding AllRecurringTodoItems}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:TodoItemViewModel">
              <Border Classes="task-row" Classes.completed="{Binding IsCompleted}">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                  <!-- Checkbox -->
                  <CheckBox Grid.Column="0"
                            Classes="task-checkbox"
                            IsChecked="{Binding IsCompleted, Mode=OneWay}"
                            Command="{Binding $parent[UserControl].DataContext.ToggleTodoCommand}"
                            CommandParameter="{Binding}"/>

                  <!-- Task metadata -->
                  <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}"
                               Classes="body-bold task-title"
                               FontSize="14"
                               TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding Description}"
                               Classes="small"
                               IsVisible="{Binding Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                               TextWrapping="Wrap"/>
                    <!-- Badges (Recurring Pattern & Next Due Date) -->
                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2,0,0">
                      <!-- Recurrence Pattern Badge -->
                      <Border Background="{DynamicResource AppAccentTintBrush}"
                              BorderBrush="{DynamicResource AppAccentBrush}"
                              BorderThickness="1"
                              CornerRadius="4"
                              Padding="6,2"
                              HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                          <PathIcon Data="{StaticResource RepeatIconData}" Width="10" Height="10" Foreground="{DynamicResource AppPrimaryBrush}"/>
                          <TextBlock Text="{Binding RecurrenceFormatted}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppPrimaryBrush}"/>
                        </StackPanel>
                      </Border>

                      <!-- Overdue Date Badge -->
                      <Border IsVisible="{Binding IsOverdue}"
                              Background="{DynamicResource AppAccentDangerSubtleBrush}"
                              CornerRadius="4"
                              Padding="6,2"
                              HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                          <PathIcon Data="{StaticResource CalendarIconData}" Width="10" Height="10" Foreground="{DynamicResource AppAccentDangerBrush}"/>
                          <TextBlock Text="{Binding DueDateFormatted}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AppAccentDangerBrush}"/>
                        </StackPanel>
                      </Border>

                      <!-- Normal Due Date Badge -->
                      <Border IsVisible="{Binding HasDueDateOnly}"
                              Background="{DynamicResource AppPrimarySubtleBrush}"
                              CornerRadius="4"
                              Padding="6,2"
                              HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                          <PathIcon Data="{StaticResource CalendarIconData}" Width="10" Height="10" Foreground="{DynamicResource AppPrimaryBrush}"/>
                          <TextBlock Text="{Binding DueDateFormatted}" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource AppPrimaryBrush}"/>
                        </StackPanel>
                      </Border>

                    </StackPanel>

                    <!-- Category Badges (Dedicated Row) -->
                    <ItemsControl ItemsSource="{Binding Categories}" IsVisible="{Binding HasCategories}" Margin="0,3,0,0">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border Background="{DynamicResource AppPrimaryBrush}"
                                  CornerRadius="4"
                                  Padding="6,2"
                                  Margin="0,0,4,3"
                                  HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                              <PathIcon Data="{StaticResource TagIconData}" Width="10" Height="10" Foreground="#FFFFFF"/>
                              <TextBlock Text="{Binding}" FontSize="11" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>

                  <!-- Timestamp -->
                  <TextBlock Grid.Column="2"
                             Text="{Binding CreatedAt, StringFormat='{}{0:MMM d}'}"
                             IsVisible="{Binding !$parent[UserControl].DataContext.IsCompact}"
                             Classes="small"
                             VerticalAlignment="Center"
                             Margin="14,0,6,0"/>

                  <!-- Delete -->
                  <Button Grid.Column="3"
                          Classes="danger"
                          Command="{Binding $parent[UserControl].DataContext.DeleteTodoCommand}"
                          CommandParameter="{Binding}"
                          VerticalAlignment="Center"
                          ToolTip.Tip="Delete task pattern">
                    <PathIcon Data="{StaticResource CloseIconData}" Width="12" Height="12"/>
                  </Button>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <!-- Empty state -->
      <StackPanel IsVisible="{Binding !AllRecurringTodoItems.Count}"
                  HorizontalAlignment="Center"
                  Margin="0,72,0,0"
                  Spacing="14">
        <PathIcon Data="{StaticResource RepeatIconData}"
                  Width="40" Height="40"
                  Foreground="{DynamicResource AppBorderBrush}"
                  HorizontalAlignment="Center"/>
        <TextBlock Text="No recurring tasks setup"
                   Classes="heading"
                   HorizontalAlignment="Center"
                   Foreground="{DynamicResource AppTextSecondaryBrush}"/>
        <TextBlock Text="Set a repeat rule when creating a task to automate recurring to-dos."
                   Classes="small"
                   HorizontalAlignment="Center"/>
      </StackPanel>

    </StackPanel>
  </ScrollViewer>
</UserControl>
