<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Wadd.UI.ViewModels;assembly=Wadd.UI"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="800"
             x:Class="Wadd.UI.Views.CalendarView"
             x:DataType="vm:MainViewModel">

  <UserControl.Styles>
    <!-- Filter Toggle Button Pill Style aligned with Dark Emerald Theme -->
    <Style Selector="ToggleButton.filter-pill">
      <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="12,5"/>
      <Setter Property="CornerRadius" Value="14"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.15"/>
          <BrushTransition Property="Foreground" Duration="0:0:0.15"/>
          <BrushTransition Property="BorderBrush" Duration="0:0:0.15"/>
        </Transitions>
      </Setter>
    </Style>

    <!-- Pointerover Unchecked -->
    <Style Selector="ToggleButton.filter-pill:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AppSurfaceElevatedBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
    </Style>

    <!-- Checked State (Active Filter Highlight - Wadd Emerald) -->
    <Style Selector="ToggleButton.filter-pill:checked /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AppPrimaryBrush}"/>
      <Setter Property="Foreground" Value="#FFFFFF"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AppPrimaryBrush}"/>
    </Style>

    <!-- Checked State Hover -->
    <Style Selector="ToggleButton.filter-pill:checked:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#059669"/>
      <Setter Property="Foreground" Value="#FFFFFF"/>
      <Setter Property="BorderBrush" Value="#059669"/>
    </Style>
  </UserControl.Styles>

  <Panel>
    <!-- ══════════════ LEFT / CENTER CALENDAR SECTION ══════════════ -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="16,16,16,32" Spacing="0">

        <!-- Page Header (Adaptive Layout: Landscape vs Portrait) -->
        <!-- Landscape Mode Header -->
        <Grid IsVisible="{Binding !IsSingleColumnCalendar}" ColumnDefinitions="*,Auto" Margin="0,0,0,24">
          <StackPanel Grid.Column="0" Spacing="6">
            <TextBlock Text="CALENDAR &amp; TIMELINE" Classes="micro" Foreground="{DynamicResource AppPrimaryBrush}"/>
            
            <!-- Editable Month & Year Selectors -->
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
              <ComboBox ItemsSource="{Binding MonthOptions}"
                        SelectedIndex="{Binding SelectedMonthIndex}"
                        FontSize="20"
                        FontWeight="Bold"
                        Padding="10,4"
                        MinWidth="150"
                        CornerRadius="8"
                        Background="{DynamicResource AppSurfaceBrush}"
                        BorderBrush="{DynamicResource AppBorderBrush}"
                        ToolTip.Tip="Select month"/>

              <ComboBox ItemsSource="{Binding YearOptions}"
                        SelectedItem="{Binding SelectedYear}"
                        FontSize="20"
                        FontWeight="Bold"
                        Padding="10,4"
                        MinWidth="100"
                        CornerRadius="8"
                        Background="{DynamicResource AppSurfaceBrush}"
                        BorderBrush="{DynamicResource AppBorderBrush}"
                        ToolTip.Tip="Select year"/>
            </StackPanel>

            <TextBlock Text="Upcoming task schedule, deadline overview, and repeating task occurrences."
                       Classes="small"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource AppTextSecondaryBrush}"/>
          </StackPanel>

          <!-- Navigation Controls -->
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
            <Button Classes="outline" Command="{Binding JumpToTodayCommand}" Padding="12,6">
              <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <PathIcon Data="{StaticResource CalendarIconData}" Width="12" Height="12" Foreground="{DynamicResource AppPrimaryBrush}"/>
                <TextBlock Text="Today" FontSize="12" FontWeight="SemiBold"/>
              </StackPanel>
            </Button>
            <Button Classes="icon-btn" Command="{Binding PreviousMonthCommand}" ToolTip.Tip="Previous month">
              <TextBlock Text="◄" FontSize="12"/>
            </Button>
            <Button Classes="icon-btn" Command="{Binding NextMonthCommand}" ToolTip.Tip="Next month">
              <TextBlock Text="►" FontSize="12"/>
            </Button>
          </StackPanel>
        </Grid>

        <!-- Portrait Mode Header -->
        <StackPanel IsVisible="{Binding IsSingleColumnCalendar}" Spacing="12" Margin="0,0,0,16">
          <TextBlock Text="CALENDAR &amp; TIMELINE" Classes="micro" Foreground="{DynamicResource AppPrimaryBrush}"/>

          <!-- Editable Month & Year Selectors -->
          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <ComboBox ItemsSource="{Binding MonthOptions}"
                      SelectedIndex="{Binding SelectedMonthIndex}"
                      FontSize="18"
                      FontWeight="Bold"
                      Padding="8,4"
                      CornerRadius="8"
                      Background="{DynamicResource AppSurfaceBrush}"
                      BorderBrush="{DynamicResource AppBorderBrush}"/>

            <ComboBox ItemsSource="{Binding YearOptions}"
                      SelectedItem="{Binding SelectedYear}"
                      FontSize="18"
                      FontWeight="Bold"
                      Padding="8,4"
                      CornerRadius="8"
                      Background="{DynamicResource AppSurfaceBrush}"
                      BorderBrush="{DynamicResource AppBorderBrush}"/>
          </StackPanel>

          <!-- Controls Bar -->
          <WrapPanel Orientation="Horizontal" Margin="0,2,0,0">
            <Button Classes="outline" Command="{Binding JumpToTodayCommand}" Padding="10,5" Margin="0,0,8,6">
              <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <PathIcon Data="{StaticResource CalendarIconData}" Width="12" Height="12" Foreground="{DynamicResource AppPrimaryBrush}"/>
                <TextBlock Text="Today" FontSize="12" FontWeight="SemiBold"/>
              </StackPanel>
            </Button>

            <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,0,6">
              <Button Classes="icon-btn" Command="{Binding PreviousMonthCommand}" ToolTip.Tip="Previous month">
                <TextBlock Text="◄" FontSize="12"/>
              </Button>
              <Button Classes="icon-btn" Command="{Binding NextMonthCommand}" ToolTip.Tip="Next month">
                <TextBlock Text="►" FontSize="12"/>
              </Button>
            </StackPanel>
          </WrapPanel>
        </StackPanel>

        <Separator Classes="divider" Margin="0,0,0,14"/>

        <!-- Recurrence & Task Filter Toggle Pills Bar (Responsive WrapPanel) -->
        <WrapPanel Orientation="Horizontal" Margin="0,0,0,16">
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,0,8,6">
            <PathIcon Data="{StaticResource TracingIconData}" Width="13" Height="13" Foreground="{DynamicResource AppPrimaryBrush}"/>
            <TextBlock Text="Filter:" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimaryBrush}"/>
          </StackPanel>

          <ToggleButton IsChecked="{Binding IsStandardFilterEnabled}" Classes="filter-pill" ToolTip.Tip="Toggle One-off Tasks" Margin="0,0,6,6">
            <TextBlock Text="One-off"/>
          </ToggleButton>
          <ToggleButton IsChecked="{Binding IsDailyFilterEnabled}" Classes="filter-pill" ToolTip.Tip="Toggle Daily Tasks" Margin="0,0,6,6">
            <TextBlock Text="Daily"/>
          </ToggleButton>
          <ToggleButton IsChecked="{Binding IsWeekdaysFilterEnabled}" Classes="filter-pill" ToolTip.Tip="Toggle Weekdays Tasks" Margin="0,0,6,6">
            <TextBlock Text="Weekdays"/>
          </ToggleButton>
          <ToggleButton IsChecked="{Binding IsWeeklyFilterEnabled}" Classes="filter-pill" ToolTip.Tip="Toggle Weekly Tasks" Margin="0,0,6,6">
            <TextBlock Text="Weekly"/>
          </ToggleButton>
          <ToggleButton IsChecked="{Binding IsMonthlyFilterEnabled}" Classes="filter-pill" ToolTip.Tip="Toggle Monthly Tasks" Margin="0,0,6,6">
            <TextBlock Text="Monthly"/>
          </ToggleButton>
          <ToggleButton IsChecked="{Binding IsYearlyFilterEnabled}" Classes="filter-pill" ToolTip.Tip="Toggle Yearly Tasks" Margin="0,0,6,6">
            <TextBlock Text="Yearly"/>
          </ToggleButton>

          <Separator Classes="divider" Width="1" Height="16" Margin="2,0,8,6"/>

          <ToggleButton IsChecked="{Binding IsCompletedFilterEnabled}" Classes="filter-pill" ToolTip.Tip="Toggle Completed Tasks" Margin="0,0,6,6">
            <TextBlock Text="Completed"/>
          </ToggleButton>
        </WrapPanel>

        <!-- ════════ 7-Column Month Grid View ════════ -->
        <StackPanel IsVisible="{Binding !IsSingleColumnCalendar}">
          <!-- Weekday Headers Row (Sun-Sat) -->
          <UniformGrid Columns="7" Margin="0,0,0,8">
            <TextBlock Text="SUN" HorizontalAlignment="Center" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
            <TextBlock Text="MON" HorizontalAlignment="Center" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
            <TextBlock Text="TUE" HorizontalAlignment="Center" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
            <TextBlock Text="WED" HorizontalAlignment="Center" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
            <TextBlock Text="THU" HorizontalAlignment="Center" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
            <TextBlock Text="FRI" HorizontalAlignment="Center" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
            <TextBlock Text="SAT" HorizontalAlignment="Center" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
          </UniformGrid>

          <!-- 42-Cell Month Grid -->
          <ItemsControl ItemsSource="{Binding CalendarDays}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Columns="7"/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:CalendarDayViewModel">
                <Button Classes="calendar-day-btn"
                        Command="{Binding $parent[UserControl].DataContext.SelectDayCommand}"
                        CommandParameter="{Binding}">
                  <Button.Styles>
                    <Style Selector="Button.calendar-day-btn">
                      <Setter Property="CornerRadius" Value="10"/>
                      <Setter Property="Padding" Value="0"/>
                      <Setter Property="Margin" Value="3"/>
                      <Setter Property="Background" Value="Transparent"/>
                      <Setter Property="BorderThickness" Value="0"/>
                      <Setter Property="HorizontalAlignment" Value="Stretch"/>
                      <Setter Property="VerticalAlignment" Value="Stretch"/>
                      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                      <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                      <Setter Property="Cursor" Value="Hand"/>
                    </Style>
                    <Style Selector="Button.calendar-day-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                      <Setter Property="Background" Value="Transparent"/>
                      <Setter Property="CornerRadius" Value="10"/>
                    </Style>
                    <Style Selector="Button.calendar-day-btn:pointerover /template/ ContentPresenter">
                      <Setter Property="Background" Value="Transparent"/>
                      <Setter Property="CornerRadius" Value="10"/>
                    </Style>
                  </Button.Styles>

                  <Border Height="112"
                          Padding="9"
                          CornerRadius="10"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Classes.inactive="{Binding !IsCurrentMonth}"
                          Classes.selected="{Binding IsSelected}">
                    <Border.Styles>
                      <!-- Active Month Base Card -->
                      <Style Selector="Border">
                        <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="Transitions">
                          <Transitions>
                            <BrushTransition Property="Background" Duration="0:0:0.15"/>
                            <BrushTransition Property="BorderBrush" Duration="0:0:0.15"/>
                          </Transitions>
                        </Setter>
                      </Style>

                      <!-- Active Card Hover Effect (Exact CornerRadius 10) -->
                      <Style Selector="Border:pointerover">
                        <Setter Property="Background" Value="{DynamicResource AppSurfaceSubtleBrush}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource AppPrimaryBrush}"/>
                      </Style>

                      <!-- Inactive Month Card -->
                      <Style Selector="Border.inactive">
                        <Setter Property="Background" Value="{DynamicResource AppSurfaceSubtleBrush}"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>
                        <Setter Property="Opacity" Value="0.45"/>
                      </Style>

                      <!-- Today Card Highlight -->
                      <Style Selector="Border.today">
                        <Setter Property="BorderBrush" Value="{DynamicResource AppPrimaryBrush}"/>
                        <Setter Property="BorderThickness" Value="2"/>
                      </Style>

                      <!-- Selected Day Highlight -->
                      <Style Selector="Border.selected">
                        <Setter Property="Background" Value="{DynamicResource AppPrimarySubtleBrush}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource AppPrimaryBrush}"/>
                        <Setter Property="BorderThickness" Value="2"/>
                      </Style>
                    </Border.Styles>

                    <Grid RowDefinitions="Auto,*">
                      <!-- Day Header: Date Number + Today Pill -->
                      <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                        <TextBlock Grid.Column="0"
                                   Text="{Binding DayNumberText}"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource AppTextPrimaryBrush}"/>

                        <!-- Today Indicator Badge -->
                        <Border Grid.Column="1"
                                IsVisible="{Binding IsToday}"
                                Background="{DynamicResource AppPrimaryBrush}"
                                CornerRadius="8"
                                Padding="5,1">
                          <TextBlock Text="TODAY"
                                     FontSize="9"
                                     FontWeight="Bold"
                                     Foreground="#FFFFFF"/>
                        </Border>
                      </Grid>

                      <!-- Day Content: Task List Badges -->
                      <StackPanel Grid.Row="1" Spacing="3">
                        <ItemsControl ItemsSource="{Binding VisibleTasks}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:TodoItemViewModel">
                              <Border Background="{DynamicResource AppSurfaceSubtleBrush}"
                                      CornerRadius="5"
                                      Padding="5,3"
                                      Margin="0,1"
                                      Classes.completed="{Binding IsCompleted}">
                                <Border.Styles>
                                  <Style Selector="Border.completed">
                                    <Setter Property="Opacity" Value="0.5"/>
                                  </Style>
                                </Border.Styles>

                                <Grid ColumnDefinitions="Auto,*,Auto">
                                  <!-- Priority Accent Dot -->
                                  <Border Grid.Column="0"
                                          Width="5" Height="5"
                                          CornerRadius="3"
                                          Background="{DynamicResource AppPrimaryBrush}"
                                          VerticalAlignment="Center"
                                          Margin="0,0,5,0"/>

                                  <!-- Task Title -->
                                  <TextBlock Grid.Column="1"
                                             Text="{Binding Title}"
                                             FontSize="10"
                                             FontWeight="Medium"
                                             Foreground="{DynamicResource AppTextPrimaryBrush}"
                                             TextTrimming="CharacterEllipsis"/>

                                  <!-- Mini Recurrence Indicator Icon -->
                                  <PathIcon Grid.Column="2"
                                            IsVisible="{Binding HasRecurrence}"
                                            Data="{StaticResource RepeatIconData}"
                                            Width="8" Height="8"
                                            Foreground="{DynamicResource AppAccentBrush}"
                                            Margin="3,0,0,0"
                                            VerticalAlignment="Center"/>
                                </Grid>
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Overflow Badge (+X more) -->
                        <Border IsVisible="{Binding HasOverflow}"
                                Background="{DynamicResource AppAccentTintBrush}"
                                CornerRadius="4"
                                Padding="4,2"
                                HorizontalAlignment="Left"
                                Margin="0,2,0,0">
                          <TextBlock Text="{Binding OverflowCountText}"
                                     FontSize="9"
                                     FontWeight="Bold"
                                     Foreground="{DynamicResource AppAccentBrush}"/>
                        </Border>
                      </StackPanel>
                    </Grid>
                  </Border>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <!-- ════════ Single Column Schedule / Portrait Agenda View (Google Calendar Style) ════════ -->
        <StackPanel IsVisible="{Binding IsSingleColumnCalendar}" Spacing="10" Margin="0,4,0,0">
          <ItemsControl ItemsSource="{Binding CalendarDays}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:CalendarDayViewModel">
                <Border IsVisible="{Binding IsCurrentMonth}"
                        Background="{DynamicResource AppSurfaceBrush}"
                        BorderBrush="{DynamicResource AppBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="16,14"
                        Margin="0,0,0,10">
                  <Grid ColumnDefinitions="90,*">
                    <!-- Left Date Pillar -->
                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Top" Margin="0,2,16,0">
                      <TextBlock Text="{Binding DayOfWeekShortText}"
                                 FontSize="11"
                                 FontWeight="Bold"
                                 Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                      <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Text="{Binding DayNumberText}"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                        <Border IsVisible="{Binding IsToday}"
                                Background="{DynamicResource AppPrimaryBrush}"
                                CornerRadius="8"
                                Padding="6,2"
                                VerticalAlignment="Center">
                          <TextBlock Text="TODAY" FontSize="9" FontWeight="Bold" Foreground="#FFFFFF"/>
                        </Border>
                      </StackPanel>
                    </StackPanel>

                    <!-- Right Day Tasks Agenda Stream -->
                    <StackPanel Grid.Column="1" Spacing="8">
                      <!-- Agenda Tasks -->
                      <ItemsControl ItemsSource="{Binding DayTasks}" IsVisible="{Binding HasTasks}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:TodoItemViewModel">
                            <Border Classes="task-row" Classes.completed="{Binding IsCompleted}" Margin="0,0,0,6">
                              <Grid ColumnDefinitions="Auto,*,Auto">
                                <CheckBox Grid.Column="0"
                                          Classes="task-checkbox"
                                          IsChecked="{Binding IsCompleted, Mode=OneWay}"
                                          Command="{Binding $parent[UserControl].DataContext.ToggleTodoCommand}"
                                          CommandParameter="{Binding}"/>

                                <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                  <TextBlock Text="{Binding Title}"
                                             Classes="body-bold task-title"
                                             FontSize="13"
                                             TextWrapping="Wrap"/>
                                  <WrapPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <Border IsVisible="{Binding HasRecurrence}"
                                            Background="{DynamicResource AppPrimarySubtleBrush}"
                                            CornerRadius="4" Padding="5,1" Margin="0,0,6,4">
                                      <StackPanel Orientation="Horizontal" Spacing="3">
                                        <PathIcon Data="{StaticResource RepeatIconData}" Width="9" Height="9" Foreground="{DynamicResource AppPrimaryBrush}"/>
                                        <TextBlock Text="{Binding RecurrenceFormatted}" FontSize="10" Foreground="{DynamicResource AppPrimaryBrush}"/>
                                      </StackPanel>
                                    </Border>
                                    <Border IsVisible="{Binding HasDueDate}"
                                            Background="{DynamicResource AppPrimarySubtleBrush}"
                                            CornerRadius="4" Padding="5,1" Margin="0,0,6,4">
                                      <StackPanel Orientation="Horizontal" Spacing="3">
                                        <PathIcon Data="{StaticResource CalendarIconData}" Width="9" Height="9" Foreground="{DynamicResource AppPrimaryBrush}"/>
                                        <TextBlock Text="{Binding ContextDueDateFormatted}" FontSize="10" Foreground="{DynamicResource AppPrimaryBrush}"/>
                                      </StackPanel>
                                    </Border>
                                  </WrapPanel>
                                </StackPanel>
                              </Grid>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>

                      <!-- Empty Day State -->
                      <TextBlock Text="No tasks scheduled"
                                 IsVisible="{Binding !HasTasks}"
                                 FontSize="12"
                                 FontStyle="Italic"
                                 Foreground="{DynamicResource AppTextSecondaryBrush}"
                                 Margin="0,6,0,4"/>
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>

    <!-- ══════════════ RIGHT DETAIL SIDEBAR OVERLAY PANEL ══════════════ -->
    <Border Width="340"
            HorizontalAlignment="Right"
            VerticalAlignment="Stretch"
            IsVisible="{Binding IsSidebarOpen}"
            Background="{DynamicResource AppSurfaceBrush}"
            BorderBrush="{DynamicResource AppBorderBrush}"
            BorderThickness="1,0,0,0"
            BoxShadow="-8 0 24 0 #40000000"
            ZIndex="10">
      <Grid RowDefinitions="Auto,*">
        <!-- Sidebar Header -->
        <Border Grid.Row="0" Padding="20,20,16,16">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0" Spacing="2">
              <TextBlock Text="DAY DETAILS" Classes="micro" Foreground="{DynamicResource AppPrimaryBrush}"/>
              <TextBlock Text="{Binding SelectedDateTitle}" FontSize="16" FontWeight="Bold"/>
            </StackPanel>

            <!-- Close Sidebar Button -->
            <Button Grid.Column="1"
                    Classes="icon-btn"
                    Command="{Binding CloseSidebarCommand}"
                    ToolTip.Tip="Close panel"
                    VerticalAlignment="Center">
              <PathIcon Data="{StaticResource CloseIconData}" Width="12" Height="12"/>
            </Button>
          </Grid>
        </Border>

        <!-- Sidebar Content List -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="16,0,16,24" Spacing="12">
            <Separator Classes="divider" Margin="0,0,0,8"/>

            <!-- Empty State -->
            <StackPanel IsVisible="{Binding !HasSelectedDateTasks}" Spacing="8" Margin="0,32,0,0" HorizontalAlignment="Center">
              <PathIcon Data="{StaticResource CalendarIconData}" Width="32" Height="32" Foreground="{DynamicResource AppTextSecondaryBrush}" HorizontalAlignment="Center"/>
              <TextBlock Text="No tasks scheduled" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource AppTextSecondaryBrush}" HorizontalAlignment="Center"/>
              <TextBlock Text="Click another date or create a new task." FontSize="12" Foreground="{DynamicResource AppTextSecondaryBrush}" HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Selected Date Tasks List -->
            <ItemsControl ItemsSource="{Binding SelectedDateTasks}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:TodoItemViewModel">
                  <Border Classes="task-row" Classes.completed="{Binding IsCompleted}" Margin="0,3">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                      <!-- Checkbox -->
                      <CheckBox Grid.Column="0"
                                Classes="task-checkbox"
                                IsChecked="{Binding IsCompleted, Mode=OneWay}"
                                Command="{Binding $parent[UserControl].DataContext.ToggleTodoCommand}"
                                CommandParameter="{Binding}"/>

                      <!-- Task Info -->
                      <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}"
                                   Classes="body-bold task-title"
                                   FontSize="13"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Description}"
                                   Classes="small"
                                   IsVisible="{Binding Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                   TextWrapping="Wrap"/>

                        <!-- Badges -->
                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2,0,0">
                          <!-- Overdue Date Badge -->
                          <Border IsVisible="{Binding IsOverdue}"
                                  Background="{DynamicResource AppAccentDangerSubtleBrush}"
                                  CornerRadius="4"
                                  Padding="4,1">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                              <PathIcon Data="{StaticResource CalendarIconData}" Width="9" Height="9" Foreground="{DynamicResource AppAccentDangerBrush}"/>
                              <TextBlock Text="{Binding ContextDueDateFormatted}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AppAccentDangerBrush}"/>
                            </StackPanel>
                          </Border>

                          <!-- Normal Due Date Badge -->
                          <Border IsVisible="{Binding HasDueDateOnly}"
                                  Background="{DynamicResource AppPrimarySubtleBrush}"
                                  CornerRadius="4"
                                  Padding="4,1">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                              <PathIcon Data="{StaticResource CalendarIconData}" Width="9" Height="9" Foreground="{DynamicResource AppPrimaryBrush}"/>
                              <TextBlock Text="{Binding ContextDueDateFormatted}" FontSize="10" Foreground="{DynamicResource AppPrimaryBrush}"/>
                            </StackPanel>
                          </Border>

                          <Border IsVisible="{Binding HasRecurrence}"
                                  Background="{DynamicResource AppAccentTintBrush}"
                                  CornerRadius="4"
                                  Padding="4,1">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                              <PathIcon Data="{StaticResource RepeatIconData}" Width="9" Height="9" Foreground="{DynamicResource AppAccentBrush}"/>
                              <TextBlock Text="{Binding RecurrenceFormatted}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AppAccentBrush}"/>
                            </StackPanel>
                          </Border>
                        </StackPanel>
                      </StackPanel>

                      <!-- Delete -->
                      <Button Grid.Column="2"
                              Classes="danger"
                              Command="{Binding $parent[UserControl].DataContext.DeleteTodoCommand}"
                              CommandParameter="{Binding}"
                              VerticalAlignment="Center">
                        <PathIcon Data="{StaticResource CloseIconData}" Width="10" Height="10"/>
                      </Button>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Border>
  </Panel>
</UserControl>
