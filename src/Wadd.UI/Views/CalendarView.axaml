<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Wadd.UI.ViewModels;assembly=Wadd.UI"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="800"
             x:Class="Wadd.UI.Views.CalendarView"
             x:DataType="vm:MainViewModel">

  <UserControl.Styles>
    <!-- Filter Toggle Button Pill Style aligned with Dark Emerald Theme -->
    <Style Selector="ToggleButton.filter-pill">
      <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="12,5"/>
      <Setter Property="CornerRadius" Value="14"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.15"/>
          <BrushTransition Property="Foreground" Duration="0:0:0.15"/>
          <BrushTransition Property="BorderBrush" Duration="0:0:0.15"/>
        </Transitions>
      </Setter>
    </Style>

    <!-- Pointerover Unchecked -->
    <Style Selector="ToggleButton.filter-pill:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AppSurfaceElevatedBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
    </Style>

    <!-- Checked State (Active Filter Highlight - Wadd Emerald) -->
    <Style Selector="ToggleButton.filter-pill:checked /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AppPrimaryBrush}"/>
      <Setter Property="Foreground" Value="#FFFFFF"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AppPrimaryBrush}"/>
    </Style>

    <!-- Checked State Hover -->
    <Style Selector="ToggleButton.filter-pill:checked:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#059669"/>
      <Setter Property="Foreground" Value="#FFFFFF"/>
      <Setter Property="BorderBrush" Value="#059669"/>
    </Style>
  </UserControl.Styles>

  <Panel>
    <!-- ══════════════ LEFT / CENTER CALENDAR SECTION ══════════════ -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="32,28,32,40" Spacing="0">

        <!-- Page Header -->
        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,24">
          <StackPanel Grid.Column="0" Spacing="6">
            <TextBlock Text="CALENDAR &amp; TIMELINE" Classes="micro" Foreground="{DynamicResource AppPrimaryBrush}"/>
            
            <!-- Editable Month & Year Selectors -->
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
              <ComboBox ItemsSource="{Binding MonthOptions}"
                        SelectedIndex="{Binding SelectedMonthIndex}"
                        FontSize="20"
                        FontWeight="Bold"
                        Padding="10,4"
                        MinWidth="150"
                        CornerRadius="8"
                        Background="{DynamicResource AppSurfaceBrush}"
                        BorderBrush="{DynamicResource AppBorderBrush}"
                        ToolTip.Tip="Select month"/>

              <ComboBox ItemsSource="{Binding YearOptions}"
                        SelectedItem="{Binding SelectedYear}"
                        FontSize="20"
                        FontWeight="Bold"
                        Padding="10,4"
                        MinWidth="100"
                        CornerRadius="8"
                        Background="{DynamicResource AppSurfaceBrush}"
                        BorderBrush="{DynamicResource AppBorderBrush}"
                        ToolTip.Tip="Select year"/>
            </StackPanel>

            <TextBlock Text="Upcoming task schedule, deadline overview, and recurring habit occurrences."
                       Classes="small"
                       Foreground="{DynamicResource AppTextSecondaryBrush}"/>
          </StackPanel>

          <!-- Navigation Controls -->
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
            <Button Classes="outline" Command="{Binding JumpToTodayCommand}" Padding="12,6">
              <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <PathIcon Data="{StaticResource CalendarIconData}" Width="12" Height="12" Foreground="{DynamicResource AppPrimaryBrush}"/>
                <TextBlock Text="Today" FontSize="12" FontWeight="SemiBold"/>
              </StackPanel>
            </Button>
            <Button Classes="icon-btn" Command="{Binding PreviousMonthCommand}" ToolTip.Tip="Previous month">
              <TextBlock Text="◄" FontSize="12"/>
            </Button>
            <Button Classes="icon-btn" Command="{Binding NextMonthCommand}" ToolTip.Tip="Next month">
              <TextBlock Text="►" FontSize="12"/>
            </Button>
          </StackPanel>
        </Grid>

        <Separator Classes="divider" Margin="0,0,0,16"/>

        <!-- Recurrence & Task Filter Toggle Pills Bar -->
        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,18" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,0,4,0">
            <PathIcon Data="{StaticResource TracingIconData}" Width="13" Height="13" Foreground="{DynamicResource AppPrimaryBrush}"/>
            <TextBlock Text="Filter Tasks:" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimaryBrush}"/>
          </StackPanel>

          <ToggleButton IsChecked="{Binding IsStandardFilterEnabled}" Classes="filter-pill" ToolTip.Tip="Toggle Standard Tasks">
            <TextBlock Text="Standard"/>
          </ToggleButton>
          <ToggleButton IsChecked="{Binding IsDailyFilterEnabled}" Classes="filter-pill" ToolTip.Tip="Toggle Daily Tasks">
            <TextBlock Text="Daily"/>
          </ToggleButton>
          <ToggleButton IsChecked="{Binding IsWeekdaysFilterEnabled}" Classes="filter-pill" ToolTip.Tip="Toggle Weekdays Tasks">
            <TextBlock Text="Weekdays"/>
          </ToggleButton>
          <ToggleButton IsChecked="{Binding IsWeeklyFilterEnabled}" Classes="filter-pill" ToolTip.Tip="Toggle Weekly Tasks">
            <TextBlock Text="Weekly"/>
          </ToggleButton>
          <ToggleButton IsChecked="{Binding IsMonthlyFilterEnabled}" Classes="filter-pill" ToolTip.Tip="Toggle Monthly Tasks">
            <TextBlock Text="Monthly"/>
          </ToggleButton>
          <ToggleButton IsChecked="{Binding IsYearlyFilterEnabled}" Classes="filter-pill" ToolTip.Tip="Toggle Yearly Tasks">
            <TextBlock Text="Yearly"/>
          </ToggleButton>
        </StackPanel>

        <!-- Weekday Headers Row (Sun-Sat) -->
        <UniformGrid Columns="7" Margin="0,0,0,8">
          <TextBlock Text="SUN" HorizontalAlignment="Center" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
          <TextBlock Text="MON" HorizontalAlignment="Center" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
          <TextBlock Text="TUE" HorizontalAlignment="Center" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
          <TextBlock Text="WED" HorizontalAlignment="Center" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
          <TextBlock Text="THU" HorizontalAlignment="Center" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
          <TextBlock Text="FRI" HorizontalAlignment="Center" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
          <TextBlock Text="SAT" HorizontalAlignment="Center" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
        </UniformGrid>

        <!-- 42-Cell Month Grid -->
        <ItemsControl ItemsSource="{Binding CalendarDays}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Columns="7"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:CalendarDayViewModel">
              <Button Classes="calendar-day-btn"
                      Command="{Binding $parent[UserControl].DataContext.SelectDayCommand}"
                      CommandParameter="{Binding}">
                <Button.Styles>
                  <Style Selector="Button.calendar-day-btn">
                    <Setter Property="CornerRadius" Value="10"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="3"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="HorizontalAlignment" Value="Stretch"/>
                    <Setter Property="VerticalAlignment" Value="Stretch"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                    <Setter Property="Cursor" Value="Hand"/>
                  </Style>
                  <Style Selector="Button.calendar-day-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="CornerRadius" Value="10"/>
                  </Style>
                  <Style Selector="Button.calendar-day-btn:pointerover /template/ ContentPresenter">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="CornerRadius" Value="10"/>
                  </Style>
                </Button.Styles>

                <Border Height="112"
                        Padding="9"
                        CornerRadius="10"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Classes.inactive="{Binding !IsCurrentMonth}"
                        Classes.selected="{Binding IsSelected}">
                  <Border.Styles>
                    <!-- Active Month Base Card -->
                    <Style Selector="Border">
                      <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}"/>
                      <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
                      <Setter Property="BorderThickness" Value="1"/>
                      <Setter Property="Transitions">
                        <Transitions>
                          <BrushTransition Property="Background" Duration="0:0:0.15"/>
                          <BrushTransition Property="BorderBrush" Duration="0:0:0.15"/>
                        </Transitions>
                      </Setter>
                    </Style>

                    <!-- Active Card Hover Effect (Exact CornerRadius 10) -->
                    <Style Selector="Border:pointerover">
                      <Setter Property="Background" Value="{DynamicResource AppSurfaceSubtleBrush}"/>
                      <Setter Property="BorderBrush" Value="{DynamicResource AppPrimaryBrush}"/>
                    </Style>

                    <!-- Inactive Month Card -->
                    <Style Selector="Border.inactive">
                      <Setter Property="Background" Value="{DynamicResource AppSurfaceSubtleBrush}"/>
                      <Setter Property="Opacity" Value="0.45"/>
                    </Style>
                    <Style Selector="Border.inactive:pointerover">
                      <Setter Property="Opacity" Value="0.75"/>
                      <Setter Property="BorderBrush" Value="{DynamicResource AppPrimaryBrush}"/>
                    </Style>

                    <!-- Selected Card Highlight -->
                    <Style Selector="Border.selected">
                      <Setter Property="BorderBrush" Value="{DynamicResource AppPrimaryBrush}"/>
                      <Setter Property="BorderThickness" Value="2"/>
                      <Setter Property="Background" Value="{DynamicResource AppSurfaceSubtleBrush}"/>
                    </Style>
                  </Border.Styles>

                  <Grid RowDefinitions="Auto,*" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <!-- Day Header (Number + Today Badge) -->
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" HorizontalAlignment="Stretch" Margin="0,0,0,4">
                      <TextBlock Grid.Column="0"
                                 Text="{Binding DayNumberText}"
                                 FontSize="13"
                                 FontWeight="Bold"
                                 HorizontalAlignment="Left"
                                 Foreground="{DynamicResource AppTextPrimaryBrush}"/>

                      <!-- Today Highlight Pill -->
                      <Border Grid.Column="1"
                              IsVisible="{Binding IsToday}"
                              Background="{DynamicResource AppPrimaryBrush}"
                              CornerRadius="10"
                              Padding="6,1">
                        <TextBlock Text="TODAY" FontSize="9" FontWeight="Bold" Foreground="#FFFFFF"/>
                      </Border>
                    </Grid>

                    <!-- Task Status Badges & Overflow -->
                    <StackPanel Grid.Row="1" Spacing="2" VerticalAlignment="Top" HorizontalAlignment="Stretch">
                      <!-- Visible Task Mini Pills (Max 2) -->
                      <ItemsControl ItemsSource="{Binding VisibleTasks}" HorizontalAlignment="Stretch">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:TodoItemViewModel">
                            <Border CornerRadius="4"
                                    Padding="4,2"
                                    Margin="0,1"
                                    HorizontalAlignment="Stretch"
                                    Background="{DynamicResource AppSurfaceSubtleBrush}"
                                    ToolTip.Tip="{Binding Title}"
                                    Classes.completed="{Binding IsCompleted}">
                              <Border.Styles>
                                <Style Selector="Border.completed">
                                  <Setter Property="Opacity" Value="0.45"/>
                                </Style>
                              </Border.Styles>
                              <Grid ColumnDefinitions="Auto,*,Auto" HorizontalAlignment="Stretch">
                                <!-- Status Indicator Dot -->
                                <Ellipse Grid.Column="0"
                                         Width="6" Height="6"
                                         VerticalAlignment="Center"
                                         Margin="0,0,4,0"
                                         Fill="{Binding IsCompleted, Converter={x:Static ObjectConverters.IsNotNull}, ConverterParameter=#10B981, FallbackValue=#3B82F6}"/>

                                <!-- Task Title with Single-Line Ellipsis Trimming -->
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Title}"
                                           FontSize="10"
                                           TextWrapping="NoWrap"
                                           MaxLines="1"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource AppTextPrimaryBrush}"/>

                                <!-- Recurring Indicator Icon -->
                                <PathIcon Grid.Column="2"
                                          IsVisible="{Binding HasRecurrence}"
                                          Data="{StaticResource RepeatIconData}"
                                          Width="8" Height="8"
                                          Margin="3,0,0,0"
                                          Foreground="{DynamicResource AppPrimaryBrush}"
                                          VerticalAlignment="Center"/>
                              </Grid>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>

                      <!-- Overflow Badge (+X more) -->
                      <Border IsVisible="{Binding HasOverflow}"
                              Background="{DynamicResource AppAccentTintBrush}"
                              CornerRadius="4"
                              Padding="4,2"
                              HorizontalAlignment="Left"
                              Margin="0,2,0,0">
                        <TextBlock Text="{Binding OverflowCountText}"
                                   FontSize="9"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource AppAccentBrush}"/>
                      </Border>
                    </StackPanel>
                  </Grid>
                </Border>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>

    <!-- ══════════════ RIGHT DETAIL SIDEBAR OVERLAY PANEL ══════════════ -->
    <Border Width="340"
            HorizontalAlignment="Right"
            VerticalAlignment="Stretch"
            IsVisible="{Binding IsSidebarOpen}"
            Background="{DynamicResource AppSurfaceBrush}"
            BorderBrush="{DynamicResource AppBorderBrush}"
            BorderThickness="1,0,0,0"
            BoxShadow="-8 0 24 0 #40000000"
            ZIndex="10">
      <Grid RowDefinitions="Auto,*">
        <!-- Sidebar Header -->
        <Border Grid.Row="0" Padding="20,20,16,16">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0" Spacing="2">
              <TextBlock Text="DAY DETAILS" Classes="micro" Foreground="{DynamicResource AppPrimaryBrush}"/>
              <TextBlock Text="{Binding SelectedDateTitle}" FontSize="16" FontWeight="Bold"/>
            </StackPanel>

            <!-- Close Sidebar Button -->
            <Button Grid.Column="1"
                    Classes="icon-btn"
                    Command="{Binding CloseSidebarCommand}"
                    ToolTip.Tip="Close panel"
                    VerticalAlignment="Center">
              <PathIcon Data="{StaticResource CloseIconData}" Width="12" Height="12"/>
            </Button>
          </Grid>
        </Border>

        <!-- Sidebar Content List -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="16,0,16,24" Spacing="12">
            <Separator Classes="divider" Margin="0,0,0,8"/>

            <!-- Empty State -->
            <StackPanel IsVisible="{Binding !HasSelectedDateTasks}" Spacing="8" Margin="0,32,0,0" HorizontalAlignment="Center">
              <PathIcon Data="{StaticResource CalendarIconData}" Width="32" Height="32" Foreground="{DynamicResource AppTextSecondaryBrush}" HorizontalAlignment="Center"/>
              <TextBlock Text="No tasks scheduled" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource AppTextSecondaryBrush}" HorizontalAlignment="Center"/>
              <TextBlock Text="Click another date or create a new task." FontSize="12" Foreground="{DynamicResource AppTextSecondaryBrush}" HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Selected Date Tasks List -->
            <ItemsControl ItemsSource="{Binding SelectedDateTasks}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:TodoItemViewModel">
                  <Border Classes="task-row" Classes.completed="{Binding IsCompleted}" Margin="0,3">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                      <!-- Checkbox -->
                      <CheckBox Grid.Column="0"
                                Classes="task-checkbox"
                                IsChecked="{Binding IsCompleted, Mode=OneWay}"
                                Command="{Binding $parent[UserControl].DataContext.ToggleTodoCommand}"
                                CommandParameter="{Binding}"/>

                      <!-- Task Info -->
                      <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}"
                                   Classes="body-bold task-title"
                                   FontSize="13"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Description}"
                                   Classes="small"
                                   IsVisible="{Binding Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                   TextWrapping="Wrap"/>

                        <!-- Badges -->
                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2,0,0">
                          <Border IsVisible="{Binding HasDueDate}"
                                  Background="{DynamicResource AppPrimarySubtleBrush}"
                                  CornerRadius="4"
                                  Padding="4,1">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                              <PathIcon Data="{StaticResource CalendarIconData}" Width="9" Height="9" Foreground="{DynamicResource AppPrimaryBrush}"/>
                              <TextBlock Text="{Binding DueDateFormatted}" FontSize="10" Foreground="{DynamicResource AppPrimaryBrush}"/>
                            </StackPanel>
                          </Border>

                          <Border IsVisible="{Binding HasRecurrence}"
                                  Background="{DynamicResource AppAccentTintBrush}"
                                  CornerRadius="4"
                                  Padding="4,1">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                              <PathIcon Data="{StaticResource RepeatIconData}" Width="9" Height="9" Foreground="{DynamicResource AppAccentBrush}"/>
                              <TextBlock Text="{Binding RecurrenceFormatted}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AppAccentBrush}"/>
                            </StackPanel>
                          </Border>
                        </StackPanel>
                      </StackPanel>

                      <!-- Delete -->
                      <Button Grid.Column="2"
                              Classes="danger"
                              Command="{Binding $parent[UserControl].DataContext.DeleteTodoCommand}"
                              CommandParameter="{Binding}"
                              VerticalAlignment="Center">
                        <PathIcon Data="{StaticResource CloseIconData}" Width="10" Height="10"/>
                      </Button>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Border>
  </Panel>
</UserControl>
