<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Wadd.UI.ViewModels;assembly=Wadd.UI"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="Wadd.UI.Views.TagsManagementView"
             x:DataType="vm:MainViewModel">

  <UserControl.Styles>
    <Style Selector="StackPanel.view-container">
      <Setter Property="Margin" Value="64,48,80,180"/>
    </Style>
    <Style Selector="StackPanel.view-container.compact">
      <Setter Property="Margin" Value="16,20,16,40"/>
    </Style>
  </UserControl.Styles>

  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Classes="view-container" Classes.compact="{Binding IsCompact}" Spacing="24" HorizontalAlignment="Stretch">

      <!-- Header Title Section -->
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Grid.Column="0" Spacing="4">
          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <PathIcon Data="{StaticResource TagIconData}" Width="20" Height="20" Foreground="{DynamicResource AppPrimaryBrush}"/>
            <TextBlock Text="Tags Management" Classes="display"/>
          </StackPanel>
          <TextBlock Text="Organize, rename, or delete category tags globally across all your tasks."
                     Classes="small"
                     Foreground="{DynamicResource AppTextSecondaryBrush}"/>
        </StackPanel>

        <!-- Count Badge -->
        <Border Grid.Column="1"
                Background="{DynamicResource AppSurfaceElevatedBrush}"
                CornerRadius="12"
                Padding="12,6"
                VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <TextBlock Text="{Binding AllTags.Count}"
                       FontSize="14"
                       FontWeight="Bold"
                       Foreground="{DynamicResource AppPrimaryBrush}"/>
            <TextBlock Text="tags"
                       FontSize="12"
                       Foreground="{DynamicResource AppTextSecondaryBrush}"/>
          </StackPanel>
        </Border>
      </Grid>

      <!-- New Tag Creator Card -->
      <Border Classes="content-block">
        <StackPanel Spacing="12">
          <TextBlock Text="CREATE NEW TAG" Classes="micro"/>

          <Grid ColumnDefinitions="*,Auto">
            <TextBox Grid.Column="0"
                     Classes="styled"
                     PlaceholderText="Enter new tag name..."
                     Text="{Binding NewGlobalTagInput, Mode=TwoWay}"
                     Margin="0,0,10,0"
                     Padding="14,10"
                     MinHeight="40"
                     VerticalAlignment="Center">
              <TextBox.KeyBindings>
                <KeyBinding Gesture="Enter" Command="{Binding CreateNewGlobalTagCommand}"/>
              </TextBox.KeyBindings>
            </TextBox>

            <Button Grid.Column="1"
                    Classes="primary"
                    Command="{Binding CreateNewGlobalTagCommand}"
                    Padding="16,10"
                    VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <PathIcon Data="{StaticResource PlusIconData}" Width="12" Height="12"/>
                <TextBlock Text="Add Tag" FontSize="13" FontWeight="SemiBold"/>
              </StackPanel>
            </Button>
          </Grid>
        </StackPanel>
      </Border>

      <!-- Existing Tags Section -->
      <Border Classes="content-block">
        <StackPanel Spacing="16">
          <TextBlock Text="ALL CATEGORY TAGS (LATEST FIRST)" Classes="micro"/>

          <!-- Empty State -->
          <StackPanel IsVisible="{Binding !AllTags.Count}"
                      HorizontalAlignment="Center"
                      Margin="0,32,0,32"
                      Spacing="12">
            <PathIcon Data="{StaticResource TagIconData}"
                      Width="36" Height="36"
                      Foreground="{DynamicResource AppBorderBrush}"
                      HorizontalAlignment="Center"/>
            <TextBlock Text="No tags created yet"
                       Classes="heading"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource AppTextSecondaryBrush}"/>
            <TextBlock Text="Add tags above or assign tags to tasks to manage them here."
                       Classes="small"
                       HorizontalAlignment="Center"/>
          </StackPanel>

          <!-- Tags List -->
          <ItemsControl ItemsSource="{Binding AllTags}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:TagItemViewModel">
                <Border Classes="card-subtle"
                        Padding="14,12"
                        Margin="0,0,0,8">
                  <Grid ColumnDefinitions="*,Auto">

                    <!-- Normal Display Mode -->
                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                Spacing="12"
                                IsVisible="{Binding !IsEditing}"
                                VerticalAlignment="Center">
                      <!-- Filled Tag Badge -->
                      <Border Background="{DynamicResource AppPrimaryBrush}"
                              CornerRadius="8"
                              Padding="10,5"
                              VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                          <PathIcon Data="{StaticResource TagIconData}" Width="11" Height="11" Foreground="#F8FAFC"/>
                          <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="Bold" Foreground="#F8FAFC"/>
                        </StackPanel>
                      </Border>

                      <!-- Task Count Chip -->
                      <Border Background="{DynamicResource AppSurfaceSubtleBrush}"
                              CornerRadius="6"
                              Padding="8,4"
                              VerticalAlignment="Center">
                        <TextBlock Text="{Binding TaskCount, StringFormat='{}{0} task(s)'}"
                                   FontSize="11"
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                      </Border>
                    </StackPanel>

                    <!-- Inline Edit Mode -->
                    <Grid Grid.Column="0" ColumnDefinitions="*,Auto" IsVisible="{Binding IsEditing}" VerticalAlignment="Center" Margin="0,0,12,0">
                      <TextBox Grid.Column="0"
                               Classes="styled"
                               Text="{Binding EditingName, Mode=TwoWay}"
                               FontSize="13"
                               VerticalAlignment="Center">
                        <TextBox.KeyBindings>
                          <KeyBinding Gesture="Enter" Command="{Binding SaveEditCommand}"/>
                          <KeyBinding Gesture="Escape" Command="{Binding CancelEditCommand}"/>
                        </TextBox.KeyBindings>
                      </TextBox>

                      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="8,0,0,0">
                        <Button Classes="primary" Command="{Binding SaveEditCommand}" Padding="12,6" Content="Save"/>
                        <Button Classes="outline" Command="{Binding CancelEditCommand}" Padding="12,6" Content="Cancel"/>
                      </StackPanel>
                    </Grid>

                    <!-- Actions (Edit / Delete) -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" IsVisible="{Binding !IsEditing}" VerticalAlignment="Center">
                      <Button Classes="icon-btn"
                              Command="{Binding StartEditCommand}"
                              ToolTip.Tip="Rename Tag">
                        <PathIcon Data="{StaticResource EditIconData}" Width="14" Height="14" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                      </Button>
                      <Button Classes="danger"
                              Command="{Binding DeleteCommand}"
                              ToolTip.Tip="Delete Tag globally">
                        <PathIcon Data="{StaticResource TrashIconData}" Width="14" Height="14"/>
                      </Button>
                    </StackPanel>

                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>
