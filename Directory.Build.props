<Project>
  <PropertyGroup>
    <Version>0.9.0-beta.1</Version>
    <AssemblyVersion>0.9.0.0</AssemblyVersion>
    <FileVersion>0.9.0.0</FileVersion>

    <GoogleClientId Condition="'$(GoogleClientId)' == ''">$(GOOGLE_CLIENT_ID)</GoogleClientId>
  </PropertyGroup>

  <ItemGroup Condition="'$(GoogleClientId)' != ''">
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>GoogleClientId</_Parameter1>
      <_Parameter2>$(GoogleClientId)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
