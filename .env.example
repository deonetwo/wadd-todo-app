# ═══════════════════════════════════════════════════════════════
# Wadd Application - Environment Variables Template
# Copy this file to .env and fill in your own credentials
# ═══════════════════════════════════════════════════════════════

# [1] Cloudflare Worker OAuth Proxy (Authentication & Cloud Sync)
OAUTH_PROXY_URL="https://your-worker.your-subdomain.workers.dev"

# Secret header (x-app-secret) to protect your Worker from unauthorized traffic
OAUTH_PROXY_SECRET="your-custom-shared-secret-key"

# [2] Google OAuth & Firebase Identity
# Google OAuth 2.0 Web Client ID (from Google Cloud Console > APIs & Services > Credentials)
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"

# Optional: Firebase Web API Key & Project ID (from Firebase Console > Project Settings)
FIREBASE_API_KEY="AIzaSyYourFirebaseApiKey"
FIREBASE_PROJECT_ID="your-firebase-project-id"
