# ═══════════════════════════════════════════════════════════════
# Wadd Application Environment Variables Template
# Copy this file to .env and fill in your credentials
# ═══════════════════════════════════════════════════════════════

# Google OAuth 2.0 Web Client ID (from Firebase Console > Authentication > Google > Web SDK configuration)
GOOGLE_CLIENT_ID="1088368813962-YOUR_WEB_CLIENT_ID.apps.googleusercontent.com"

# Firebase Web API Key (from Firebase Console > Project Settings > General)
FIREBASE_API_KEY="AIzaSyYOUR_FIREBASE_WEB_API_KEY"

# Firebase Project ID (from Firebase Console > Project Settings > General)
FIREBASE_PROJECT_ID="wadd-app-1140"

# Optional: Legacy Web App Sync Endpoint URL
WADD_SYNC_URL=""
